<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Copyright © Rockwell Automation, Inc.  All Rights Reserved.]]>
</Line>
<Line Number="1">
<![CDATA[// Revision 2.0-00, 2014-09-23: Initial release for Steam Table objects library.]]>
</Line>
<Line Number="2">
<![CDATA[If Cfg_SI_Eng Then]]>
</Line>
<Line Number="3">
<![CDATA[	SU:=Inp_s*4.186801993839408;]]>
</Line>
<Line Number="4">
<![CDATA[	PU:=Inp_P*0.006894757269;]]>
</Line>
<Line Number="5">
<![CDATA[Else]]>
</Line>
<Line Number="6">
<![CDATA[	SU:=Inp_s;]]>
</Line>
<Line Number="7">
<![CDATA[	PU:=Inp_P;]]>
</Line>
<Line Number="8">
<![CDATA[End_If;]]>
</Line>
<Line Number="9">
<![CDATA[// limits check ------------------------------------------------------------------]]>
</Line>
<Line Number="10">
<![CDATA[Out_Region:=0;]]>
</Line>
<Line Number="11">
<![CDATA[If 0.000611213 <= PU AND PU <= 100 Then]]>
</Line>
<Line Number="12">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="13">
<![CDATA[Else]]>
</Line>
<Line Number="14">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="15">
<![CDATA[	If PU<0.000611213 Then PU:=0.000611213; Else PU:=100.0; End_If;]]>
</Line>
<Line Number="16">
<![CDATA[End_If;]]>
</Line>
<Line Number="17">
<![CDATA[If -0.00015454959194118292 <= SU AND SU <= 11.921055068613535 Then]]>
</Line>
<Line Number="18">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="19">
<![CDATA[Else]]>
</Line>
<Line Number="20">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="21">
<![CDATA[	If SU<-0.00015454959194118292 Then SU:=-0.00015454959194118292; Else SU:=11.921055068613535; End_If;]]>
</Line>
<Line Number="22">
<![CDATA[End_If;]]>
</Line>
<Line Number="23">
<![CDATA[// -------------------------------------------------------------------------------]]>
</Line>
<Line Number="24">
<![CDATA[// boundary check ----------------------------------------------------------------]]>
</Line>
<Line Number="25">
<![CDATA[R:=0.461526;]]>
</Line>
<Line Number="26">
<![CDATA[// ------------------Calculate smin Region 1 (273.15, PU)-------------------------]]>
</Line>
<Line Number="27">
<![CDATA[TPi:=PU/16.53;]]>
</Line>
<Line Number="28">
<![CDATA[Temp1:=7.1-TPi;]]>
</Line>
<Line Number="29">
<![CDATA[TTau:=1386.0/273.15;]]>
</Line>
<Line Number="30">
<![CDATA[Temp2:=TTau-1.222;]]>
</Line>
<Line Number="31">
<![CDATA[Gam:=0.0;]]>
</Line>
<Line Number="32">
<![CDATA[Gam1:=0.0;]]>
</Line>
<Line Number="33">
<![CDATA[Gam2:=0.0;]]>
</Line>
<Line Number="34">
<![CDATA[For i:=0 To 33 Do]]>
</Line>
<Line Number="35">
<![CDATA[	Temp3:=R1ni[i]*(Temp1**R1Ii[i])*(Temp2**R1Ji[i]);]]>
</Line>
<Line Number="36">
<![CDATA[	Gam:=Gam+Temp3*R1Ji[i];]]>
</Line>
<Line Number="37">
<![CDATA[	Gam1:=Gam1+Temp3;]]>
</Line>
<Line Number="38">
<![CDATA[End_For;]]>
</Line>
<Line Number="39">
<![CDATA[Gam:=Gam/Temp2;]]>
</Line>
<Line Number="40">
<![CDATA[SMIN:=R*(TTau*Gam - Gam1);]]>
</Line>
<Line Number="41">
<![CDATA[// -------------------------------------------------------------------------------]]>
</Line>
<Line Number="42">
<![CDATA[Out_Region:=0;]]>
</Line>
<Line Number="43">
<![CDATA[If PU <= 16.529164252604478 Then]]>
</Line>
<Line Number="44">
<![CDATA[	// --------------Calculate Tsat(PU)-------------------------------------------]]>
</Line>
<Line Number="45">
<![CDATA[	Beta:=PU**0.25;]]>
</Line>
<Line Number="46">
<![CDATA[	E:=Beta**2 - 17.073846940092*Beta + 14.91510861353;]]>
</Line>
<Line Number="47">
<![CDATA[	F:=1167.0521452767*Beta**2 + 12020.82470247*Beta - 4823.2657361591;]]>
</Line>
<Line Number="48">
<![CDATA[	G:=-724213.16703206*Beta**2 - 3232555.0322333*Beta + 405113.40542057;]]>
</Line>
<Line Number="49">
<![CDATA[	D:=-2.0*G/(F+(F**2-4.0*E*G)**0.5);]]>
</Line>
<Line Number="50">
<![CDATA[	T:=(650.17534844798+D-((650.17534844798+D)**2-4.0*(650.17534844798*D-0.23855557567849))**0.5)/2.0;]]>
</Line>
<Line Number="51">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="52">
<![CDATA[	// --------------Calculate Region 1/4 Boundary: Region 1 (Tsat(PU), PU)-------]]>
</Line>
<Line Number="53">
<![CDATA[	TPi:=PU/16.53;]]>
</Line>
<Line Number="54">
<![CDATA[	Temp1:=7.1-TPi;]]>
</Line>
<Line Number="55">
<![CDATA[	TTau:=1386.0/T;]]>
</Line>
<Line Number="56">
<![CDATA[	Temp2:=TTau-1.222;]]>
</Line>
<Line Number="57">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="58">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="59">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="60">
<![CDATA[	For i:=0 To 33 Do]]>
</Line>
<Line Number="61">
<![CDATA[		Temp3:=R1ni[i]*(Temp1**R1Ii[i])*(Temp2**R1Ji[i]);]]>
</Line>
<Line Number="62">
<![CDATA[		Gam:=Gam+Temp3*R1Ji[i];]]>
</Line>
<Line Number="63">
<![CDATA[		Gam1:=Gam1+Temp3;]]>
</Line>
<Line Number="64">
<![CDATA[	End_For;]]>
</Line>
<Line Number="65">
<![CDATA[	Gam:=Gam/Temp2;]]>
</Line>
<Line Number="66">
<![CDATA[	S1:=R*(TTau*Gam - Gam1);]]>
</Line>
<Line Number="67">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="68">
<![CDATA[	// --------------Calculate Region 2/4 Boundary: Region 2 (Tsat(PU), PU)-------]]>
</Line>
<Line Number="69">
<![CDATA[	TTau:=540.0/T;]]>
</Line>
<Line Number="70">
<![CDATA[	Temp2:=TTau-0.5;]]>
</Line>
<Line Number="71">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="72">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="73">
<![CDATA[	Gam2:=ln(PU);]]>
</Line>
<Line Number="74">
<![CDATA[	Gam3:=0.0;]]>
</Line>
<Line Number="75">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="76">
<![CDATA[		Temp3:=R2ni0[i]*(TTau**R2Ji0[i]);]]>
</Line>
<Line Number="77">
<![CDATA[		Gam:=Gam+Temp3 * R2Ji0[i];]]>
</Line>
<Line Number="78">
<![CDATA[		Gam2:=Gam2+Temp3;]]>
</Line>
<Line Number="79">
<![CDATA[	End_For;]]>
</Line>
<Line Number="80">
<![CDATA[	Temp1:=SQRT(PU);]]>
</Line>
<Line Number="81">
<![CDATA[	Temp3:=SQRT(Temp2);]]>
</Line>
<Line Number="82">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="83">
<![CDATA[		Temp4:=R22ni[i]*((Temp1**R2Ii[i])*(Temp3**R2Ji[i]))**2;]]>
</Line>
<Line Number="84">
<![CDATA[		Gam1:=Gam1+Temp4*R2Ji[i];]]>
</Line>
<Line Number="85">
<![CDATA[		Gam3:=Gam3+Temp4;]]>
</Line>
<Line Number="86">
<![CDATA[	End_For;]]>
</Line>
<Line Number="87">
<![CDATA[	Gam:=Gam/TTau;]]>
</Line>
<Line Number="88">
<![CDATA[	Gam1:=Gam1/Temp2;]]>
</Line>
<Line Number="89">
<![CDATA[	S2:=R*(TTau*(Gam+Gam1)-(Gam2+Gam3));]]>
</Line>
<Line Number="90">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="91">
<![CDATA[	// --------------Calculate Region 2/5 Boundary: Region 2 (1073.15, PU)--------]]>
</Line>
<Line Number="92">
<![CDATA[	TTau:=540.0/1073.15;]]>
</Line>
<Line Number="93">
<![CDATA[	Temp2:=TTau-0.5;]]>
</Line>
<Line Number="94">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="95">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="96">
<![CDATA[	Gam2:=ln(PU);]]>
</Line>
<Line Number="97">
<![CDATA[	Gam3:=0.0;]]>
</Line>
<Line Number="98">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="99">
<![CDATA[		Temp3:=R2ni0[i]*(TTau**R2Ji0[i]);]]>
</Line>
<Line Number="100">
<![CDATA[		Gam:=Gam+Temp3 * R2Ji0[i];]]>
</Line>
<Line Number="101">
<![CDATA[		Gam2:=Gam2+Temp3;]]>
</Line>
<Line Number="102">
<![CDATA[	End_For;]]>
</Line>
<Line Number="103">
<![CDATA[	Temp1:=SQRT(PU);]]>
</Line>
<Line Number="104">
<![CDATA[	Temp3:=SQRT(Temp2);]]>
</Line>
<Line Number="105">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="106">
<![CDATA[		Temp4:=R22ni[i]*((Temp1**R2Ii[i])*(Temp3**R2Ji[i]))**2;]]>
</Line>
<Line Number="107">
<![CDATA[		Gam1:=Gam1+Temp4*R2Ji[i];]]>
</Line>
<Line Number="108">
<![CDATA[		Gam3:=Gam3+Temp4;]]>
</Line>
<Line Number="109">
<![CDATA[	End_For;]]>
</Line>
<Line Number="110">
<![CDATA[	Gam:=Gam/TTau;]]>
</Line>
<Line Number="111">
<![CDATA[	Gam1:=Gam1/Temp2;]]>
</Line>
<Line Number="112">
<![CDATA[	S3:=R*(TTau*(Gam+Gam1)-(Gam2+Gam3));]]>
</Line>
<Line Number="113">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="114">
<![CDATA[	If SMIN <= SU AND SU <= S1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="115">
<![CDATA[	If S1 < SU AND SU < S2 Then Out_Region:=4; End_If;]]>
</Line>
<Line Number="116">
<![CDATA[	If S2 <= SU AND SU <= S3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="117">
<![CDATA[End_If;]]>
</Line>
<Line Number="118">
<![CDATA[If 16.529164252604478 < PU Then]]>
</Line>
<Line Number="119">
<![CDATA[	// --------------Calculate Region 1/3 Boundary: Region 1 (623.15, PU)---------]]>
</Line>
<Line Number="120">
<![CDATA[	TPi:=PU/16.53;]]>
</Line>
<Line Number="121">
<![CDATA[	Temp1:=7.1-TPi;]]>
</Line>
<Line Number="122">
<![CDATA[	TTau:=1386.0/623.15;]]>
</Line>
<Line Number="123">
<![CDATA[	Temp2:=TTau-1.222;]]>
</Line>
<Line Number="124">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="125">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="126">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="127">
<![CDATA[	For i:=0 To 33 Do]]>
</Line>
<Line Number="128">
<![CDATA[		Temp3:=R1ni[i]*(Temp1**R1Ii[i])*(Temp2**R1Ji[i]);]]>
</Line>
<Line Number="129">
<![CDATA[		Gam:=Gam+Temp3*R1Ji[i];]]>
</Line>
<Line Number="130">
<![CDATA[		Gam1:=Gam1+Temp3;]]>
</Line>
<Line Number="131">
<![CDATA[	End_For;]]>
</Line>
<Line Number="132">
<![CDATA[	Gam:=Gam/Temp2;]]>
</Line>
<Line Number="133">
<![CDATA[	S1:=R*(TTau*Gam - Gam1);]]>
</Line>
<Line Number="134">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="135">
<![CDATA[	// --------------Calculate Tb23-----------------------------------------------]]>
</Line>
<Line Number="136">
<![CDATA[	T:=((572.5446+SQRT((PU-13.918839)/0.001019297))*10000)/10000.0;]]>
</Line>
<Line Number="137">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="138">
<![CDATA[	// --------------Calculate Region 3/2 Boundary: Region 2 (Tb23, PU)-----------]]>
</Line>
<Line Number="139">
<![CDATA[	TTau:=540.0/T;]]>
</Line>
<Line Number="140">
<![CDATA[	Temp2:=TTau-0.5;]]>
</Line>
<Line Number="141">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="142">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="143">
<![CDATA[	Gam2:=ln(PU);]]>
</Line>
<Line Number="144">
<![CDATA[	Gam3:=0.0;]]>
</Line>
<Line Number="145">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="146">
<![CDATA[		Temp3:=R2ni0[i]*(TTau**R2Ji0[i]);]]>
</Line>
<Line Number="147">
<![CDATA[		Gam:=Gam+Temp3 * R2Ji0[i];]]>
</Line>
<Line Number="148">
<![CDATA[		Gam2:=Gam2+Temp3;]]>
</Line>
<Line Number="149">
<![CDATA[	End_For;]]>
</Line>
<Line Number="150">
<![CDATA[	Temp1:=SQRT(PU);]]>
</Line>
<Line Number="151">
<![CDATA[	Temp3:=SQRT(Temp2);]]>
</Line>
<Line Number="152">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="153">
<![CDATA[		Temp4:=R22ni[i]*((Temp1**R2Ii[i])*(Temp3**R2Ji[i]))**2;]]>
</Line>
<Line Number="154">
<![CDATA[		Gam1:=Gam1+Temp4*R2Ji[i];]]>
</Line>
<Line Number="155">
<![CDATA[		Gam3:=Gam3+Temp4;]]>
</Line>
<Line Number="156">
<![CDATA[	End_For;]]>
</Line>
<Line Number="157">
<![CDATA[	Gam:=Gam/TTau;]]>
</Line>
<Line Number="158">
<![CDATA[	Gam1:=Gam1/Temp2;]]>
</Line>
<Line Number="159">
<![CDATA[	S2:=R*(TTau*(Gam+Gam1)-(Gam2+Gam3));]]>
</Line>
<Line Number="160">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="161">
<![CDATA[	// --------------Calculate Region 2/5 Boundary: Region 2 (1073.15, PU)--------]]>
</Line>
<Line Number="162">
<![CDATA[	TTau:=540.0/1073.15;]]>
</Line>
<Line Number="163">
<![CDATA[	Temp2:=TTau-0.5;]]>
</Line>
<Line Number="164">
<![CDATA[	Gam:=0.0;]]>
</Line>
<Line Number="165">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="166">
<![CDATA[	Gam2:=ln(PU);]]>
</Line>
<Line Number="167">
<![CDATA[	Gam3:=0.0;]]>
</Line>
<Line Number="168">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="169">
<![CDATA[		Temp3:=R2ni0[i]*(TTau**R2Ji0[i]);]]>
</Line>
<Line Number="170">
<![CDATA[		Gam:=Gam+Temp3 * R2Ji0[i];]]>
</Line>
<Line Number="171">
<![CDATA[		Gam2:=Gam2+Temp3;]]>
</Line>
<Line Number="172">
<![CDATA[	End_For;]]>
</Line>
<Line Number="173">
<![CDATA[	Temp1:=SQRT(PU);]]>
</Line>
<Line Number="174">
<![CDATA[	Temp3:=SQRT(Temp2);]]>
</Line>
<Line Number="175">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="176">
<![CDATA[		Temp4:=R22ni[i]*((Temp1**R2Ii[i])*(Temp3**R2Ji[i]))**2;]]>
</Line>
<Line Number="177">
<![CDATA[		Gam1:=Gam1+Temp4*R2Ji[i];]]>
</Line>
<Line Number="178">
<![CDATA[		Gam3:=Gam3+Temp4;]]>
</Line>
<Line Number="179">
<![CDATA[	End_For;]]>
</Line>
<Line Number="180">
<![CDATA[	Gam:=Gam/TTau;]]>
</Line>
<Line Number="181">
<![CDATA[	Gam1:=Gam1/Temp2;]]>
</Line>
<Line Number="182">
<![CDATA[	S3:=R*(TTau*(Gam+Gam1)-(Gam2+Gam3));]]>
</Line>
<Line Number="183">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="184">
<![CDATA[	If PU < 22.064 Then]]>
</Line>
<Line Number="185">
<![CDATA[		If SMIN <= SU AND SU <= S1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="186">
<![CDATA[		If S1 < SU AND SU < S2 Then]]>
</Line>
<Line Number="187">
<![CDATA[			// ------Calculate Region 3/4 Boundary--------------------------------]]>
</Line>
<Line Number="188">
<![CDATA[			SIG1:=(SU/5.2)-1.03;]]>
</Line>
<Line Number="189">
<![CDATA[			SIG2:=(SU/5.2)-0.699;]]>
</Line>
<Line Number="190">
<![CDATA[			P:=0;]]>
</Line>
<Line Number="191">
<![CDATA[			For i:=0 To 9 Do]]>
</Line>
<Line Number="192">
<![CDATA[				P:=P+ps3_n[i]*(SIG1**ps3_I[i])*(SIG2**ps3_J[i]);]]>
</Line>
<Line Number="193">
<![CDATA[			End_For;]]>
</Line>
<Line Number="194">
<![CDATA[			P:=P*22.0;]]>
</Line>
<Line Number="195">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="196">
<![CDATA[			If PU < P Then Out_Region:=4; Else Out_Region:=3; End_If;]]>
</Line>
<Line Number="197">
<![CDATA[		End_If;]]>
</Line>
<Line Number="198">
<![CDATA[		If S2 <= SU AND SU <= S3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="199">
<![CDATA[	End_If;]]>
</Line>
<Line Number="200">
<![CDATA[	If 22.064 <= PU Then]]>
</Line>
<Line Number="201">
<![CDATA[		If SMIN <= SU AND SU <= S1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="202">
<![CDATA[		If S1 < SU AND SU < S2 Then Out_Region:=3; End_If;]]>
</Line>
<Line Number="203">
<![CDATA[		If S2 <= SU AND SU <= S3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="204">
<![CDATA[	End_If;]]>
</Line>
<Line Number="205">
<![CDATA[End_If;]]>
</Line>
<Line Number="206">
<![CDATA[If Out_Region <> 0 Then Sts_OutErr:=0; Else Sts_OutErr:=1; End_If;]]>
</Line>
<Line Number="207">
<![CDATA[S_Region:=0;]]>
</Line>
<Line Number="208">
<![CDATA[Case Out_Region Of]]>
</Line>
<Line Number="209">
<![CDATA[	1:]]>
</Line>
<Line Number="210">
<![CDATA[		LV:=0;]]>
</Line>
<Line Number="211">
<![CDATA[		// ---------Calculate Temperature Region 1 T(P,s)-------------------------]]>
</Line>
<Line Number="212">
<![CDATA[		SIG1:=SU+2;]]>
</Line>
<Line Number="213">
<![CDATA[		LT:=0;]]>
</Line>
<Line Number="214">
<![CDATA[		For i:=0 To 19 Do]]>
</Line>
<Line Number="215">
<![CDATA[			LT:=LT+t1ps_n[i]*(PU**t1ps_I[i])*(SIG1**t1ps_J[i]);]]>
</Line>
<Line Number="216">
<![CDATA[		End_For;]]>
</Line>
<Line Number="217">
<![CDATA[		//------------------------------------------------------------------------]]>
</Line>
<Line Number="218">
<![CDATA[	2:]]>
</Line>
<Line Number="219">
<![CDATA[		LV:=0;]]>
</Line>
<Line Number="220">
<![CDATA[		If PU<=4 Then]]>
</Line>
<Line Number="221">
<![CDATA[			S_Region:=1;]]>
</Line>
<Line Number="222">
<![CDATA[			// -----Calculate Temperature Region 2a T(P,s)------------------------]]>
</Line>
<Line Number="223">
<![CDATA[			SIG1:=(SU/2.0)-2;]]>
</Line>
<Line Number="224">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="225">
<![CDATA[			For i:=0 To 45 Do]]>
</Line>
<Line Number="226">
<![CDATA[				LT:=LT+t2aps_n[i]*(PU**t2aps_I[i])*(SIG1**t2aps_J[i]);]]>
</Line>
<Line Number="227">
<![CDATA[			End_For;]]>
</Line>
<Line Number="228">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="229">
<![CDATA[		Else]]>
</Line>
<Line Number="230">
<![CDATA[			If SU >= 5.85 Then]]>
</Line>
<Line Number="231">
<![CDATA[				S_Region:=2;]]>
</Line>
<Line Number="232">
<![CDATA[				// -Calculate Temperature Region 2b T(P,s)------------------------]]>
</Line>
<Line Number="233">
<![CDATA[				SIG1:=10-(SU/0.7853);]]>
</Line>
<Line Number="234">
<![CDATA[				LT:=0;]]>
</Line>
<Line Number="235">
<![CDATA[				For i:=0 To 43 Do]]>
</Line>
<Line Number="236">
<![CDATA[					LT:=LT+t2bps_n[i]*(PU**t2bps_I[i])*(SIG1**t2bps_J[i]);]]>
</Line>
<Line Number="237">
<![CDATA[				End_For;]]>
</Line>
<Line Number="238">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="239">
<![CDATA[			Else]]>
</Line>
<Line Number="240">
<![CDATA[				S_Region:=3;]]>
</Line>
<Line Number="241">
<![CDATA[				// -Calculate Temperature Region 2c T(P,s)------------------------]]>
</Line>
<Line Number="242">
<![CDATA[				SIG1:=2-(SU/2.9251);]]>
</Line>
<Line Number="243">
<![CDATA[				LT:=0;]]>
</Line>
<Line Number="244">
<![CDATA[				For i:=0 To 29 Do]]>
</Line>
<Line Number="245">
<![CDATA[					LT:=LT+t2cps_n[i]*(PU**t2cps_I[i])*(SIG1**t2cps_J[i]);]]>
</Line>
<Line Number="246">
<![CDATA[				End_For;]]>
</Line>
<Line Number="247">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="248">
<![CDATA[			End_If;]]>
</Line>
<Line Number="249">
<![CDATA[		End_If;]]>
</Line>
<Line Number="250">
<![CDATA[	3:	]]>
</Line>
<Line Number="251">
<![CDATA[		If SU <= 4.41202148223476 Then]]>
</Line>
<Line Number="252">
<![CDATA[			S_Region:=1;]]>
</Line>
<Line Number="253">
<![CDATA[			// ----------Calculate Volume 3a v(p,s)-------------------------------]]>
</Line>
<Line Number="254">
<![CDATA[			P1:=(PU/100.0)+0.187;]]>
</Line>
<Line Number="255">
<![CDATA[			SIG1:=(SU/4.4)-0.755;]]>
</Line>
<Line Number="256">
<![CDATA[			LV:=0;]]>
</Line>
<Line Number="257">
<![CDATA[			For i:=0 To 27 Do]]>
</Line>
<Line Number="258">
<![CDATA[				LV:=LV+v3aps_n[i]*(P1**v3aps_I[i])*(SIG1**v3aps_J[i]);]]>
</Line>
<Line Number="259">
<![CDATA[			End_For;]]>
</Line>
<Line Number="260">
<![CDATA[			LV:=LV*0.0028;]]>
</Line>
<Line Number="261">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="262">
<![CDATA[			// -----Calculate Temperature 3a T(p,s)-------------------------------]]>
</Line>
<Line Number="263">
<![CDATA[			SIG1:=(SU/4.4)-0.703;]]>
</Line>
<Line Number="264">
<![CDATA[			P1:=(PU/100.0)+0.240;]]>
</Line>
<Line Number="265">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="266">
<![CDATA[			For i:=0 To 32 Do]]>
</Line>
<Line Number="267">
<![CDATA[				LT:=LT+t3aps_n[i]*(P1**t3aps_I[i])*(SIG1**t3aps_J[i]);]]>
</Line>
<Line Number="268">
<![CDATA[			End_For;]]>
</Line>
<Line Number="269">
<![CDATA[			LT:=LT*760.0;]]>
</Line>
<Line Number="270">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="271">
<![CDATA[		Else]]>
</Line>
<Line Number="272">
<![CDATA[			S_Region:=2;]]>
</Line>
<Line Number="273">
<![CDATA[			// ----------Calculate Volume 3b v(p,s)-------------------------------]]>
</Line>
<Line Number="274">
<![CDATA[			P1:=(PU/100.0)+0.298;]]>
</Line>
<Line Number="275">
<![CDATA[			SIG1:=(SU/5.3)-0.816;]]>
</Line>
<Line Number="276">
<![CDATA[			LV:=0;]]>
</Line>
<Line Number="277">
<![CDATA[			For i:=0 To 30 Do]]>
</Line>
<Line Number="278">
<![CDATA[				LV:=LV+v3bps_n[i]*(P1**v3bps_I[i])*(SIG1**v3bps_J[i]);]]>
</Line>
<Line Number="279">
<![CDATA[			End_For;]]>
</Line>
<Line Number="280">
<![CDATA[			LV:=LV*0.0088;]]>
</Line>
<Line Number="281">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="282">
<![CDATA[			// -----Calculate Temperature 3b T(p,s)-------------------------------]]>
</Line>
<Line Number="283">
<![CDATA[			SIG1:=(SU/5.3)-0.818;]]>
</Line>
<Line Number="284">
<![CDATA[			P1:=(PU/100.0)+0.760;]]>
</Line>
<Line Number="285">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="286">
<![CDATA[			For i:=0 To 27 Do]]>
</Line>
<Line Number="287">
<![CDATA[				LT:=LT+t3bps_n[i]*(P1**t3bps_I[i])*(SIG1**t3bps_J[i]);]]>
</Line>
<Line Number="288">
<![CDATA[			End_For;]]>
</Line>
<Line Number="289">
<![CDATA[			LT:=LT*860.0;]]>
</Line>
<Line Number="290">
<![CDATA[			// --------------------------------------------------------------------]]>
</Line>
<Line Number="291">
<![CDATA[		End_If;]]>
</Line>
<Line Number="292">
<![CDATA[	4:]]>
</Line>
<Line Number="293">
<![CDATA[		// --------------Calculate Tsat(PU)-------------------------------------------]]>
</Line>
<Line Number="294">
<![CDATA[		Beta:=PU**0.25;]]>
</Line>
<Line Number="295">
<![CDATA[		E:=Beta**2 - 17.073846940092*Beta + 14.91510861353;]]>
</Line>
<Line Number="296">
<![CDATA[		F:=1167.0521452767*Beta**2 + 12020.82470247*Beta - 4823.2657361591;]]>
</Line>
<Line Number="297">
<![CDATA[		G:=-724213.16703206*Beta**2 - 3232555.0322333*Beta + 405113.40542057;]]>
</Line>
<Line Number="298">
<![CDATA[		D:=-2.0*G/(F+(F**2-4.0*E*G)**0.5);]]>
</Line>
<Line Number="299">
<![CDATA[		LT:=(650.17534844798+D-((650.17534844798+D)**2-4.0*(650.17534844798*D-0.23855557567849))**0.5)/2.0;]]>
</Line>
<Line Number="300">
<![CDATA[		// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="301">
<![CDATA[		]]>
</Line>
<Line Number="302">
<![CDATA[End_Case;]]>
</Line>
<Line Number="303">
<![CDATA[If Sts_OutErr Then]]>
</Line>
<Line Number="304">
<![CDATA[	Out_Volume:=0;]]>
</Line>
<Line Number="305">
<![CDATA[	Out_Temperature:=0;]]>
</Line>
<Line Number="306">
<![CDATA[Else	]]>
</Line>
<Line Number="307">
<![CDATA[	If Cfg_SI_Eng Then]]>
</Line>
<Line Number="308">
<![CDATA[		Out_Temperature:=LT*9/5-459.67;]]>
</Line>
<Line Number="309">
<![CDATA[		Out_Volume:=LV*16.01846421978841;]]>
</Line>
<Line Number="310">
<![CDATA[	Else]]>
</Line>
<Line Number="311">
<![CDATA[		Out_Temperature:=LT-273.15;]]>
</Line>
<Line Number="312">
<![CDATA[		Out_Volume:=LV;]]>
</Line>
<Line Number="313">
<![CDATA[	End_If;]]>
</Line>
<Line Number="314">
<![CDATA[End_If;]]>
</Line>
<Line Number="315">
<![CDATA[]]>
</Line>
<Line Number="316">
<![CDATA[]]>
</Line>
<Line Number="317">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
