<![CDATA[Task Inhibited if nonzero, Active if zero]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Val_Name" DataType="STRING_40" ExternalAccess="Read Only">
