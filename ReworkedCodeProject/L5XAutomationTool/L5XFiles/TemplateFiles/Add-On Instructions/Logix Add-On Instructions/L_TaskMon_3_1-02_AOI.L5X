<Description>
<![CDATA[Must contain AOI name, used for HMI and Information S/W]]>
</Description>
<DefaultData>09 00 00 00 4C 5F 54 61 73 6B 4D 6F 6E 00 00 00 
00 00 00 00</DefaultData>
<DefaultData Format="String" Length="9">
<![CDATA['L_TaskMon']]>
</DefaultData>
</LocalTag>
