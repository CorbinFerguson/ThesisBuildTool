<Parameter Name="Cfg_BumpT" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Bump (manual top-off) Time (sec)]]>
