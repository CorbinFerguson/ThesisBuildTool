</DefaultData>
</Parameter>
<Parameter Name="Inp_Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[1=Reset Alarm requiring reset]]>
</Description>
