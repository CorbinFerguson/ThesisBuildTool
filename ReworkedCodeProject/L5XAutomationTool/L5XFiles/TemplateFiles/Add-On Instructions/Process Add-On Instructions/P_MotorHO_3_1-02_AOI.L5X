<DefaultData>13 00 00 00 48 61 6E 64 20 4F 70 65 72 61 74 65 
64 20 4D 6F 74 6F 72 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="19">
<![CDATA['Hand Operated Motor']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SimFdbkT" DataType="TIMER" ExternalAccess="None">
<Description>
<![CDATA[Simulation Delay until Tripped Feedback received]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_RunFastFwdFdbk" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[1=Feedback shows motor running, run fast or run forward]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Bypass" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Internal Bypassable Permissives and Interlocks are Bypassed flag]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Disabled" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Internal Motor is Disabled]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SlowRevFdbk" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[1=Feedback shows motor running slow or reverse]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_BadlFdbk" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[1=Feedback shows motor running slow and fast (fwd and rev) at same time]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SimSlowRev" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Simulated Slow / Rev Run Feedback 1=Running]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Notify" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Buffer for building Val_Notify]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SimRunFastFwd" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Simulated Run / Fast / Fwd Feedback 1=Running]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_StoppedFdbk" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[1=Feedback shows motor stopped]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_SlowRevText" DataType="STRING_16" ExternalAccess="Read/Write">
<Description>
<![CDATA[Text for Slow or Reverse for display on HMI]]>
</Description>
<DefaultData>04 00 00 00 53 6C 6F 77 00 00 00 00 00 00 00 00 
00 00 00 00</DefaultData>
<DefaultData Format="String" Length="4">
<![CDATA['Slow']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Cfg_FastFwdText" DataType="STRING_16" ExternalAccess="Read/Write">
<Description>
<![CDATA[Text for Running, Fast or Forward for display on HMI]]>
</Description>
<DefaultData>07 00 00 00 52 75 6E 6E 69 6E 67 00 00 00 00 00 
00 00 00 00</DefaultData>
<DefaultData Format="String" Length="7">
<![CDATA['Running']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_TripFailT" DataType="TIMER" ExternalAccess="Read Only">
<Description>
<![CDATA[Fail to Trip Check Timer]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Inf_Tab" DataType="SINT" Radix="Decimal" ExternalAccess="Read/Write">
<Description>
<![CDATA[Tab to display (FTView ME)]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Sts" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Buffer for building Val_Sts]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Fault" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Buffer for building Val_Fault]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_SrcQ" DataType="SINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Register for building Source / Quality enumeration]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="SINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Inf_Type" DataType="STRING_16" ExternalAccess="Read Only">
<Description>
<![CDATA[Type identifier for HMI navigation]]>
</Description>
<DefaultData>09 00 00 00 50 5F 4D 6F 74 6F 72 48 4F 00 00 00 
00 00 00 00</DefaultData>
<DefaultData Format="String" Length="9">
<![CDATA['P_MotorHO']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Inf_Lib" DataType="STRING_12" ExternalAccess="Read Only">
<Description>
<![CDATA[Display Library for Faceplate call-up]]>
</Description>
<DefaultData>06 00 00 00 52 41 2D 42 41 53 00 00 00 00 00 00</DefaultData>
<DefaultData Format="String" Length="6">
<![CDATA['RA-BAS']]>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_NotRdy" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Device Not Ready conditions excluding shed latches]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Disabled is asserted; Trip Output OFF; Motor Status shown but Alarms disabled]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
OFF-SCAN (EnableIn is False) STATUS
============================================================
"Lurking" Program Commands are cleared if they are set as "Edge" triggered
(cleared by this object as received).
(Lurking Acknowledge Commands are left to perform their action.)]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_PCmdClear)OTU(PCmd_Trip);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA["Lurking" Operator Commands are cleared, as well as Program Reset.]]>
</Comment>
<Text>
<![CDATA[[OTU(OCmd_Trip) OTU(OCmd_Bypass) OTU(OCmd_Check) OTU(MCmd_Disable) ,OTU(MCmd_Enable) OTU(OCmd_Reset) OTU(OCmd_ResetAckAll) OTU(PCmd_Reset) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Since we're not processing Operator Commands, we're not READY for any of them either!]]>
</Comment>
<Text>
<![CDATA[[OTU(Rdy_Trip) OTU(Rdy_Bypass) OTU(Rdy_Check) OTU(Rdy_Disable) ,OTU(Rdy_Enable) OTU(Rdy_Reset) OTU(Rdy_ResetAckAll) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[============================================================
SIMULATION INPUTS
============================================================
If the motor is in simulation, its state can be set by triggering one of the
simulation inputs.

If the Inp_SimRunFwdFast input is triggered, set the motor to simulate
running (single-speed), running fast (two-speed) or running forward (reversing).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_SimRunFastFwd)OTL(Wrk_SimRunFastFwd)OTU(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[If the Inp_SimSlowRev input is triggered, set the motor to simulate
running slow (two-speed) or running reverse (reversing).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_SimSlowRev)OTU(Wrk_SimRunFastFwd)OTL(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[If the Inp_SimStopped input is triggered, set the motor to simulate being Stopped.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_SimStopped)OTU(Wrk_SimRunFastFwd)OTU(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[============================================================
RUN FEEDBACK DETERMINATION
============================================================
If the Motor is being simulated, use the stored simulation latches to determine the motor
run state.  If the Motor is NOT in simulation, use the actual run feedbacks.

If the Running / Fast / Forward feedback is on (simulated or real), note it in a work bit.]]>
</Comment>
<Text>
<![CDATA[[XIO(Inp_Sim) XIC(Inp_RunFastFwdFdbk) ,XIC(Inp_Sim) XIC(Wrk_SimRunFastFwd) ]OTE(Wrk_RunFastFwdFdbk);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[If the Slow / Reverse run feedback is on (simulated or real), note it in a work bit.]]>
</Comment>
<Text>
<![CDATA[[XIC(Cfg_2Spd) ,XIC(Cfg_Rev) ][XIO(Inp_Sim) XIC(Inp_SlowRevFdbk) ,XIC(Inp_Sim) XIC(Wrk_SimSlowRev) ]OTE(Wrk_SlowRevFdbk);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[If no run feedback is on, the motor is confirmed STOPPED.]]>
</Comment>
<Text>
<![CDATA[[XIO(Inp_Sim) XIO(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) ,XIC(Inp_Sim) XIO(Wrk_SimRunFastFwd) XIO(Wrk_SimSlowRev) ]OTE(Wrk_StoppedFdbk);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[If both feedbacks are on, note the Bad Feedback status.  Motor cannot be running Slow
and Fast or Forward and Reverse at the same time.]]>
</Comment>
<Text>
<![CDATA[XIO(Inp_Sim)[XIC(Wrk_RunFastFwdFdbk) XIC(Wrk_SlowRevFdbk) ,XIO(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) XIO(Wrk_StoppedFdbk) ]OTE(Wrk_BadlFdbk);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[============================================================
MOTOR FEEDBACK STATUS
============================================================
The following rungs generate the Feedback Status for this object:

Run / Fast / Fwd if the motor is running (single spped), running fast (2-speed) or running forward
(reversing) and NOT running slow or reverse.
Slow / Rev if the motor is running slow (2-spped) or running reverse (reversing) and
NOT running fast or forward.
Stopped if the motor is not ruuning, not running forward/fast nor running slow/reverse
Bad Feedback if BOTH motor feedbacks are on (can't run slow/fasst or fwd/rev at the same time).]]>
</Comment>
<Text>
<![CDATA[[MOV(6,Val_Fdbk) ,XIC(Wrk_BadlFdbk) OTE(Sts_BadFdbk) ,XIC(Wrk_SlowRevFdbk) XIO(Wrk_RunFastFwdFdbk) OTE(Sts_RunningSlowRev) [XIC(Cfg_Rev) MOV(5,Val_Fdbk) ,XIC(Cfg_2Spd) MOV(3,Val_Fdbk) ] ,XIC(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) OTE(Sts_RunningFastFwd) [XIC(Cfg_Rev) MOV(4,Val_Fdbk) ,XIC(Cfg_2Spd) MOV(2,Val_Fdbk) ,XIO(Cfg_Rev) XIO(Cfg_2Spd) MOV(1,Val_Fdbk) ] ,XIC(Wrk_StoppedFdbk) OTE(Sts_Stopped) CLR(Val_Fdbk) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Show the motor as Disabled and Not Ready, not Available, and with no
Maintenance Bypass breadcrumb.
Clear remaining Status bits.
Show the enumerated motor command as NONE.
Show the enumerated motor status as DISABLED.
Show the enumerated motor fault status as NONE.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[OTL(Sts_Disabled) OTL(Sts_NotRdy) OTU(Sts_MaintByp) ,OTL(Nrdy_Disabled) OTU(Nrdy_CfgErr) OTU(Nrdy_Intlk) ,OTU(Nrdy_Trip) OTU(Nrdy_Fail) OTU(Nrdy_IOFault) ,RES(Wrk_TripFailT) RES(Wrk_SimFdbkT) ,OTU(Sts_Tripping) ,CLR(Val_Cmd) MOV(33,Val_Sts) CLR(Val_Fault) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[If the device can be tripped, trip it to disable it when Disabled (EnableInFalse).]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasTrip)OTE(Out_Trip);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Clear the Alarms and the Notify Status, and show the Alarms Inhibited breadcrumb.]]>
</Comment>
<Text>
<![CDATA[[OTU(Alm_TripFail) OTU(Alm_IntlkTrip) OTU(Alm_IOFault) ,OTU(Sts_TripFail) OTU(Sts_IntlkTrip) OTU(Sts_IOFault) ,OTL(Sts_AlmInh) CLR(Val_Notify) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[============================================================
ENUMERATED STATUS VALUES
============================================================
Source and Quality (Srcq) for Val_InpPV
Start with the Srcq from the Input Channel object if it's available.
Otherwise, start based on bad/uncertain input bits.

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration

#####  V3.1-00  2014-06-30:  Added rung for Source/Quality enumerations.  #####]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_SrcQ) ,XIC(Inp_IOFault) MOV(34,Wrk_SrcQ) ,XIC(Inp_Sim) MOV(9,Wrk_SrcQ) ,MOV(Wrk_SrcQ,SrcQ_IO) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Source and Quality for primary values / status (SrcQ)

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration

#####  V3.1-00  2014-06-30:  Added rung for Source/Quality enumerations.  #####]]>
</Comment>
<Text>
<![CDATA[MOV(20,SrcQ);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Normal Scan: monitor hand-operated motor]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Copyright © Rockwell Automation, Inc.  All Rights Reserved.
============================================================
P_MotorHO:  PROCESS -- HAND OPERATED MOTOR (monitor)
============================================================
Revision 3.1-02 Release  2014-09-30:  See V3.1-xx Release Notes for details.
V1.x, V2.x Revision History archived.
V3.0-00  2013-06-30:  Added Inf_Lib, Cfg_HasOvldObj. Using P_Alarm V3.0.
V3.0-01  2013-07-31:  Modified Parameter descriptions only.
V3.0-02  2013-09-03:  Modified Parameter descriptions only.
V3.0-03  2013-10-30:  Corrected Parameter descriptions and default
configuration values for alarms only.
V3.1-00  2014-07-08:  Modified to use P_Alarm V3.1; added Not Ready
reason bits (Nrdy_Xxxxx), input source/quality (SrcQ) enum.
V3.1-01  2014-09-03:  Exposed fail timers ACC/PRE (read-only). Corrections
to Nrdy_ trip and reset logic. Using P_Alarm V3.1-01.
V3.1-02  2014-09-30:  Unchanged, but using P_Alarm V3.1-02.
============================================================
This Instruction monitors a locally- (hand-) operated motor (single-speed, two-speed, or
reversing) and provides:

*  Running / Stopped, or Fast / Slow / Stopped or Forward / Reverse / Stopped status
    based on motor run feedback input states
*  Monitoring of I/O communication status and Alarm on communication failure
*  Option and output to allow TRIPPING (stopping) the motor

(Note: the Trip output used positive logic: 1 to TRIP the motor, 0 to let the motor run)

If the option to allow tripping is enabled, this instruction also provides:

*  Trip by Operator, Program or Interlock at any time (no Mode)
*  Detection of failure to stop the motor within a configured time and Trip Failure Alarm
*  Alarm on Interlock initiated Trip if Interlock caused the motor to stop
*  Simulation, providing feedback of a working motor while disabling outputs
============================================================
SHOW LOCAL STRINGS
============================================================
The STRINGs containing the text associated with each instance of this
instruction cannot be Input or Output Parameters, because STRINGs are not
 'atomic' types. (Inputs and Outputs must be SINT, INT, DINT, REAL, or BOOL.)

In order to make it easier to find and configure these STRINGs, this rung
was added.  THE JMP (and the LBL on the following rung)
MUST NOT BE REMOVED!!!

To view the STRINGs, go to the instruction instance (in LD or FBD), RIGHT-click
to bring up the context menu and select "Open Instruction Logic".
This rung will appear with the STRING values for the selected instance.
You may double-click the STRING values here to modify them as well.]]>
</Comment>
<Text>
<![CDATA[JMP(SkipText)CONCAT(Cfg_Desc,Cfg_Label,Cfg_Tag)LOWER(Cfg_FastFwdText,Cfg_SlowRevText)LOWER(Inf_Lib,Inf_Type);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[============================================================
CONFIGURATION
============================================================
Motor cannot be configured for BOTH 2-speed AND reversing.
If it's 2-speed, turn off reversing.  User must turn off 2-speed to set reversing.
(Note:  adding another rung: XIC Cfg_Rev  OTU Cfg_2Spd would be redundant.
This rung takes care of the "both set" situation.)]]>
</Comment>
<Text>
<![CDATA[LBL(SkipText)XIC(Cfg_2Spd)OTU(Cfg_Rev);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[These rungs get Configuration data (such as timer presets) and distribute as needed.
Note that some Configuration data are used directly in-place.

Enter the time (in seconds) for the Motor to successfully stop on a trip before declaring a fault.

If the timer preset calcuated wraps negative (more than 2.14... million seconds), then max out the
Timer Preset.  Note that a negative timer preset will fault the controller!!!]]>
</Comment>
<Text>
<![CDATA[MUL(Cfg_TripFailT,1000,Wrk_TripFailT.PRE)XIC(Wrk_TripFailT.PRE.31)MOV(2147483647,Wrk_TripFailT.PRE)OTE(Err_Timer);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Enter the time (in seconds) to echo back the "tripping" state when Tripped in simulation

If the timer preset is invalid, use zero (immediately go to Stopped state).]]>
</Comment>
<Text>
<![CDATA[MUL(Cfg_SimFdbkT,1000,Wrk_SimFdbkT.PRE)XIC(Wrk_SimFdbkT.PRE.31)CLR(Wrk_SimFdbkT.PRE)OTE(Err_Sim);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[This rung generates a summary Bad Config status, simply an OR of the individual bits provided above
(in the Configuration handling section).]]>
</Comment>
<Text>
<![CDATA[[XIC(Err_Timer) ,XIC(Err_Sim) ,[XIC(TripFail.Sts_Err) ,XIC(IntlkTrip.Sts_Err) ,XIC(IOFault.Sts_Err) ] OTE(Err_Alarm) ]OTE(Sts_Err);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[============================================================
SIMULATION INPUTS
============================================================
If the motor is in simulation, its state can be set by triggering one of the
simulation inputs.

If the Inp_SimRunFwdFast input is triggered, set the motor to simulate
running (single-speed), running fast (two-speed) or running forward (reversing).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_SimRunFastFwd)OTL(Wrk_SimRunFastFwd)OTU(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[If the Inp_SimSlowRev input is triggered, set the motor to simulate
running slow (two-speed) or running reverse (reversing).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_SimSlowRev)OTU(Wrk_SimRunFastFwd)OTL(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[============================================================
SIMULATION TIMER
============================================================
If in Simulation and a Trip is in progress, run a Trip Feedback Simulation timer.]]>
</Comment>
<Text>
<![CDATA[XIC(Nrdy_Trip)XIC(Inp_Sim)TON(Wrk_SimFdbkT,?,?);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[If the Inp_SimStopped input is triggered, or when the Simulation Feedback
timer goes done, set the motor to the simulated STOPPED condition.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_SimFdbkT.dn) ,XIC(Inp_SimStopped) ]OTU(Wrk_SimRunFastFwd)OTU(Wrk_SimSlowRev);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[============================================================
RUN FEEDBACK DETERMINATION
============================================================
If the Motor is being simulated, use the stored simulation latches to determine the motor
run state.  If the Motor is NOT in simulation, use the actual run feedbacks.

If the Running / Fast / Forward feedback is on (simulated or real), note it in a work bit.]]>
</Comment>
<Text>
<![CDATA[[XIO(Inp_Sim) XIC(Inp_RunFastFwdFdbk) ,XIC(Inp_Sim) XIC(Wrk_SimRunFastFwd) ]OTE(Wrk_RunFastFwdFdbk);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[If the Slow / Reverse run feedback is on (simulated or real), note it in a work bit.]]>
</Comment>
<Text>
<![CDATA[[XIC(Cfg_2Spd) ,XIC(Cfg_Rev) ][XIO(Inp_Sim) XIC(Inp_SlowRevFdbk) ,XIC(Inp_Sim) XIC(Wrk_SimSlowRev) ]OTE(Wrk_SlowRevFdbk);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[If no run feedback is on, the motor is confirmed STOPPED.]]>
</Comment>
<Text>
<![CDATA[[XIO(Inp_Sim) XIO(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) ,XIC(Inp_Sim) XIO(Wrk_SimRunFastFwd) XIO(Wrk_SimSlowRev) ]OTE(Wrk_StoppedFdbk);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[If both feedbacks are on, note the Bad Feedback status.  Motor cannot be running Slow
and Fast or Forward and Reverse at the same time.]]>
</Comment>
<Text>
<![CDATA[XIO(Inp_Sim)[XIC(Wrk_RunFastFwdFdbk) XIC(Wrk_SlowRevFdbk) ,XIO(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) XIO(Wrk_StoppedFdbk) ]OTE(Wrk_BadlFdbk);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[============================================================
MOTOR FEEDBACK STATUS
============================================================
The following rungs generate the Feedback Status for this object:

Run / Fast / Fwd if the motor is running (single spped), running fast (2-speed) or running forward
(reversing) and NOT running slow or reverse (except when tripping)
Slow / Rev if the motor is running slow (2-spped) or running reverse (reversing) and
NOT running fast or forward (except when tripping)
Stopped if the motor is not ruuning, not running forward/fast or running slow/reverse
Bad Feedback if BOTH motor feedbacks are on (can't run slow/fasst or fwd/rev at the same time).]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_BadlFdbk) MOV(6,Val_Fdbk) ,XIC(Wrk_SlowRevFdbk) XIO(Wrk_RunFastFwdFdbk) [XIC(Cfg_Rev) MOV(5,Val_Fdbk) ,XIC(Cfg_2Spd) MOV(3,Val_Fdbk) ] ,XIC(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) [XIC(Cfg_Rev) MOV(4,Val_Fdbk) ,XIC(Cfg_2Spd) MOV(2,Val_Fdbk) ,XIO(Cfg_Rev) XIO(Cfg_2Spd) MOV(1,Val_Fdbk) ] ,XIC(Wrk_StoppedFdbk) CLR(Val_Fdbk) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[============================================================
INTERLOCK / PERMISSIVE BYPASS / CHECK COMMAND HANDLING
============================================================
The Bypass Command bypasses the Bypassable Permissives and Interlocks.]]>
</Comment>
<Text>
<![CDATA[XIC(OCmd_Bypass)OTU(OCmd_Bypass)OTL(Wrk_Bypass);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[The Check Command enables checking of ALL
Permissives and Interlocks (cancels the bypass).]]>
</Comment>
<Text>
<![CDATA[XIC(OCmd_Check)OTU(OCmd_Check)OTU(Wrk_Bypass);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[If the internal Bypass flag is set, Bypassable Interlocks and Permissives ARE BYPASSED.
Bypassing is ACTIVE if Bypass selected.  (This object has no Maintenance or Override Mode.)

This is the only Maintenance Bypass function, so show the Maintenance Bypass breadcrumb]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_Bypass)OTE(Sts_Bypass)OTE(Sts_BypActive)OTE(Sts_MaintByp);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[If Trip is used, then the motor trip interlocks can be bypassed or not.
Ready for Interlock / Permissive Bypass if not bypassed.
Ready to cancel Bypass (resume checking) if bypassed.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasTrip)[XIO(Wrk_Bypass) OTE(Rdy_Bypass) ,XIC(Wrk_Bypass) OTE(Rdy_Check) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[============================================================
DEVICE DISABLE/ENABLE COMMAND HANDLING
============================================================
The Disable Command disables the motor so it cannot be run.]]>
</Comment>
<Text>
<![CDATA[XIC(MCmd_Disable)OTU(MCmd_Disable)OTL(Wrk_Disabled);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[The Enable Command cancels the Disable and allows the motor to run.]]>
</Comment>
<Text>
<![CDATA[[XIC(MCmd_Enable) OTU(MCmd_Enable) ,XIO(Cfg_HasTrip) ]OTU(Wrk_Disabled);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[If the internal Disabled flag is set, the motor is DISABLED.]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_Disabled)OTE(Sts_Disabled);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[If Trip is used, then the motor tripping can be enabled or disabled:
Ready to Disable device if in Maintenance Mode and device is NOT Disabled.
Ready to Enable device if in Maintenance Mode and device IS Disabled.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasTrip)[XIO(Wrk_Disabled) OTE(Rdy_Disable) ,XIC(Wrk_Disabled) OTE(Rdy_Enable) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[============================================================
ALARM RESET COMMAND HANDLING
============================================================
This rung handles the Alarm Reset Input and Commands
and the "Reset and Ack All" Operator Command.

This rung processes received Reset Commands from:

1.  The Operator via HMI Operator Command, or
2.  Higher-level strategies via Program Command
3.  Pushbuttons or other block via Input
4.  Resets initiated by other device Operator Commands (if configured to do so)
and forwards the Reset to ALL Alarms and latched Shed conditions.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####
#####  V3.1-01  2014-08-29:  Corrections to Nrdy_ trip and reset logic.  #####]]>
</Comment>
<Text>
<![CDATA[[XIC(OCmd_Reset) OTU(OCmd_Reset) ,XIC(OCmd_Trip) XIC(Cfg_OCmdResets) ,XIC(OCmd_ResetAckAll) OTU(OCmd_ResetAckAll) [OTL(TripFail.PCmd_Ack) ,OTL(IntlkTrip.PCmd_Ack) ,OTL(IOFault.PCmd_Ack) ] ,XIC(PCmd_Reset) [XIC(Cfg_PCmdClear) OTU(PCmd_Reset) ,NOP() ] ,XIC(Inp_Reset) ][OTL(TripFail.PCmd_Reset) OTL(IntlkTrip.PCmd_Reset) OTL(IOFault.PCmd_Reset) ,XIC(Sts_TripFail) RES(Wrk_TripFailT) ,OTU(Nrdy_Fail) OTU(Nrdy_Trip) ,[XIO(Inp_IOFault) ,XIC(Inp_Sim) ] OTU(Nrdy_IOFault) ,RES(Wrk_SimFdbkT) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[============================================================
MOTOR COMMAND / TRIP HANDLING
============================================================
If Interlocks are not OK (Non-Bypassable not OK, or bypassable not OK
and not bypassed by Maintenance, Override or Bypass Command), 
OR if the motor is commanded to trip (Program or Operator), TRIP IT..

If it is RUNNING and the Interlock
tripped it, raise the Interlock Trip alarm.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[XIC(OCmd_Trip) OTU(OCmd_Trip) ,XIC(PCmd_Trip) [XIC(Cfg_PCmdClear) OTU(PCmd_Trip) ,NOP() ] ]OTL(Nrdy_Trip);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[If the Motor was told to Trip and it Stopped, then Trip is completed (successfully).
Turn off the "Trip in Progress" latch.  Also turn it off if tripping capability is no longer configured.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasTrip) ,XIO(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) ]OTU(Nrdy_Trip);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[============================================================
MOTOR FAIL TO TRIP DETECTION
============================================================
If the Motor was told to trip and it hasn't stopped, the Wrk_Trip
bit will be set.  Run a Trip Fail timer, and if it goes done, raise the Fail to Trip Status.
Since we're done with this trip (even though it failed), turn off the "Trip in Progress" latch.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####
#####  V3.1-01  2014-08-29:  Corrections to Nrdy_ trip and reset logic.  #####]]>
</Comment>
<Text>
<![CDATA[XIC(Sts_NotRdy)XIC(Cfg_HasTrip)[XIC(Wrk_RunFastFwdFdbk) ,XIC(Wrk_SlowRevFdbk) ][TON(Wrk_TripFailT,?,?) ,XIC(Wrk_TripFailT.DN) OTU(Nrdy_Trip) OTE(Sts_TripFail) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[============================================================
SHED ON FAULT LOGIC
============================================================
This rung handles latching in of conditions which are configured to cause
motor to shed (trip).

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[XIC(Sts_TripFail)XIC(Cfg_ShedOnFailToTrip)OTL(Nrdy_Fail);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[The Motor is NOT READY TO RUN if:
* Interlocks are not OK and not bypassed
* Non-bypassable Interlocks are not OK
* Permissives are not OK and not bypassed,
or Non-Bypassable Permissives are not OK, 
and the motor is not already starting or running
* There's an I/O failure and the motor is NOT being simulated
* The motor has a Fail to Start or Fail to Stop that has not been reset
* The motor is disabled.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####
#####  V3.1-01  2014-08-29:  Corrections to Nrdy_ trip and reset logic.  #####]]>
</Comment>
<Text>
<![CDATA[[XIC(Sts_Disabled) OTE(Nrdy_Disabled) ,XIC(Sts_Err) OTE(Nrdy_CfgErr) ,[XIO(Inp_IntlkOK) XIO(Sts_Bypass) ,XIO(Inp_NBIntlkOK) ] [XIC(Cfg_HasTrip) [XIC(Wrk_RunFastFwdFdbk) ,[XIC(Cfg_2Spd) ,XIC(Cfg_Rev) ] XIC(Wrk_SlowRevFdbk) ] OTE(Sts_IntlkTrip) ,OTE(Nrdy_Intlk) ] ,XIC(Inp_IOFault) XIO(Inp_Sim) OTE(Sts_IOFault) XIO(Cfg_ShedOnIOFault) OTL(Nrdy_IOFault) ]OTE(Wrk_NotRdy);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[The Motor is NOT READY TO RUN if:
* Interlocks are not OK and not bypassed
* Non-bypassable Interlocks are not OK
* Permissives are not OK and not bypassed,
or Non-Bypassable Permissives are not OK, 
and the motor is not already starting or running
* There's an I/O failure and the motor is NOT being simulated
* The motor has a Fail to Start or Fail to Stop that has not been reset
* The motor is disabled.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####
#####  V3.1-01  2014-08-29:  Corrections to Nrdy_ trip and reset logic.  #####]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_NotRdy) ,XIC(Nrdy_Trip) ,XIC(Nrdy_Fail) ,XIC(Nrdy_IOFault) ]OTE(Sts_NotRdy);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[============================================================
DEVICE COMMAND ENUMERATED VALUE
============================================================
Val_Cmd is the command currently being processed:
0 = None
7 = Trip

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[XIO(Nrdy_Trip) CLR(Val_Cmd) ,XIC(Nrdy_Trip) MOV(7,Val_Cmd) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[============================================================
OUTPUT GENERATION
============================================================

If the Motor is NOT SIMULATED and HAS THE TRIP FUNCTION WIRED, generate the
appropriate output for the Motor when the TRIP is activated.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasTrip)XIO(Inp_Sim)XIC(Sts_NotRdy)OTE(Out_Trip);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[============================================================
STATUS GENERATION
============================================================

The following rungs generate Status bits for this object.

This rung generates the Motor Monitoring and Trip Status bits:
Run / Fast / Fwd if the motor is running (single spped), running fast (2-speed) or running forward
(reversing) and NOT running slow or reverse (except when tripping)
Slow / Rev if the motor is running slow (2-spped) or running reverse (reversing) and
NOT running fast or forward (except when tripping)
Stopped if the motor is not ruuning, not running forward/fast or running slow/reverse
Bad Feedback if BOTH motor feedbacks are on (can't run slow/fasst or fwd/rev at the same time)
Tripping, if a trip is in progress.
Disabled, if the motor is Disabled by command.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_RunFastFwdFdbk) XIO(Wrk_SlowRevFdbk) XIO(Nrdy_Trip) OTE(Sts_RunningFastFwd) ,XIC(Wrk_SlowRevFdbk) XIO(Wrk_RunFastFwdFdbk) XIO(Nrdy_Trip) OTE(Sts_RunningSlowRev) ,XIC(Wrk_StoppedFdbk) OTE(Sts_Stopped) ,XIC(Wrk_BadlFdbk) OTE(Sts_BadFdbk) ,XIC(Nrdy_Trip) XIO(Wrk_StoppedFdbk) OTE(Sts_Tripping) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[Val_Sts is the current device status, as determined by this AOI,
based on its knowledge of commands executed and feedback.
(This is the status that should be monitored by, for example, FT Historian.)
0 = Powerup / Unknown
1 = Stopped
2 = Running
3 = Running Fast
4 = Running Slow
5 = Running Forward
6 = Running Reverse
13 = Tippping
33 = Device Disabled

Val_Fault is the current device fault status, as determined by this AOI,
based on its knowledge of commands executed and feedback.
(This is the fault status that should be monitored by, for example, FT Historian.)
0 = None
18 = Fail to Trip
32 = I/O Fault (from Input)
34 = Configuration Error

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_Sts) CLR(Wrk_Fault) ,XIC(Sts_Stopped) MOV(1,Wrk_Sts) ,XIC(Sts_RunningFastFwd) [XIO(Cfg_2Spd) XIO(Cfg_Rev) MOV(2,Wrk_Sts) ,XIC(Cfg_2Spd) MOV(3,Wrk_Sts) ,XIC(Cfg_Rev) MOV(5,Wrk_Sts) ] ,XIC(Sts_RunningSlowRev) [XIC(Cfg_2Spd) MOV(4,Wrk_Sts) ,XIC(Cfg_Rev) MOV(6,Wrk_Sts) ] ,XIC(Sts_Tripping) MOV(13,Wrk_Sts) ,XIC(Sts_TripFail) MOV(18,Wrk_Fault) ,XIC(Nrdy_IOFault) MOV(32,Wrk_Fault) ,XIC(Sts_Disabled) MOV(33,Wrk_Sts) ,XIC(Sts_Err) MOV(34,Wrk_Fault) ,MOV(Wrk_Sts,Val_Sts) MOV(Wrk_Fault,Val_Fault) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[============================================================
ENUMERATED SOURCE / QUALITY VALUES
============================================================
Source and Quality for Input / Output values / status (SrcQ_IO)

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration

#####  V3.1-00  2014-06-30:  Added rung for Source/Quality enumerations.  #####]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_SrcQ) ,XIC(Inp_IOFault) MOV(34,Wrk_SrcQ) ,XIC(Inp_Sim) MOV(9,Wrk_SrcQ) ,MOV(Wrk_SrcQ,SrcQ_IO) ];]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[Source and Quality for primary values / status (SrcQ)

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration

#####  V3.1-00  2014-06-30:  Added rung for Source/Quality enumerations.  #####]]>
</Comment>
<Text>
<![CDATA[MOV(SrcQ_IO,SrcQ);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[============================================================
OPERATOR COMMAND READIES
============================================================

Ready to Trip if Tripping option is enabled, no trip is already in progress, the motor is Running
(any speed/direction), Interlocks are OK and the function is not Disabled.

#####  V3.1-01  2014-08-29:  Corrections to Nrdy_ trip and reset logic.  #####]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasTrip)[XIC(Wrk_RunFastFwdFdbk) ,[XIC(Cfg_2Spd) ,XIC(Cfg_Rev) ] XIC(Wrk_SlowRevFdbk) ]XIO(Wrk_NotRdy)[XIO(Sts_NotRdy) ,XIC(Cfg_OCmdResets) ]OTE(Rdy_Trip);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[============================================================
ALARM PROCESSING
============================================================
Pass the Cfg_PCmdClear configuration down to each P_Alarm instance.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_PCmdClear)OTE(TripFail.Cfg_PCmdClear)OTE(IntlkTrip.Cfg_PCmdClear)OTE(IOFault.Cfg_PCmdClear);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[The various alarms are ALWAYS allowed to Exist (Cfg_HasXxxAlarm can be 1), EXCEPT:
* If the motor DOES NOT HAVE TRIP CAPABILITY, the Fail to Trip and Interlock Trip
alarms will never occur and should not exist.  (If the trip function exists, 
these alarms must be allowed to exist.)

#####  V3.0-00  2013-06-30:  Added PCfg_AllowExist on P_Alarm 3.0.  #####]]>
</Comment>
<Text>
<![CDATA[[OTL(IOFault.PCfg_AllowExist) ,XIC(Cfg_HasTrip) OTE(IntlkTrip.PCfg_AllowExist) OTE(TripFail.PCfg_AllowExist) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[============================================================
ALARM PROCESSING
============================================================
Handle Motor Failed to Trip Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(TripFail);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[Handle Interlock Trip Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(IntlkTrip);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[Handle I/O Fault Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(IOFault);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[If ANY alarm is Disabled, Inhibited or Suppressed, set the Alarm Inhibit
summary status bit (which puts the "I" box on the graphic symbol).]]>
</Comment>
<Text>
<![CDATA[[XIC(TripFail.Sts_AlmInh) ,XIC(IntlkTrip.Sts_AlmInh) ,XIC(IOFault.Sts_AlmInh) ]OTE(Sts_AlmInh);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[============================================================
NOTIFICATION VALUE
============================================================
Indicate the current alarm notification level as the max of any of the alarms,
and set the low-order bit for reset or ack required:
0 = Not in alarm, acknowledged
1 = Not in alarm, unacknowledged or reset required
2 = Low severity alarm, acknowledged
3 = Low severity alarm, unacknowledged
4 = Medium severity alarm, acknowledged
5 = Medium severity alarm, unacknowledged
6 = High severity alarm, acknowledged
7 = High severity alarm, unacknowledged
8 = Urgent severity alarm, acknowledged
9 = Urgent severity alarm, unacknowledged

#####  V3.1-00  2014-06-30:  Separated Reset Reqd functions from Val_Notify  #####]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_Notify) ,GRT(TripFail.Val_Notify,Wrk_Notify) MOV(TripFail.Val_Notify,Wrk_Notify) ,GRT(IntlkTrip.Val_Notify,Wrk_Notify) MOV(IntlkTrip.Val_Notify,Wrk_Notify) ,GRT(IOFault.Val_Notify,Wrk_Notify) MOV(IOFault.Val_Notify,Wrk_Notify) ,[XIC(TripFail.Val_Notify.0) ,XIC(IntlkTrip.Val_Notify.0) ,XIC(IOFault.Val_Notify.0) ] OTE(Wrk_Notify.0) ,MOV(Wrk_Notify,Val_Notify) ];]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[This rung identifies:
* if any alarm reset or other reset is required; and
* if any reset or acknowledge from the operator is required.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx); split from Val_Notify logic (above).  #####]]>
</Comment>
<Text>
<![CDATA[[[XIC(TripFail.Rdy_Ack) ,XIC(IntlkTrip.Rdy_Ack) ,XIC(IOFault.Rdy_Ack) ] ,[XIC(TripFail.Rdy_Reset) ,XIC(IntlkTrip.Rdy_Reset) ,XIC(IOFault.Rdy_Reset) ,XIC(Nrdy_Fail) ,XIC(Nrdy_IOFault) XIO(Sts_IOFault) ] OTE(Rdy_Reset) ]OTE(Rdy_ResetAckAll);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Clear "lurking" Commands]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
PRESCAN (POWERUP) HANDLING
============================================================
"Lurking" Program Commands are cleared if they are set as "Edge" triggered
(cleared by this object as received).
(Lurking Acknowledge Commands are left to perform their action.)]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_PCmdClear)OTU(PCmd_Trip);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA["Lurking" Operator Commands are cleared, as well as Program Reset.]]>
</Comment>
<Text>
<![CDATA[[OTU(OCmd_Trip) OTU(OCmd_Bypass) OTU(OCmd_Check) OTU(MCmd_Disable) ,OTU(MCmd_Enable) OTU(OCmd_Reset) OTU(OCmd_ResetAckAll) OTU(PCmd_Reset) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Clear the latched Trip command and latched Shed faults.

#####  V3.1-00  2014-06-30: Added Not Ready reason bits (Nrdy_xxx)  #####]]>
</Comment>
<Text>
<![CDATA[OTU(Nrdy_Trip)OTU(Nrdy_Fail)OTU(Nrdy_IOFault);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[All Outputs are de-energized on Prescan.]]>
</Comment>
<Text>
<![CDATA[OTU(Out_Trip);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[On Prescan, clear the following:
Val_Cmd (no command active)
Val_Fdbk (device position not determined)
Val_Sts (device status powerup / unknown)]]>
</Comment>
<Text>
<![CDATA[CLR(Val_Cmd)CLR(Val_Fdbk)CLR(Val_Sts);]]>
</Text>
</Rung>
</RLLContent>
