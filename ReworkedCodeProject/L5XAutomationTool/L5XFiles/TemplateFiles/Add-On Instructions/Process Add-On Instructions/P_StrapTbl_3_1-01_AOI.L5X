<Description>
<![CDATA[Tank Calibration Table (level to volume)]]>
</Description>
</Parameter>
<Parameter Name="Cfg_MinorPerMajor" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Table Minor Units (in, cm, mm) per Major Unit (ft, m) (enter 0.0 if minor units not used)]]>
</Description>
<DefaultData>00 00 40 41</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="12.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_HasCTSh" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1=Include Correction for Temperature of tank Shell, 0=No CTSh]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_HasFRA" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1=Include Floating Roof Adjustment, 0=no FRA]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_CalTemp" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Temperature of Tank Calibration (typ. 60 Deg F or 15 Deg C)]]>
</Description>
<DefaultData>00 00 70 42</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="60.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_ShellCoefOfExp" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Tank Shell Linear Coefficient of Thermal Expansion (feet/Deg F or meters/Deg C)]]>
</Description>
<DefaultData>98 09 D0 36</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0000062"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_K" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Temp. weighting (enter 0.0 for insulated tank)
(see API MPMS 2.2A app. D)]]>
</Description>
<DefaultData>00 00 E0 40</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="7.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_FloatRoofLevel" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Lowest level at which to add/sub floating roof comp. (feet)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_FloatRoofCalAPI" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Degrees API for which table includes floating roof data]]>
</Description>
<DefaultData>00 00 F4 41</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="30.5"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_FloatRoofVolPerAPI" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Adjustment to table values for API <> CalAPI (vol/deg API, typ. a neg. #)]]>
</Description>
<DefaultData>00 00 20 C0</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="-2.5"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_TOV" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Raw Total Observed Volume from Cal. Table (bbl, gal, l)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_FW" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Free Water Volume (bbl, gal, l)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_TSh" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Calculated Tank Shell Temperature (Deg F, Deg C)]]>
</Description>
<DefaultData>00 00 70 42</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="60.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_CTSh" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Correction for Temperature of Tank Shell (multiplier)]]>
</Description>
<DefaultData>00 00 80 3F</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="1.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_FRA" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Floating Roof Adjustment volume (bbl, gal, l)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Val_GOV" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Primary Value: Gross Observed Volume (see API MPMS 12.1.1)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_UnderMin" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
