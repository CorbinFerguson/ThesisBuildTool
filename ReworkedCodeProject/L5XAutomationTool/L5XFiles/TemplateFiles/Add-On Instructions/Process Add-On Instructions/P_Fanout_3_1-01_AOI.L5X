<![CDATA[[XIO(Cfg_HasCV5) ,XIO(Cfg_CV5OffsetSrc) ]MOV(Cfg_CV5Offset,Val_CV5Offset);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Comment>
<![CDATA[If CV6 is not used, or if its Ratio is not configured to use Operator/Program
Settings, set its Ratio value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV6) ,XIO(Cfg_CV6RatioSrc) ]MOV(Cfg_CV6Ratio,Val_CV6Ratio);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[If CV6 is not used, or if its Offset is not configured to use Operator/Program
Settings, set its Offset value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV6) ,XIO(Cfg_CV6OffsetSrc) ]MOV(Cfg_CV6Offset,Val_CV6Offset);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Comment>
<![CDATA[If CV7 is not used, or if its Ratio is not configured to use Operator/Program
Settings, set its Ratio value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV7) ,XIO(Cfg_CV7RatioSrc) ]MOV(Cfg_CV7Ratio,Val_CV7Ratio);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[If CV7 is not used, or if its Offset is not configured to use Operator/Program
Settings, set its Offset value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV7) ,XIO(Cfg_CV7OffsetSrc) ]MOV(Cfg_CV7Offset,Val_CV7Offset);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Comment>
<![CDATA[If CV8 is not used, or if its Ratio is not configured to use Operator/Program
Settings, set its Ratio value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV8) ,XIO(Cfg_CV8RatioSrc) ]MOV(Cfg_CV8Ratio,Val_CV8Ratio);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[If CV8 is not used, or if its Offset is not configured to use Operator/Program
Settings, set its Offset value using the Configuration instead.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_HasCV8) ,XIO(Cfg_CV8OffsetSrc) ]MOV(Cfg_CV8Offset,Val_CV8Offset);]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[If Bumpless Transfer of Settings (Setting Tracking) is enabled,
copy the accepted Value of each Setting to its
Program and Operator Settings and Configuration.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_SetTrack)[MOV(Val_CV1Ratio,PSet_CV1Ratio) MOV(Val_CV1Ratio,OSet_CV1Ratio) MOV(Val_CV1Ratio,Cfg_CV1Ratio) MOV(Val_CV1Offset,PSet_CV1Offset) MOV(Val_CV1Offset,OSet_CV1Offset) MOV(Val_CV1Offset,Cfg_CV1Offset) ,XIC(Cfg_HasCV2) MOV(Val_CV2Ratio,PSet_CV2Ratio) MOV(Val_CV2Ratio,OSet_CV2Ratio) MOV(Val_CV2Ratio,Cfg_CV2Ratio) MOV(Val_CV2Offset,PSet_CV2Offset) MOV(Val_CV2Offset,OSet_CV2Offset) MOV(Val_CV2Offset,Cfg_CV2Offset) ,XIC(Cfg_HasCV3) MOV(Val_CV3Ratio,PSet_CV3Ratio) MOV(Val_CV3Ratio,OSet_CV3Ratio) MOV(Val_CV3Ratio,Cfg_CV3Ratio) MOV(Val_CV3Offset,PSet_CV3Offset) MOV(Val_CV3Offset,OSet_CV3Offset) MOV(Val_CV3Offset,Cfg_CV3Offset) ,XIC(Cfg_HasCV4) MOV(Val_CV4Ratio,PSet_CV4Ratio) MOV(Val_CV4Ratio,OSet_CV4Ratio) MOV(Val_CV4Ratio,Cfg_CV4Ratio) MOV(Val_CV4Offset,PSet_CV4Offset) MOV(Val_CV4Offset,OSet_CV4Offset) MOV(Val_CV4Offset,Cfg_CV4Offset) ,XIC(Cfg_HasCV5) MOV(Val_CV5Ratio,PSet_CV5Ratio) MOV(Val_CV5Ratio,OSet_CV5Ratio) MOV(Val_CV5Ratio,Cfg_CV5Ratio) MOV(Val_CV5Offset,PSet_CV5Offset) MOV(Val_CV5Offset,OSet_CV5Offset) MOV(Val_CV5Offset,Cfg_CV5Offset) ,XIC(Cfg_HasCV6) MOV(Val_CV6Ratio,PSet_CV6Ratio) MOV(Val_CV6Ratio,OSet_CV6Ratio) MOV(Val_CV6Ratio,Cfg_CV6Ratio) MOV(Val_CV6Offset,PSet_CV6Offset) MOV(Val_CV6Offset,OSet_CV6Offset) MOV(Val_CV6Offset,Cfg_CV6Offset) ,XIC(Cfg_HasCV7) MOV(Val_CV7Ratio,PSet_CV7Ratio) MOV(Val_CV7Ratio,OSet_CV7Ratio) MOV(Val_CV7Ratio,Cfg_CV7Ratio) MOV(Val_CV7Offset,PSet_CV7Offset) MOV(Val_CV7Offset,OSet_CV7Offset) MOV(Val_CV7Offset,Cfg_CV7Offset) ,XIC(Cfg_HasCV8) MOV(Val_CV8Ratio,PSet_CV8Ratio) MOV(Val_CV8Ratio,OSet_CV8Ratio) MOV(Val_CV8Ratio,Cfg_CV8Ratio) MOV(Val_CV8Offset,PSet_CV8Offset) MOV(Val_CV8Offset,OSet_CV8Offset) MOV(Val_CV8Offset,Cfg_CV8Offset) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[============================================================
CV INPUT PROCESSING
============================================================

CV Rate of Change Limiting

In preparation for limiting the CV rate of change (ramping), this rung
determines the time since the previous scan, using a non-stop TON timer.
When we get here, we read the accumulator (in milliseconds, so
divide by 1000.0 to get seconds), then clear the accumulator.
 Next scan the accumulator will have incremented up to the number of milliseconds
since last scan.  (Works for scan times up to 2 million seconds.....)]]>
</Comment>
<Text>
<![CDATA[MOV(2147483647,Wrk_ScanT.PRE)TON(Wrk_ScanT,?,?)DIV(Wrk_ScanT.ACC,1000.0,Wrk_ScanTime)CLR(Wrk_ScanT.ACC);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Comment>
<![CDATA[This rung determines whether the CV Input is +/- Infinity or +/- NotANumber.
In either case, the value cannot be passed into the rate of change limiter calculation.]]>
</Comment>
<Text>
<![CDATA[COP(Inp_CV,Wrk_RealChkDINT,1)MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000)OTE(Sts_CVInfNaN);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Comment>
<![CDATA[If the CV input is a valid real number, then clamp it to be within
the CV (clamping) Limits.  If it changed as a result, flag it. ]]>
</Comment>
<Text>
<![CDATA[XIO(Sts_CVInfNaN)[MOV(Inp_CV,Wrk_InpCVClamped) ,[GRT(Inp_CV,Cfg_CVMax) MOV(Cfg_CVMax,Wrk_InpCVClamped) ,LES(Inp_CV,Cfg_CVMin) MOV(Cfg_CVMin,Wrk_InpCVClamped) ] OTE(Sts_CVLimited) ];]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Comment>
<![CDATA[If the CV input was +/-Infinity or Not a Number and it becomes a valid number,
initialize the ramp (rate of change limiter) to start from the first valid value.
Then move one "step" (scan time * rate limit) toward the target value.]]>
</Comment>
<Text>
<![CDATA[XIO(Sts_CVInfNaN)[CPT(Wrk_Step,Wrk_ScanTime*Val_CVRoCLim) ,[CMP(ABS(Wrk_InpCVRamped-Wrk_InpCVClamped)<=Wrk_Step) ,EQU(Val_CVRoCLim,0.0) ,ONS(Wrk_CVValidONS) ] MOV(Wrk_InpCVClamped,Wrk_InpCVRamped) ,CMP((Wrk_InpCVRamped-Wrk_InpCVClamped)>Wrk_Step) SUB(Wrk_InpCVRamped,Wrk_Step,Wrk_InpCVRamped) ,CMP((Wrk_InpCVClamped-Wrk_InpCVRamped)>Wrk_Step) ADD(Wrk_InpCVRamped,Wrk_Step,Wrk_InpCVRamped) ];]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Comment>
<![CDATA[============================================================
PUBLISH VALUES
============================================================
These rungs output Values that are not determined in rungs above.

This rung copies the Input CV and the final clamped/ramped CV to
their respective Value parameters.

If the Input CV is Not A Number or Infinite, and if we do not HOLD
CV on invalid input, then set all the outputs used to the same
Infinite or Not A Number value.]]>
</Comment>
<Text>
<![CDATA[[COP(Inp_CV,Val_InpCV,1) ,XIO(Sts_CVInfNaN) MOV(Wrk_InpCVRamped,Val_CV) ,XIC(Sts_CVInfNaN) XIO(Cfg_ShedHold) [COP(Inp_CV,Val_CV,1) ,COP(Inp_CV,Out_CV1,1) ,XIC(Cfg_HasCV2) COP(Inp_CV,Out_CV2,1) ,XIC(Cfg_HasCV3) COP(Inp_CV,Out_CV3,1) ,XIC(Cfg_HasCV4) COP(Inp_CV,Out_CV4,1) ,XIC(Cfg_HasCV5) COP(Inp_CV,Out_CV5,1) ,XIC(Cfg_HasCV6) COP(Inp_CV,Out_CV6,1) ,XIC(Cfg_HasCV7) COP(Inp_CV,Out_CV7,1) ,XIC(Cfg_HasCV8) COP(Inp_CV,Out_CV8,1) ] ];]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Comment>
<![CDATA[This rung publishes the Values for the CV range.
If this range values are entered reversed, this rung flips them so the HMI
bargraph, etc., will be displayed correctly.]]>
</Comment>
<Text>
<![CDATA[[GEQ(Cfg_CVEUMax,Cfg_CVEUMin) MOV(Cfg_CVEUMin,Val_CVEUMin) MOV(Cfg_CVEUMax,Val_CVEUMax) ,LES(Cfg_CVEUMax,Cfg_CVEUMin) MOV(Cfg_CVEUMin,Val_CVEUMax) MOV(Cfg_CVEUMax,Val_CVEUMin) ];]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Comment>
<![CDATA[============================================================
OUTPUT PROCESSING
============================================================
The following rungs generate the Output of this instruction.

If CV1 Initialization is NOT being requested by the downstream block,
calculate the CV1 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIO(Inp_CV1InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV1Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV1Bias) ,CPT(Wrk_Takeup1,Wrk_ScanTime*Cfg_CV1TakeupRate) ,CMP(ABS(Wrk_CV1Bias)<=Wrk_Takeup1) CLR(Wrk_CV1Bias) ,CMP(Wrk_CV1Bias>Wrk_Takeup1) SUB(Wrk_CV1Bias,Wrk_Takeup1,Wrk_CV1Bias) ,CMP(Wrk_CV1Bias<-Wrk_Takeup1) ADD(Wrk_CV1Bias,Wrk_Takeup1,Wrk_CV1Bias) ,CPT(Out_CV1,Wrk_InpCVRamped*Val_CV1Ratio+Val_CV1Offset+Wrk_CV1Bias) ,[GRT(Out_CV1,Cfg_CV1Max) MOV(Cfg_CV1Max,Out_CV1) ,LES(Out_CV1,Cfg_CV1Min) MOV(Cfg_CV1Min,Out_CV1) ] OTE(Sts_CV1Limited) ];]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Comment>
<![CDATA[If CV1 IS requesting initialization, set the CV1 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_CV1InitReq)[COP(Inp_CV1InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV1InitInfNaN) ,COP(Inp_CV1InitVal,Out_CV1,1) ,XIO(Sts_CV1InitInfNaN) CPT(Wrk_CV1Bias,Inp_CV1InitVal-(Wrk_InpCVRamped*Val_CV1Ratio+Val_CV1Offset)) ];]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Comment>
<![CDATA[If CV2 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV2 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV2)XIO(Inp_CV2InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV2Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV2Bias) ,CPT(Wrk_Takeup2,Wrk_ScanTime*Cfg_CV2TakeupRate) ,CMP(ABS(Wrk_CV2Bias)<=Wrk_Takeup2) CLR(Wrk_CV2Bias) ,CMP(Wrk_CV2Bias>Wrk_Takeup2) SUB(Wrk_CV2Bias,Wrk_Takeup2,Wrk_CV2Bias) ,CMP(Wrk_CV2Bias<-Wrk_Takeup2) ADD(Wrk_CV2Bias,Wrk_Takeup2,Wrk_CV2Bias) ,CPT(Out_CV2,Wrk_InpCVRamped*Val_CV2Ratio+Val_CV2Offset+Wrk_CV2Bias) ,[GRT(Out_CV2,Cfg_CV2Max) MOV(Cfg_CV2Max,Out_CV2) ,LES(Out_CV2,Cfg_CV2Min) MOV(Cfg_CV2Min,Out_CV2) ] OTE(Sts_CV2Limited) ];]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Comment>
<![CDATA[If CV2 is being use and IS requesting initialization, set the CV2 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV2)XIC(Inp_CV2InitReq)[COP(Inp_CV2InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV2InitInfNaN) ,COP(Inp_CV2InitVal,Out_CV2,1) ,XIO(Sts_CV2InitInfNaN) CPT(Wrk_CV2Bias,Inp_CV2InitVal-(Wrk_InpCVRamped*Val_CV2Ratio+Val_CV2Offset)) ];]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Comment>
<![CDATA[If CV3 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV3 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV3)XIO(Inp_CV3InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV3Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV3Bias) ,CPT(Wrk_Takeup3,Wrk_ScanTime*Cfg_CV3TakeupRate) ,CMP(ABS(Wrk_CV3Bias)<=Wrk_Takeup3) CLR(Wrk_CV3Bias) ,CMP(Wrk_CV3Bias>Wrk_Takeup3) SUB(Wrk_CV3Bias,Wrk_Takeup3,Wrk_CV3Bias) ,CMP(Wrk_CV3Bias<-Wrk_Takeup3) ADD(Wrk_CV3Bias,Wrk_Takeup3,Wrk_CV3Bias) ,CPT(Out_CV3,Wrk_InpCVRamped*Val_CV3Ratio+Val_CV3Offset+Wrk_CV3Bias) ,[GRT(Out_CV3,Cfg_CV3Max) MOV(Cfg_CV3Max,Out_CV3) ,LES(Out_CV3,Cfg_CV3Min) MOV(Cfg_CV3Min,Out_CV3) ] OTE(Sts_CV3Limited) ];]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Comment>
<![CDATA[If CV3 is being use and IS requesting initialization, set the CV3 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV3)XIC(Inp_CV3InitReq)[COP(Inp_CV3InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV3InitInfNaN) ,COP(Inp_CV3InitVal,Out_CV3,1) ,XIO(Sts_CV3InitInfNaN) CPT(Wrk_CV3Bias,Inp_CV3InitVal-(Wrk_InpCVRamped*Val_CV3Ratio+Val_CV3Offset)) ];]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Comment>
<![CDATA[If CV4 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV4 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV4)XIO(Inp_CV4InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV4Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV4Bias) ,CPT(Wrk_Takeup4,Wrk_ScanTime*Cfg_CV4TakeupRate) ,CMP(ABS(Wrk_CV4Bias)<=Wrk_Takeup4) CLR(Wrk_CV4Bias) ,CMP(Wrk_CV4Bias>Wrk_Takeup4) SUB(Wrk_CV4Bias,Wrk_Takeup4,Wrk_CV4Bias) ,CMP(Wrk_CV4Bias<-Wrk_Takeup4) ADD(Wrk_CV4Bias,Wrk_Takeup4,Wrk_CV4Bias) ,CPT(Out_CV4,Wrk_InpCVRamped*Val_CV4Ratio+Val_CV4Offset+Wrk_CV4Bias) ,[GRT(Out_CV4,Cfg_CV4Max) MOV(Cfg_CV4Max,Out_CV4) ,LES(Out_CV4,Cfg_CV4Min) MOV(Cfg_CV4Min,Out_CV4) ] OTE(Sts_CV4Limited) ];]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[If CV4 is being use and IS requesting initialization, set the CV4 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV4)XIC(Inp_CV4InitReq)[COP(Inp_CV4InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV4InitInfNaN) ,COP(Inp_CV4InitVal,Out_CV4,1) ,XIO(Sts_CV4InitInfNaN) CPT(Wrk_CV4Bias,Inp_CV4InitVal-(Wrk_InpCVRamped*Val_CV4Ratio+Val_CV4Offset)) ];]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Comment>
<![CDATA[If CV5 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV5 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV5)XIO(Inp_CV5InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV5Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV5Bias) ,CPT(Wrk_Takeup5,Wrk_ScanTime*Cfg_CV5TakeupRate) ,CMP(ABS(Wrk_CV5Bias)<=Wrk_Takeup5) CLR(Wrk_CV5Bias) ,CMP(Wrk_CV5Bias>Wrk_Takeup5) SUB(Wrk_CV5Bias,Wrk_Takeup5,Wrk_CV5Bias) ,CMP(Wrk_CV5Bias<-Wrk_Takeup5) ADD(Wrk_CV5Bias,Wrk_Takeup5,Wrk_CV5Bias) ,CPT(Out_CV5,Wrk_InpCVRamped*Val_CV5Ratio+Val_CV5Offset+Wrk_CV5Bias) ,[GRT(Out_CV5,Cfg_CV5Max) MOV(Cfg_CV5Max,Out_CV5) ,LES(Out_CV5,Cfg_CV5Min) MOV(Cfg_CV5Min,Out_CV5) ] OTE(Sts_CV5Limited) ];]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Comment>
<![CDATA[If CV5 is being use and IS requesting initialization, set the CV5 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV5)XIC(Inp_CV5InitReq)[COP(Inp_CV5InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV5InitInfNaN) ,COP(Inp_CV5InitVal,Out_CV5,1) ,XIO(Sts_CV5InitInfNaN) CPT(Wrk_CV5Bias,Inp_CV5InitVal-(Wrk_InpCVRamped*Val_CV5Ratio+Val_CV5Offset)) ];]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Comment>
<![CDATA[If CV6 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV6 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV6)XIO(Inp_CV6InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV6Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV6Bias) ,CPT(Wrk_Takeup6,Wrk_ScanTime*Cfg_CV6TakeupRate) ,CMP(ABS(Wrk_CV6Bias)<=Wrk_Takeup6) CLR(Wrk_CV6Bias) ,CMP(Wrk_CV6Bias>Wrk_Takeup6) SUB(Wrk_CV6Bias,Wrk_Takeup6,Wrk_CV6Bias) ,CMP(Wrk_CV6Bias<-Wrk_Takeup6) ADD(Wrk_CV6Bias,Wrk_Takeup6,Wrk_CV6Bias) ,CPT(Out_CV6,Wrk_InpCVRamped*Val_CV6Ratio+Val_CV6Offset+Wrk_CV6Bias) ,[GRT(Out_CV6,Cfg_CV6Max) MOV(Cfg_CV6Max,Out_CV6) ,LES(Out_CV6,Cfg_CV6Min) MOV(Cfg_CV6Min,Out_CV6) ] OTE(Sts_CV6Limited) ];]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Comment>
<![CDATA[If CV6 is being use and IS requesting initialization, set the CV6 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV6)XIC(Inp_CV6InitReq)[COP(Inp_CV6InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV6InitInfNaN) ,COP(Inp_CV6InitVal,Out_CV6,1) ,XIO(Sts_CV6InitInfNaN) CPT(Wrk_CV6Bias,Inp_CV6InitVal-(Wrk_InpCVRamped*Val_CV6Ratio+Val_CV6Offset)) ];]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Comment>
<![CDATA[If CV7 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV7 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV7)XIO(Inp_CV7InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV7Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV7Bias) ,CPT(Wrk_Takeup7,Wrk_ScanTime*Cfg_CV7TakeupRate) ,CMP(ABS(Wrk_CV7Bias)<=Wrk_Takeup7) CLR(Wrk_CV7Bias) ,CMP(Wrk_CV7Bias>Wrk_Takeup7) SUB(Wrk_CV7Bias,Wrk_Takeup7,Wrk_CV7Bias) ,CMP(Wrk_CV7Bias<-Wrk_Takeup7) ADD(Wrk_CV7Bias,Wrk_Takeup7,Wrk_CV7Bias) ,CPT(Out_CV7,Wrk_InpCVRamped*Val_CV7Ratio+Val_CV7Offset+Wrk_CV7Bias) ,[GRT(Out_CV7,Cfg_CV7Max) MOV(Cfg_CV7Max,Out_CV7) ,LES(Out_CV7,Cfg_CV7Min) MOV(Cfg_CV7Min,Out_CV7) ] OTE(Sts_CV7Limited) ];]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Comment>
<![CDATA[If CV7 is being use and IS requesting initialization, set the CV7 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV7)XIC(Inp_CV7InitReq)[COP(Inp_CV7InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV7InitInfNaN) ,COP(Inp_CV7InitVal,Out_CV7,1) ,XIO(Sts_CV7InitInfNaN) CPT(Wrk_CV7Bias,Inp_CV7InitVal-(Wrk_InpCVRamped*Val_CV7Ratio+Val_CV7Offset)) ];]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Comment>
<![CDATA[If CV8 is being used and Initialization is NOT being requested by the
downstream block, calculate the CV8 output.
First, if there is a Bias, do 1 step (ramping) to take up the Bias.
(If the Bias somehow became Not A Number or Infinity, clear it.)
Then calculate the output as CV * Ratio + Offset + Bias.
Finally, limit this CV to its clamped range.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV8)XIO(Inp_CV8InitReq)XIO(Sts_CVInfNaN)[COP(Wrk_CV8Bias,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) CLR(Wrk_CV8Bias) ,CPT(Wrk_Takeup8,Wrk_ScanTime*Cfg_CV8TakeupRate) ,CMP(ABS(Wrk_CV8Bias)<=Wrk_Takeup8) CLR(Wrk_CV8Bias) ,CMP(Wrk_CV8Bias>Wrk_Takeup8) SUB(Wrk_CV8Bias,Wrk_Takeup8,Wrk_CV8Bias) ,CMP(Wrk_CV8Bias<-Wrk_Takeup8) ADD(Wrk_CV8Bias,Wrk_Takeup8,Wrk_CV8Bias) ,CPT(Out_CV8,Wrk_InpCVRamped*Val_CV8Ratio+Val_CV8Offset+Wrk_CV8Bias) ,[GRT(Out_CV8,Cfg_CV8Max) MOV(Cfg_CV8Max,Out_CV8) ,LES(Out_CV8,Cfg_CV8Min) MOV(Cfg_CV8Min,Out_CV8) ] OTE(Sts_CV8Limited) ];]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Comment>
<![CDATA[If CV8 is being use and IS requesting initialization, set the CV8 output to the
requested initialization value, and (if the init value is not Infinite or NaN)
 calculate the bias to apply for bumpless transfer out of initialization.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_HasCV8)XIC(Inp_CV8InitReq)[COP(Inp_CV8InitVal,Wrk_RealChkDINT,1) MEQ(Wrk_RealChkDINT,16#7F80_0000,16#7F80_0000) OTE(Sts_CV8InitInfNaN) ,COP(Inp_CV8InitVal,Out_CV8,1) ,XIO(Sts_CV8InitInfNaN) CPT(Wrk_CV8Bias,Inp_CV8InitVal-(Wrk_InpCVRamped*Val_CV8Ratio+Val_CV8Offset)) ];]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Comment>
<![CDATA[If ALL the downstream blocks that are connected are requesting initialization,
there is nothing this instruction can drive -- so it needs to request its upstream
block to initialize.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp_CV1InitReq)[XIO(Cfg_HasCV2) ,XIC(Inp_CV2InitReq) ][XIO(Cfg_HasCV3) ,XIC(Inp_CV3InitReq) ][XIO(Cfg_HasCV4) ,XIC(Inp_CV4InitReq) ][XIO(Cfg_HasCV5) ,XIC(Inp_CV5InitReq) ][XIO(Cfg_HasCV6) ,XIC(Inp_CV6InitReq) ][XIO(Cfg_HasCV7) ,XIC(Inp_CV7InitReq) ][XIO(Cfg_HasCV8) ,XIC(Inp_CV8InitReq) ]OTE(Out_CVInitReq);]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Comment>
<![CDATA[To initialize the upstream block, take the PRIORITY (CV1) output's
initialization value, clamp it to be valid, back calculate the Input CV
that would generate it (accounting for Ratio and Offset),
then limit that value to be within the Input CV clamping range.
That value becomes the CVInitVal output to our upstream block.]]>
</Comment>
<Text>
<![CDATA[XIC(Out_CVInitReq)[XIO(Cfg_UseFixedInit) [XIC(Sts_CV1InitInfNaN) COP(Inp_CV1InitVal,Out_CVInitVal,1) ,XIO(Sts_CV1InitInfNaN) [NEQ(Val_CV1Ratio,0.0) [GRT(Inp_CV1InitVal,Cfg_CV1Max) MOV(Cfg_CV1Max,Inp_CV1InitVal) ,LES(Inp_CV1InitVal,Cfg_CV1Min) MOV(Cfg_CV1Min,Inp_CV1InitVal) ,CPT(Out_CVInitVal,(Inp_CV1InitVal-Val_CV1Offset)/Val_CV1Ratio) ] ,EQU(Val_CV1Ratio,0.0) MOV(Val_CV,Out_CVInitVal) ,GRT(Out_CVInitVal,Cfg_CVMax) MOV(Cfg_CVMax,Out_CVInitVal) ,LES(Out_CVInitVal,Cfg_CVMin) MOV(Cfg_CVMin,Out_CVInitVal) ] ] ,XIC(Cfg_UseFixedInit) MOV(Cfg_FixedInitVal,Out_CVInitVal) ];]]>
</Text>
</Rung>
<Rung Number="69" Type="N">
<Comment>
<![CDATA[============================================================
COMMAND AND SETTING READY BITS
============================================================

Ready to receive other Operator Settings (OSet_xxx) if tracking is NOT enabled,
or we're in Operator or Maintenance Mode.]]>
</Comment>
<Text>
<![CDATA[[XIO(Cfg_SetTrack) ,XIC(Mode.Sts_Oper) ,XIC(Mode.Sts_Maint) ]OTE(Rdy_OSet);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Clear ownership and one-shots on powerup]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
PRESCAN (POWERUP) HANDLING
============================================================
On Prescan, set the Ownership to NO OWNER (0).]]>
</Comment>
<Text>
<![CDATA[CLR(PSet_Owner)CLR(Val_Owner);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Set up the filter initialization one-shot so filter will start from first valid value.]]>
</Comment>
<Text>
<![CDATA[OTU(Wrk_CVValidONS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="STRING_8"/>
<Dependency Type="DataType" Name="STRING_20"/>
<Dependency Type="DataType" Name="STRING_40"/>
<Dependency Type="DataType" Name="STRING_12"/>
<Dependency Type="DataType" Name="STRING_16"/>
<Dependency Type="AddOnInstructionDefinition" Name="P_Mode"/>
</Dependencies>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
