<Description>
<![CDATA[1=Latched Alarm, a Reset is required to clear this Alarm]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
