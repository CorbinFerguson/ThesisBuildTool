<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Trip" DataType="P_Alarm" ExternalAccess="Read/Write">
<Description>
<![CDATA[Alarm: Overload has tripped]]>
</Description>
<DefaultData>C1 07 00 00 EE 02 00 00 05 00 00 00 E0 01 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
88 13 00 00 00 00 00 00 00 00 00 00 88 13 00 00 
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 02 00 09 00 00 00 49 41 48 48 5F 6E 6E 6E 
6E 00 00 00 00 00 00 00 00 00 00 00 10 00 00 00 
4F 76 65 72 6C 6F 61 64 20 54 72 69 70 70 65 64 
00 00 00 00 00 00 00 00 06 00 00 00 52 41 2D 42 
41 53 00 00 00 00 00 00 07 00 00 00 50 5F 41 6C 
61 72 6D 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="P_Alarm">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/>
<DataValueMember Name="Inp" DataType="BOOL" Value="0"/>
<DataValueMember Name="Inp_Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="Cfg_Exists" DataType="BOOL" Value="0"/>
<DataValueMember Name="Cfg_ResetReqd" DataType="BOOL" Value="0"/>
<DataValueMember Name="Cfg_AckReqd" DataType="BOOL" Value="1"/>
<DataValueMember Name="Cfg_AllowShelve" DataType="BOOL" Value="1"/>
<DataValueMember Name="Cfg_AllowDisable" DataType="BOOL" Value="1"/>
<DataValueMember Name="Cfg_PCmdClear" DataType="BOOL" Value="1"/>
<DataValueMember Name="Cfg_Severity" DataType="INT" Radix="Decimal" Value="750"/>
<DataValueMember Name="Cfg_AlmMinOnT" DataType="DINT" Radix="Decimal" Value="5"/>
<DataValueMember Name="Cfg_MaxShelfT" DataType="INT" Radix="Decimal" Value="480"/>
<DataValueMember Name="PCfg_AllowExist" DataType="BOOL" Value="1"/>
<DataValueMember Name="PCmd_Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="PCmd_Ack" DataType="BOOL" Value="0"/>
<DataValueMember Name="PCmd_Suppress" DataType="BOOL" Value="0"/>
<DataValueMember Name="PCmd_Unsuppress" DataType="BOOL" Value="0"/>
<DataValueMember Name="PCmd_Unshelve" DataType="BOOL" Value="0"/>
<DataValueMember Name="OCmd_Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="OCmd_Ack" DataType="BOOL" Value="0"/>
<DataValueMember Name="OCmd_Shelve" DataType="BOOL" Value="0"/>
<DataValueMember Name="OCmd_Unshelve" DataType="BOOL" Value="0"/>
<DataValueMember Name="MCmd_Disable" DataType="BOOL" Value="0"/>
<DataValueMember Name="MCmd_Enable" DataType="BOOL" Value="0"/>
<DataValueMember Name="MCmd_Test" DataType="BOOL" Value="0"/>
<DataValueMember Name="Val_Notify" DataType="SINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Val_MinToUnshelve" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Val_SecToUnshelve" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="Alm" DataType="BOOL" Value="0"/>
<DataValueMember Name="Ack" DataType="BOOL" Value="1"/>
<DataValueMember Name="Shelved" DataType="BOOL" Value="0"/>
<DataValueMember Name="Suppressed" DataType="BOOL" Value="0"/>
<DataValueMember Name="Disabled" DataType="BOOL" Value="0"/>
<DataValueMember Name="Sts_AlmInh" DataType="BOOL" Value="0"/>
<DataValueMember Name="Sts_Err" DataType="BOOL" Value="0"/>
<DataValueMember Name="Err_Timer" DataType="BOOL" Value="0"/>
<DataValueMember Name="Err_Severity" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Reset" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Ack" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Shelve" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Unshelve" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Disable" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Enable" DataType="BOOL" Value="0"/>
<DataValueMember Name="Rdy_Test" DataType="BOOL" Value="0"/>
<DataValueMember Name="P_Alarm" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_3rdTripResetT" DataType="TIMER" ExternalAccess="None">
<Description>
<![CDATA[Time since third remote trip reset]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_2ndTripResetT" DataType="TIMER" ExternalAccess="None">
<Description>
<![CDATA[Time since second remote trip reset]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_1stTripResetT" DataType="TIMER" ExternalAccess="None">
<Description>
<![CDATA[Time since first remote trip reset]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="TIMER">
<DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
<DataValueMember Name="EN" DataType="BOOL" Value="0"/>
<DataValueMember Name="TT" DataType="BOOL" Value="0"/>
<DataValueMember Name="DN" DataType="BOOL" Value="0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_TripResetONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[A remote trip reset was issued - one-shot store]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_TripReset" DataType="BOOL" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[A remote trip reset was issued this scan]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Send commands to and process information from E1Plus Overload Relay on EtherNet/IP]]>
</Description>
<RLLContent>
<Labels>
<Label Name="SkipText"/>
</Labels>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Copyright © Rockwell Automation, Inc.  All Rights Reserved.
============================================================
P_E1PlusE:  PROCESS -- E1Plus Overload Relay on EtherNet/IP
============================================================
Revision 3.1-02 Release  2014-09-30:  See V3.1-xx Release Notes for details.
V3.1-00  2014-07-15:  Initial Release (Part of Library of Process Objects V3.1, so Major = 3).
V3.1-01  2014-09-03:  Using P_Alarm V3.1-01.
V3.1-02  2014-09-30:  Unchanged, but using P_Alarm V3.1-02.
============================================================
This Instruction controls and monitors a 193-ETN (E1Plus
on EtherNet/IP) Overload Relay and provides:

*  Monitoring of warning of impending overloads
*  Ideitification of overload trip conditions
*  Monitoring of %FLA and %Therm usage
*  Listing of last 5 trip causes (Trip Log)
*  Configurable commands to initiate a trip reset
*  Monitoring of states of relay's discrete inputs and discrete output
*  Monitoring of I/O communication faults
*  Alarms for Trip Warning, Overload Trip and I/O Fault
*  Supports HMI "breadcrumbs" for Alarm Inhibited, Bad Configuration, Not Ready

Alarms are provided by P_Alarm AOI instances.
Modes (Operator, Program, Override, Maintenance, Hand) are not used
============================================================
SHOW LOCAL STRINGS
============================================================
The STRINGs containing the text associated with each instance of this
instruction cannot be Input or Output Parameters, because STRINGs are not
 'atomic' types. (Inputs and Outputs must be SINT, INT, DINT, REAL, or BOOL.)

In order to make it easier to find and configure these STRINGs, this rung
was added.  THE JMP (and the LBL on the following rung)
MUST NOT BE REMOVED!!!

To view the STRINGs, go to the instruction instance (in LD or FBD), RIGHT-click
to bring up the context menu and select "Open Instruction Logic".
This rung will appear with the STRING values for the selected instance.
You may double-click the STRING values here to modify them as well.]]>
</Comment>
<Text>
<![CDATA[JMP(SkipText)CONCAT(Cfg_Desc,Cfg_Label,Cfg_Tag)CONCAT(Cfg_Inp1Txt,Cfg_Inp2Txt,Cfg_OutATxt)LOWER(Inf_Lib,Inf_Type);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[============================================================
CONFIGURATION PROCESSING
============================================================
This rung gets Configuration data (such as timer presets) and distributes as needed.
Note that some Configuration data are used directly in-place.

Enter the time (in seconds) for the Trip Reset output to the
E1Plus Overload Relay to pulse when activated.

Enter the time (in seconds) in which (1, 2, or 3) remote trip resets are allowed
before the trip must be reset at the device (force investigation).

If the timer preset calcuated wraps negative (more than 2.14... million seconds), then use a default
limit value and report Bad Configuration.  Note that a negative timer preset will fault the controller!!!]]>
</Comment>
<Text>
<![CDATA[LBL(SkipText)[[MUL(Cfg_PulseT,1000,Wrk_TripResetT.PRE) XIC(Wrk_TripResetT.PRE.31) MOV(5000,Wrk_TripResetT.PRE) ,MUL(Cfg_LocalResetReqdT,1000,Wrk_1stTripResetT.PRE) XIC(Wrk_1stTripResetT.PRE.31) MOV(3600000,Wrk_1stTripResetT.PRE) ] OTE(Err_Timer) ,MOV(Wrk_1stTripResetT.PRE,Wrk_2ndTripResetT.PRE) MOV(Wrk_1stTripResetT.PRE,Wrk_3rdTripResetT.PRE) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Enter the number of remote trip resets (1, 2, or 3) that are allowed (within the time
given above) before the trip must be reset at the device (force investigation).]]>
</Comment>
<Text>
<![CDATA[[LES(Cfg_LocalResetReqdNum,1) MOV(1,Cfg_LocalResetReqdNum) ,GRT(Cfg_LocalResetReqdNum,3) MOV(3,Cfg_LocalResetReqdNum) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[============================================================
ALARM RESET COMMAND HANDLING
============================================================
This rung handles the Alarm Reset Input and Commands
and the "Reset and Ack All" Operator Command.

This rung processes received Reset Commands from:

1.  The Operator via HMI Operator Command, or
2.  Higher-level strategies via Program Command
3.  Pushbuttons or other block via Input

and forwards the Reset to ALL Alarms and latched Shed conditions.]]>
</Comment>
<Text>
<![CDATA[[XIC(OCmd_Reset) OTU(OCmd_Reset) ,XIC(OCmd_ResetAckAll) OTU(OCmd_ResetAckAll) [OTL(Warn.PCmd_Ack) ,OTL(Trip.PCmd_Ack) ,OTL(IOFault.PCmd_Ack) ] ,XIC(PCmd_Reset) [XIC(Cfg_PCmdClear) OTU(PCmd_Reset) ,NOP() ] ,XIC(Inp_Reset) ]OTL(Warn.PCmd_Reset)OTL(Trip.PCmd_Reset)OTL(IOFault.PCmd_Reset);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[============================================================
DEVICE COMMAND HANDLING
============================================================
If an Overload Trip Reset command is received from Operator, Program or Maintenance,
and the command is allowed by configuration,
blink the command's TOF timer to send the command to the overload relay.]]>
</Comment>
<Text>
<![CDATA[[XIC(OCmd_TripReset) OTU(OCmd_TripReset) [XIC(Cfg_AllowOperReset) ,XIC(Cfg_AllowMaintReset) ] ,XIC(PCmd_TripReset) [XIC(Cfg_PCmdClear) OTU(PCmd_TripReset) ,NOP() ] ,XIC(Inp_TripReset) ]XIO(Sts_LocalResetReqd)TOF(Wrk_TripResetT,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[============================================================
DEVICE OUTPUT HANDLING
============================================================
Pulse the Trip Reset output for the required time when activated,
but DO NOT pulse the Trip Reset if the Remote Trip is active!  (It has priority.)]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_TripResetT.DN)OTE(Out_ResetTrip);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[============================================================
GENERATE STATUS
============================================================
Fan the Device Status bits from the overload relay input assembly to
the appropriate Status bits of this instruction.]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp.WarningPresent) OTE(Warn.Inp) ,[XIC(Inp.TripPresent) OTE(Trip.Inp) OTE(Nrdy_Trip) ,XIC(Inp_IOFault) OTE(IOFault.Inp) OTE(Nrdy_IOFault) ] OTE(Sts_NotRdy) ,XIC(Inp.OutputA) OTE(Sts_OutA) ,XIC(Inp.Input1) OTE(Sts_Inp1) ,XIC(Inp.Input2) OTE(Sts_Inp2) ,XIC(Inp.MotorCurrentPresent) OTE(Sts_MotorCurr) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Copy the input Warning Status bits and the Trip Status bits
to their appropriate Status parameters of the instruction.]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp.OverloadWarning) OTE(Sts_WarnBits.0) ,XIC(Inp.JamWarning) OTE(Sts_WarnBits.2) ,XIC(Inp.UnderloadWarning) OTE(Sts_WarnBits.3) ,XIC(Inp.ProgModeWarning) OTE(Sts_WarnBits.6) ,XIC(Inp.OverloadTrip) OTE(Sts_TripBits.0) ,XIC(Inp.PhaseLossTrip) OTE(Sts_TripBits.1) ,XIC(Inp.JamTrip) OTE(Sts_TripBits.2) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Copy the Trip Log inputs to their Status parameters of the instruction.]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp.TripLog0Overload) OTE(Sts_TripLog0.0) ,XIC(Inp.TripLog0PhaseLoss) OTE(Sts_TripLog0.1) ,XIC(Inp.TripLog0Jam) OTE(Sts_TripLog0.2) ,XIC(Inp.TripLog1Overload) OTE(Sts_TripLog1.0) ,XIC(Inp.TripLog1PhaseLoss) OTE(Sts_TripLog1.1) ,XIC(Inp.TripLog1Jam) OTE(Sts_TripLog1.2) ,XIC(Inp.TripLog2Overload) OTE(Sts_TripLog2.0) ,XIC(Inp.TripLog2PhaseLoss) OTE(Sts_TripLog2.1) ,XIC(Inp.TripLog2Jam) OTE(Sts_TripLog2.2) ,XIC(Inp.TripLog3Overload) OTE(Sts_TripLog3.0) ,XIC(Inp.TripLog3PhaseLoss) OTE(Sts_TripLog3.1) ,XIC(Inp.TripLog3Jam) OTE(Sts_TripLog3.2) ,XIC(Inp.TripLog4Overload) OTE(Sts_TripLog4.0) ,XIC(Inp.TripLog4PhaseLoss) OTE(Sts_TripLog4.1) ,XIC(Inp.TripLog4Jam) OTE(Sts_TripLog4.2) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Generate a "Remote Trip Reset was issued this scan" one-shot for the
time tracking rungs that follow.]]>
</Comment>
<Text>
<![CDATA[XIC(Out_ResetTrip)XIC(Inp.TripPresent)ONS(Wrk_TripResetONS)OTE(Wrk_TripReset);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Track the time since the THIRD remote trip reset activation.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_TripReset) XIC(Wrk_1stTripResetT.TT) XIC(Wrk_2ndTripResetT.TT) ,XIC(Wrk_3rdTripResetT.TT) ]TON(Wrk_3rdTripResetT,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Track the time since the SECOND remote trip reset activation.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_TripReset) XIC(Wrk_1stTripResetT.TT) ,XIC(Wrk_2ndTripResetT.TT) ]TON(Wrk_2ndTripResetT,?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Track the time since the FIRST remote trip reset activation.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_TripReset) ,XIC(Wrk_1stTripResetT.TT) ]TON(Wrk_1stTripResetT,?,?);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[If there have been (1, 2 or 3) remote trip reset activations in the last (configured) time,
show the "Local Reset Required" status and inhibit further remote trip resets.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_1stTripResetT.TT) [XIC(Wrk_2ndTripResetT.TT) ,LES(Cfg_LocalResetReqdNum,2) ] [XIC(Wrk_3rdTripResetT.TT) ,LES(Cfg_LocalResetReqdNum,3) ] ,XIC(Sts_LocalResetReqd) ]XIC(Inp.TripPresent)XIO(Out_ResetTrip)OTE(Sts_LocalResetReqd);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[============================================================
COMMAND READIES
============================================================
If the overload relay is tripped, and if we're not already sending a Trip Reset
request, and we have not had too many remote trip resets recently, show the
relay as Ready for Trip Reset (per security level as allowed by configuration).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.TripPresent)XIO(Out_ResetTrip)XIO(Sts_LocalResetReqd)[XIC(Cfg_AllowOperReset) ,XIC(Cfg_AllowMaintReset) ]OTE(Rdy_TripReset);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[============================================================
ALARM PROCESSING
============================================================
Pass the Cfg_PCmdClear configuration down to each P_Alarm instance.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_PCmdClear)OTE(Warn.Cfg_PCmdClear)OTE(Trip.Cfg_PCmdClear)OTE(IOFault.Cfg_PCmdClear);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[The various alarms are ALWAYS allowed to Exist (Cfg_HasXxxAlarm can be set to 1).]]>
</Comment>
<Text>
<![CDATA[OTL(Warn.PCfg_AllowExist)OTL(Trip.PCfg_AllowExist)OTL(IOFault.PCfg_AllowExist);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Handle Impending Overload Warning Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(Warn);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Handle Overload Trip Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(Trip);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Handle I/O Fault Alarm Processing using the standard P_Alarm AOI.]]>
</Comment>
<Text>
<![CDATA[P_Alarm(IOFault);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[If ANY alarm is Disabled, Inhibited or Suppressed, set the Alarm Inhibit
summary status bit (which puts the "I" box on the graphic symbol).]]>
</Comment>
<Text>
<![CDATA[[XIC(Warn.Sts_AlmInh) ,XIC(Trip.Sts_AlmInh) ,XIC(IOFault.Sts_AlmInh) ]OTE(Sts_AlmInh);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[This rung generates a summary Bad Config status, simply an OR of the individual bits provided above
(in the Configuration handling section).]]>
</Comment>
<Text>
<![CDATA[[XIC(Err_Timer) ,[XIC(Warn.Sts_Err) ,XIC(Trip.Sts_Err) ,XIC(IOFault.Sts_Err) ] OTE(Err_Alarm) ]OTE(Sts_Err);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[============================================================
GENERATE VALUES
============================================================
Show the Average Current (for the 3 phases) as a Percentage of Full Load Amps (%FLA).
Show the Thermal Utilization as a Percentage (100% = TRIP).]]>
</Comment>
<Text>
<![CDATA[MOV(Inp.PercentFLA,Val_AvgPctFLA)MOV(Inp.PercentTCU,Val_PctTherm);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Val_Fault reflects the Fault Status of the device:
0 = No Faults
15 = Impending Trip Warning
30 = Overload Relay Tripped
31 = Local Reset Required
32 = I/O Fault
34 = Configuration Error]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_Fault) ,XIC(Sts_Warn) MOV(15,Wrk_Fault) ,XIC(Sts_Trip) [MOV(30,Wrk_Fault) ,XIC(Sts_LocalResetReqd) MOV(31,Wrk_Fault) ] ,XIC(Sts_IOFault) MOV(32,Wrk_Fault) ,XIC(Sts_Err) MOV(34,Wrk_Fault) ,MOV(Wrk_Fault,Val_Fault) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[============================================================
ENUMERATED SOURCE / QUALITY VALUES
============================================================
Source and Quality for Input / Output values / status (SrcQ_IO)

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_SrcQ) ,XIC(Inp_IOFault) MOV(34,Wrk_SrcQ) ,MOV(Wrk_SrcQ,SrcQ_IO) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Source and Quality for primary values / status (SrcQ)

0 = Good: live, confirmed good;   1 = Good: live, assumed good;
2 = Good: no feedback, assumed good;   8 = Test: Simulated;   9 = Test: Loopback;
10 = Test: Manually Entered;   16 = Uncertain: Live, off-spec;
17 = Uncertain, Substituted at Device / Bus;   18 = Uncertain, Substituted at AOI;
19 = Uncertain, using last known good;    20 = Uncertain, using replacement value;
32 = Bad, Signal Failure;   33 = Bad, Channel Fault;
34 = Bad, Module / Comms Fault;   35 = Bad, Invalid Configuration]]>
</Comment>
<Text>
<![CDATA[MOV(SrcQ_IO,SrcQ);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[============================================================
NOTIFICATION VALUE
============================================================
Indicate the current alarm notification level as the max of any of the alarms,
and set the low-order bit for reset or ack required:
0 = Not in alarm, acknowledged
1 = Not in alarm, unacknowledged or reset required
2 = Low severity alarm, acknowledged
3 = Low severity alarm, unacknowledged
4 = Medium severity alarm, acknowledged
5 = Medium severity alarm, unacknowledged
6 = High severity alarm, acknowledged
7 = High severity alarm, unacknowledged
8 = Urgent severity alarm, acknowledged
9 = Urgent severity alarm, unacknowledged]]>
</Comment>
<Text>
<![CDATA[[CLR(Wrk_Notify) ,GRT(Warn.Val_Notify,Wrk_Notify) MOV(Warn.Val_Notify,Wrk_Notify) ,GRT(Trip.Val_Notify,Wrk_Notify) MOV(Trip.Val_Notify,Wrk_Notify) ,GRT(IOFault.Val_Notify,Wrk_Notify) MOV(IOFault.Val_Notify,Wrk_Notify) ,[XIC(Warn.Val_Notify.0) ,XIC(Trip.Val_Notify.0) ,XIC(IOFault.Val_Notify.0) ] OTE(Wrk_Notify.0) ,MOV(Wrk_Notify,Val_Notify) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[This rung identifies:
* if any alarm reset or other reset is required; and
* if any reset or acknowledge from the operator is required.]]>
</Comment>
<Text>
<![CDATA[[[XIC(Warn.Rdy_Ack) ,XIC(Trip.Rdy_Ack) ,XIC(IOFault.Rdy_Ack) ] ,[XIC(Warn.Rdy_Reset) ,XIC(Trip.Rdy_Reset) ,XIC(IOFault.Rdy_Reset) ] OTE(Rdy_Reset) ]OTE(Rdy_ResetAckAll);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Clear "lurking" Commands, reset pulse timers]]>
</Description>
<RLLContent>
<Labels/>
<Rung Number="0" Type="N">
<Comment>
<![CDATA["Lurking" Program Commands are cleared if they are set as "Edge" triggered
(cleared by this object as received).
(Lurking Acknowledge Commands are left to perform their action.)]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_PCmdClear)OTU(PCmd_TripReset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA["Lurking" Operator Commands are cleared, as well as Program Reset.]]>
</Comment>
<Text>
<![CDATA[OTU(OCmd_TripReset)OTU(OCmd_Reset)OTU(OCmd_ResetAckAll)OTU(PCmd_Reset);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Pulse timers are reset.]]>
</Comment>
<Text>
<![CDATA[RES(Wrk_TripResetT);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Outputs used by this object are de-energized on Prescan.]]>
</Comment>
<Text>
<![CDATA[OTU(Out_ResetTrip);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[On Prescan, clear the following:
Val_Fault (no active faults until we see one from input data)]]>
</Comment>
<Text>
<![CDATA[CLR(Val_Fault);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
