<Description>
<![CDATA[Auto unshelve after shelved this long (1..32767 minutes)]]>
</Description>
<DefaultData>E0 01</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Decimal" Value="480"/>
</DefaultData>
</Parameter>
