<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="T_Clock" Revision="1.0" RevisionExtension="01 Release" Vendor="Rockwell Automation" ExecutePrescan="true" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-06-30T17:08:06.874Z" CreatedBy="Not Available" EditedDate="2009-08-14T19:13:55.257Z"
 EditedBy="Not Available" SoftwareRevision="v16.03">
<Description>
<![CDATA[Date/Time Clock]]>
</Description>
<RevisionNote>
<![CDATA[Added missing Logic routine description (Routine Properties). No code change.]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This object manages the controller "Wall Clock", providing date and time services, including:

 *  Accepts downloaded date and time for HMI or other sync source and sets the clock
 *  Reads the clock and provides the local date and time to other logic

NOTE: current date/time is provided as individual DINTs and as a DateTime type for
use with Date/Time Math instructions (T_ADD, T_SUB, T_GRT, etc.)

 *  Calculates and provides the day of the week for the current date

NOTE: Use T_DoW to calcuate the day of the week for ANY given date.

 *  Optionally sets a flag once a day to request a clock sync update
 *  Based on configured shift start times, determines the current production shift (for up to three shifts)

The controller clock can be synchronized by writing a valid Year, Month, Day, Hour, Minute and
Second into the appropriate Settings.  When the clock has been set, the Settings are returned
to "-1" and the time is reflected in the corresponding Values and Status.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="Ref_Out" DataType="DateTime" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Current Date and Time as a DateTime structure]]>
</Description>
</Parameter>
<Parameter Name="Cfg_RequestUpdates" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=Request updates using Sts_UpdateReqd 0=Don't request updates]]>
</Description>
<DefaultData>01</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift1Exist" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=Shift 1 exists]]>
</Description>
<DefaultData>01</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift2Exist" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=Shift 2 exists]]>
</Description>
<DefaultData>01</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift3Exist" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[1=Shift 3 Exists]]>
</Description>
<DefaultData>01</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift1StartHr" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 1 Start Time hours in HH:MM]]>
</Description>
<DefaultData>07 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift1StartMin" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 1 Start Time minutes in HH:MM]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift2StartHr" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 2 Start Time hours in HH:MM]]>
</Description>
<DefaultData>0F 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift2StartMin" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 2 Start Time minutes in HH:MM]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift3StartHr" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 3 Start Time hours in HH:MM]]>
</Description>
<DefaultData>17 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Cfg_Shift3StartMin" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Shift 3 Start Time minutes in HH:MM]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Set_Yr" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Year to set on controller clock]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Set_Mo" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Month to set on controller clock (1..12)]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Set_Da" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Day to set on controller clock (1..31)]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Set_Hr" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Hour to set on controller clock (0..23)]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Set_Min" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Minute to set on controller clock (0..59)]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Set_Sec" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Second to set on controller clock (0..59)]]>
</Description>
<DefaultData>FF FF FF FF</DefaultData>
</Parameter>
<Parameter Name="Val_Yr" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Year]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Mo" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Month]]>
</Description>
<DefaultData>01 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Da" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Day]]>
</Description>
<DefaultData>01 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Hr" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Hour]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Min" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Minute]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Sec" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Second]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_DayOfWeek" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Day of the Week (0=Sun, 1=Mon, ..., 6=Sat)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Val_Shift" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Current Shift number (1..3)]]>
</Description>
<DefaultData>01 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Sts_Shift1" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Current time is in Shift 1]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
<Parameter Name="Sts_Shift2" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Current time is in Shift 2]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
<Parameter Name="Sts_Shift3" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
<Description>
<![CDATA[Current time is in Shift 3]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
<Parameter Name="Sts_UpdateReqd" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[1=Clock Update/Sync Needed]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_Shift3StartMins" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Shift 3 Start Time in minutes since midnight local.]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Shift2StartMins" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Shift 2 Start Time in minutes since midnight local]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_Shift1StartMins" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Shift 1 Start Time in minutes since midnight local]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_G" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA["G" value for day of week calculation]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_F" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA["F" value for day of week calculation]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_DT" DataType="DateTime">
<DefaultData>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 
00 00 00 00 00 00 00 00 00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_UpdateReqd" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[Internal Update Required Latch]]>
</Description>
<DefaultData>00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_UpdateReqdOS" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[Date and Time Update Requeired One-Shot]]>
</Description>
<DefaultData>00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_TodayMins" DataType="DINT" Radix="Decimal">
<Description>
<![CDATA[Current time in minutes since midnight local]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Perform clock functions: set, get time, determine shift]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
T_Clock:  TIME -- CONTROLLER CLOCK HANDLER
============================================================
Revision 1.0-01 - Release:  2009-08-14
Added missing Logic routine description (Routine Properties). No code change.
============================================================
This object manages the controller "Wall Clock", providing date and time services
including:
* Accepts downloaded date and time for HMI or other sync source and sets the clock
* Reads the clock and provides the local date and time to other logic
* Calculates and provides the day of the week for the current date
* Optionally sets a flag every day to request a clock sync update
* Based on configured times, determines the current production shift
(for up to three shifts)

The time is provided as separate Values:
Val_Yr : DINT, 
Val_Mo : DINT,
Val_Da : DINT,
Val_Hr : DINT,
Val_Min : DINT,
Val_Sec : DINT,
Val_uSec : DINT,
Val_DayOfWeek : DINT,
Val_Shift : DINT)
============================================================
HANDLE RECEIVED DATE/TIME SYNC
============================================================
If a valid date and time have been received, and this is not the first scan,
store the date/time to the controller clock.]]>
</Comment>
<Text>
<![CDATA[NEQ(Set_Yr,-1)NEQ(Set_Mo,-1)NEQ(Set_Da,-1)NEQ(Set_Hr,-1)NEQ(Set_Min,-1)NEQ(Set_Sec,-1)[MOV(Set_Yr,Wrk_DT.Yr) MOV(-1,Set_Yr) ,MOV(Set_Mo,Wrk_DT.Mo) MOV(-1,Set_Mo) ,MOV(Set_Da,Wrk_DT.Da) MOV(-1,Set_Da) ,MOV(Set_Hr,Wrk_DT.Hr) MOV(-1,Set_Hr) ,MOV(Set_Min,Wrk_DT.Min) MOV(-1,Set_Min) ,MOV(Set_Sec,Wrk_DT.Sec) MOV(-1,Set_Sec) ,CLR(Wrk_DT.uSec) ,SSV(WALLCLOCKTIME,,LocalDateTime,Wrk_DT.Yr) ,OTU(Wrk_UpdateReqd) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[============================================================
GET CLOCK TIME
============================================================
This rung gets the current clock date and time and makes then available as Values.]]>
</Comment>
<Text>
<![CDATA[[GSV(WALLCLOCKTIME,,LocalDateTime,Wrk_DT.Yr) MOV(Wrk_DT.Yr,Val_Yr) MOV(Wrk_DT.Mo,Val_Mo) MOV(Wrk_DT.Da,Val_Da) ,MOV(Wrk_DT.Hr,Val_Hr) MOV(Wrk_DT.Min,Val_Min) MOV(Wrk_DT.Sec,Val_Sec) ,MOV(Wrk_DT.Yr,Ref_Out.Yr) MOV(Wrk_DT.Mo,Ref_Out.Mo) MOV(Wrk_DT.Da,Ref_Out.Da) ,MOV(Wrk_DT.Hr,Ref_Out.Hr) MOV(Wrk_DT.Min,Ref_Out.Min) MOV(Wrk_DT.Sec,Ref_Out.Sec) MOV(Wrk_DT.uSec,Ref_Out.uSec) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[============================================================
CALCULATE THE DAY OF THE WEEK
============================================================
This version of the day of the week is based on:

http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html

(NOTE:  ALL divisions are INTEGER -- truncated -- divisions!)
F = ( month + 9 ) MOD 12
G = year - ( F / 10 )
Gregorian DayNumber [ D ] = ( 365 * G ) + ( G / 4 ) - ( G / 100 ) + ( G / 400 ) + ( ( ( F * 306 ) + 5 ) / 10 ) + day - 1
DayOfWeek = ( DayNumber + 3 ) MOD 7
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
This rung calculates the "G" and "F" functions shown in the algorithm above.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~]]>
</Comment>
<Text>
<![CDATA[CPT(Wrk_F,(Wrk_DT.Mo+9)MOD 12)CPT(Wrk_G,Wrk_DT.Yr-(Wrk_F/10));]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
This rung calculates the remainder of the algorithm.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
The "Day Number" is calculated, and the MOD 7
(remainder after division by 7) is stored as the Day of the Week.

NOTE:  The "+2" offset aligns Val_DayOfWeek as:
0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat]]>
</Comment>
<Text>
<![CDATA[CPT(Val_DayOfWeek,(365*Wrk_G+(Wrk_G/4)-(Wrk_G/100)+(Wrk_G/400)+((Wrk_F*306+5)/10)+Wrk_DT.Da+2)MOD 7);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[============================================================
REQUEST UPDATE OF DATE/TIME
============================================================
This rung sets a request every morning at 2:01 a.m. for a
date/time update from the (Local) HMI or another source.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_RequestUpdates)EQU(Wrk_DT.Hr,2)EQU(Wrk_DT.Min,1)ONS(Wrk_UpdateReqdOS)OTL(Wrk_UpdateReqd);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[============================================================
DETERMINE THE CURRENT SHIFT
============================================================
This rung puts the current time (hours:minutes) and the shift start times on a
"timeline" from 0 to 1439 minutes of the day.]]>
</Comment>
<Text>
<![CDATA[[CPT(Wrk_TodayMins,Val_Hr*60+Val_Min) ,CPT(Wrk_Shift1StartMins,Cfg_Shift1StartHr*60+Cfg_Shift1StartMin) ,CPT(Wrk_Shift2StartMins,Cfg_Shift2StartHr*60+Cfg_Shift2StartMin) ,CPT(Wrk_Shift3StartMins,Cfg_Shift3StartHr*60+Cfg_Shift3StartMin) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[If the current time (minute of the day) is before all the shift start times, the rungs that
follow won't determine a shift (as none of the shift start times are before the
cureent time).  Add 1440 mintes (one day) to the time to make ALL the shift
start times be to the "left" of the current time on the timeline.]]>
</Comment>
<Text>
<![CDATA[LES(Wrk_TodayMins,Wrk_Shift1StartMins)LES(Wrk_TodayMins,Wrk_Shift2StartMins)LES(Wrk_TodayMins,Wrk_Shift3StartMins)ADD(Wrk_TodayMins,1440,Wrk_TodayMins);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[If the Shift 1 Start Time is the nearest shift start time to the "left" of the current time
on the timeline, we're in Shift 1.  Ignore shifts that don't exist, and ignore
shift start times that are to the "right" of the current time.  See if Shift 1 is the
"closest" point to the left of the current time.

NOTE: If you have that rare facility with FOUR shifts, you can 
easily modify this logic.  You'll have FOUR rungs with THREE big branch
structures in each, instead of the THREE rungs with TWO big branches as below.
And you'll need a fourth item in each of the two rungs above, in an obvious fashion.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_Shift1Exist)GEQ(Wrk_TodayMins,Wrk_Shift1StartMins)[XIO(Cfg_Shift2Exist) ,LES(Wrk_TodayMins,Wrk_Shift2StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift2StartMins) CMP((Wrk_TodayMins-Wrk_Shift1StartMins)<(Wrk_TodayMins-Wrk_Shift2StartMins)) ][XIO(Cfg_Shift3Exist) ,LES(Wrk_TodayMins,Wrk_Shift3StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift3StartMins) CMP((Wrk_TodayMins-Wrk_Shift1StartMins)<(Wrk_TodayMins-Wrk_Shift3StartMins)) ]OTE(Sts_Shift1)MOV(1,Val_Shift);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[If the Shift 2 Start Time is the nearest shift start time to the "left" of the current time
on the timeline, we're in Shift 2.  Ignore shifts that don't exist, and ignore
shift start times that are to the "right" of the current time.  See if Shift 2 is the
"closest" point to the left of the current time.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_Shift2Exist)GEQ(Wrk_TodayMins,Wrk_Shift2StartMins)[XIO(Cfg_Shift1Exist) ,LES(Wrk_TodayMins,Wrk_Shift1StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift1StartMins) CMP((Wrk_TodayMins-Wrk_Shift2StartMins)<(Wrk_TodayMins-Wrk_Shift1StartMins)) ][XIO(Cfg_Shift3Exist) ,LES(Wrk_TodayMins,Wrk_Shift3StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift3StartMins) CMP((Wrk_TodayMins-Wrk_Shift2StartMins)<(Wrk_TodayMins-Wrk_Shift3StartMins)) ]OTE(Sts_Shift2)MOV(2,Val_Shift);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[If the Shift 3 Start Time is the nearest shift start time to the "left" of the current time
on the timeline, we're in Shift 3.  Ignore shifts that don't exist, and ignore
shift start times that are to the "right" of the current time.  See if Shift 3 is the
"closest" point to the left of the current time.]]>
</Comment>
<Text>
<![CDATA[XIC(Cfg_Shift3Exist)GEQ(Wrk_TodayMins,Wrk_Shift3StartMins)[XIO(Cfg_Shift1Exist) ,LES(Wrk_TodayMins,Wrk_Shift1StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift1StartMins) CMP((Wrk_TodayMins-Wrk_Shift3StartMins)<(Wrk_TodayMins-Wrk_Shift1StartMins)) ][XIO(Cfg_Shift2Exist) ,LES(Wrk_TodayMins,Wrk_Shift2StartMins) ,GEQ(Wrk_TodayMins,Wrk_Shift2StartMins) CMP((Wrk_TodayMins-Wrk_Shift3StartMins)<(Wrk_TodayMins-Wrk_Shift2StartMins)) ]OTE(Sts_Shift3)MOV(3,Val_Shift);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[============================================================
GENERATE STATUS
============================================================
This rung copies the internal Update Required latch to a public Status bit.
(This Wrk_ bit keeps outside objects from changing the latch state.)

Other status bits are determined in logic above and have no internal Wrk bit.]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_UpdateReqd)OTE(Sts_UpdateReqd);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<Description>
<![CDATA[Clear lurking time setting]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
POWERUP / INVALID STATE HANDLING
============================================================
If any date/time update data have been received while the controller
is in PROGRAM, it will be "lurking" in the Setting registers when the controller
is placed in RUN and should be discarded.

If Clock Update Requesting is enabled via Configuration,
the bit to request a clock update is turned on during first scan.]]>
</Comment>
<Text>
<![CDATA[[MOV(-1,Set_Yr) MOV(-1,Set_Mo) MOV(-1,Set_Da) ,MOV(-1,Set_Hr) MOV(-1,Set_Min) MOV(-1,Set_Sec) ,XIC(Cfg_RequestUpdates) OTL(Sts_UpdateReqd) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="DateTime"/>
</Dependencies>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<WallClockTime Use="Context">
</WallClockTime>
</Controller>
</RSLogix5000Content>
