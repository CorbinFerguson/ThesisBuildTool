<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="16.03" TargetType="AddOnInstructionDefinition" ContainsContext="true" Owner="Dale Reed, Rockwell Automation" ExportDate="Fri Jul 31 10:45:38 2009" ExportOptions="References Context">
<Controller Use="Context" Name="ProcessObjix">
<DataTypes Use="Context">
</DataTypes>
<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="L_OR" Revision="1.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2009-06-22T13:44:13.375Z" CreatedBy="Not Available" EditedDate="2009-07-31T14:45:26.207Z"
 EditedBy="Not Available" SoftwareRevision="v16.03">
<Description>
<![CDATA[Bitwise OR (64-bit)]]>
</Description>
<RevisionNote>
<![CDATA[Initial Release]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction returns the bitwise Logical OR (output bit true if either of the corresponding
input bits are true) of two input 64-bit integers (LINTs), into an output 64-bit integer.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="Inp_A" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Input A]]>
</Description>
</Parameter>
<Parameter Name="Inp_B" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Input B]]>
</Description>
</Parameter>
<Parameter Name="Out" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Output = Input A | Input B]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk_Out" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Output as two 32-bit DINTs]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_InpB" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Input B as two 32-bit DINTs]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_InpA" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Input A as two 32-bit DINTs]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Perform bitwise logical OR]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
L_OR : 64-bit Bitwise Logical OR ( Output = InputA | InputB )
============================================================
Revision 1.0-00 Release:  2009-Jun-31
Initial Release
============================================================
Returns the bitwise Logical OR of the input 64-bit integer (LINT) values.

This rung breaks each LINT input into two DINTs
(32-bit signed each) to do the logical OR function.
===================================================
CONVERT LINTs TO DINTs
===================================================
These COPies take the input LINT values and break them into a pair of DINTs each.]]>
</Comment>
<Text>
<![CDATA[COP(Inp_A,Wrk_InpA[0],2)COP(Inp_B,Wrk_InpB[0],2);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[===================================================
DO A BITWISE LOGICAL "OR" OF THE INDIVIDUAL DINT VALUES
===================================================
Simply do the OR 32 bits at a time.]]>
</Comment>
<Text>
<![CDATA[OR(Wrk_InpA[0],Wrk_InpB[0],Wrk_Out[0])OR(Wrk_InpA[1],Wrk_InpB[1],Wrk_Out[1]);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[===================================================
CONVERT RESULTING DINTs TO LINT
===================================================
This COPy takes the output pair of DINTs (internal) and combines them
into a single output LINT (64-bit signed integer)]]>
</Comment>
<Text>
<![CDATA[COP(Wrk_Out[0],Out,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
