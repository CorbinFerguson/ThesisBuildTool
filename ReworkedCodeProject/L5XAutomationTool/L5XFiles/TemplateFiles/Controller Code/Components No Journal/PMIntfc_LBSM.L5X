<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(S:FS)OTU(EP.PI.StateMachine.Running)OTU(ThisEquipmentDN)OTU(EP.EQ.State);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EM_LBSM(EM_01,EP.EQ);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(EP.EQ.Cmnd) [XIC(EP.PI.StateMachine.Running) ,XIC(EP.PI.StateMachine.Continuing) ] [XIC(ThisPhase.Complete) OTU(EP.EQ.State) ,XIC(ThisEquipmentDN) ] OTE(EP.EQ.DN) ,XIO(EP.EQ.Cmnd) XIO(EP.PI.StateMachine.Running) OTU(EP.EQ.State) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(ThisPhase.Held) ,XIC(ThisPhase.Restarting) ,XIC(ThisPhase.Complete) [XIC(EP.PI.StateMachine.Holding) ,XIC(EP.PI.StateMachine.Held) ] ]OTE(EP.EQ.Held);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[NEQ(ThisPhase.Failure,0)OTE(EP.EQ.Fault);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(EP.PI.StateMachine.Running)XIC(ThisPhase.Idle)[OTL(EP.EQ.State) ,OTE(Out_Start) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(EP.PI.StateMachine.Holding)XIO(ThisPhase.Holding)XIO(ThisPhase.Held)OTE(Out_Hold);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(EP.PI.StateMachine.Restarting)XIC(ThisPhase.Held)OTE(Out_Restart);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(EP.PI.StateMachine.Aborting) ,XIC(EP.PI.StateMachine.Aborted) ,XIC(EP.PI.StateMachine.Resetting) [XIC(ThisPhase.Running) ,XIC(ThisPhase.Holding) ,XIC(ThisPhase.Held) ,XIC(ThisPhase.Restarting) ] ]XIO(ThisPhase.Aborting)XIO(ThisPhase.Aborted)OTE(Out_Abort);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(EP.PI.StateMachine.Stopping) ,XIC(EP.PI.StateMachine.Stopped) ]XIO(ThisPhase.Stopping)XIO(ThisPhase.Stopped)OTE(Out_Stop);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(EP.PI.StateMachine.Resetting)[XIO(ThisPhase.Resetting) XIO(ThisPhase.Idle) OTE(Out_Reset) ,XIC(ThisPhase.Idle) XIC(EP.EQ.ResetReq) OTE(EP.EQ.ResetDN) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(UNref[EP.EQ.MyUnit]._SQrt.Owning.[EP.EQ.MyIndex])[[XIC(EP.PI.StateMachine.Running) ,XIC(EP.PI.StateMachine.Continuing) ,XIC(EP.PI.StateMachine.Holding) ,XIC(EP.PI.StateMachine.Held) ,XIC(EP.PI.StateMachine.Restarting) ] [[XIC(ThisPhase.Stopping) ,XIC(ThisPhase.Stopped) ] OTL(EP.PI.StateMachine.Stop) ,[XIC(ThisPhase.Aborting) ,XIC(ThisPhase.Aborted) ] OTL(EP.PI.StateMachine.Abort) ] ,[XIC(EP.PI.StateMachine.Running) ,XIC(EP.PI.StateMachine.Continuing) ,AFI() XIC(EP.PI.StateMachine.Restarting) ] [XIC(ThisPhase.Holding) ,XIC(ThisPhase.Held) ] OTL(EP.PI.StateMachine.Hold) ,XIC(EP.PI.StateMachine.Held) [XIC(ThisPhase.Restarting) ,XIC(ThisPhase.Running) ] OTL(EP.PI.StateMachine.Restart) ]MOV(521,EP.PI.Status);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(UNref[EP.EQ.MyUnit]._SQrt.Owning.[EP.EQ.MyIndex])NEQ(ThisPhase.Owner,0)MOV(520,EP.PI.Status);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
