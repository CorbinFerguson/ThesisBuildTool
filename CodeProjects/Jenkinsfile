pipeline {
    agent{
		label 'corbinThesis'
	}

    stages {
		stage('Checkout') {
			steps {
				checkout scm
				cd CodeProjects\L5XAutomationTool
			}
		}
		stage('Restore') {
            steps {
                sh 'dotnet restore'
            }
        }
        stage('Build') {
            steps {
				sh 'dotnet build L5XAutomationToolProject.sln --configuration Release --no-restore'
            }
        }
        stage('Test') {
            steps {
                sh 'dotnet test L5XAutomationToolProject.sln --configuration Release --no-build --logger "trx;LogFileName=test_results.trx"'
            }
			post {
                always {
                    mstest testResultsFile: "test_results.trx/*.trx", keepLongStdio: true
                }
            }

        }
    }
}