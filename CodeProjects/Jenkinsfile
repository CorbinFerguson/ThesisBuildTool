pipeline {
    agent{
		label 'corbinThesis'
	}

    stages {
		stage('Checkout') {
			steps {
				checkout scm
			}
		}
		stage('Restore') {
            steps {
				bat 'nuget restore ./CodeProjects/L5XAutomationTool/L5XAutomationToolProject.sln'
            }
        }
        stage('Build') {
            steps {
				bat 'dotnet msbuild ./CodeProjects/L5XAutomationTool/L5XAutomationToolProject.sln /t:Rebuild /p:Configuration=Release'
            }
        }
        stage('Test') {
            steps {
				bat 'dotnet test ./CodeProjects/L5XAutomationToolTests/L5XAutomationToolTests.csproj --configuration Release --logger "trx;logfilename=mytests.trx" --no-build --no-restore --results-directory ./CodeProjects/TestResults || exit /b 0'
            }
			post {
                always {
                    mstest(testResultsFile: "CodeProjects/TestResults/*.trx", keepLongStdio: true, failOnError: false)
                }
            }
        }
    }
}