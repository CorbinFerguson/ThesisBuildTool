<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="P_Steam_ph" Revision="2.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-09-24T15:50:27.542Z" CreatedBy="Not Available" EditedDate="2014-09-24T15:54:46.491Z"
 EditedBy="Not Available" SoftwareRevision="v18.02" SourceKey="eladdrawdedeer" SourceProtectionType="Full Protection">
<Description>
<![CDATA[Steam Properties (p,h)]]>
</Description>
<RevisionNote>
<![CDATA[Initial release for Steam Table objects library.]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[Copyright © Rockwell Automation, Inc.  All Rights Reserved.

This instruction calculates the Temperature and Volume given Pressure and Entropy.

Steam properties are calculated to IAPWS-IF97 backward equations
as closely as possible using single-precision math.  No uncertainty 
compensation is used near Region boundaries.

The allowable input range includes Pressures from 0 to 100 MPa (0 to 14503.77 PSIA)
and Enthalpy values from -0.0416 to 4160.66 (kJ/kg).  Values outside of this range will 
cause the Sts_InpErr status flag to be set.  Valid input values that do not produce a 
valid output region will cause the Sts_OutErr status flag to be set.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Inp_P" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Input Steam Pressure (absolute) (MPa or PSIA)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Inp_h" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Input Steam Enthalpy (kJ/kg  or Btu/lbm)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_SI_Eng" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[1=English Units (PSIA, DegF, BTU, ft3, lbm), 
0=SI Units (DegC, kJ, m3, kg)]]>
</Description>
<DefaultData>01</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Region" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[1=Liquid, 2=Superheated, 3=Supercritical, 4=Saturated]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Temperature" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Output Steam Temperature (Deg C or Deg F)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Volume" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Output Specific Volume (m3/kg or ft3/lbm)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_InpErr" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Error: Inp_p or Inp_h is outside of calculation range]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Sts_OutErr" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only">
<Description>
<![CDATA[Error: Inp_p and Inp_h produce an invalid result (not in Regions 1-4 or not valid properties of water/steam).]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
</Parameters>
