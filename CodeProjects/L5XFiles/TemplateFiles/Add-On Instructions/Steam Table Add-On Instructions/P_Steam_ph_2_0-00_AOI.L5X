<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Copyright © Rockwell Automation, Inc.  All Rights Reserved.]]>
</Line>
<Line Number="1">
<![CDATA[// Revision 2.0-00, 2014-09-23: Initial release for Steam Table objects library.]]>
</Line>
<Line Number="2">
<![CDATA[If Cfg_SI_Eng Then]]>
</Line>
<Line Number="3">
<![CDATA[	HU:=Inp_h*2.3244462314030763;]]>
</Line>
<Line Number="4">
<![CDATA[	PU:=Inp_P*0.006894757269;]]>
</Line>
<Line Number="5">
<![CDATA[Else]]>
</Line>
<Line Number="6">
<![CDATA[	HU:=Inp_h;]]>
</Line>
<Line Number="7">
<![CDATA[	PU:=Inp_P;]]>
</Line>
<Line Number="8">
<![CDATA[End_If;]]>
</Line>
<Line Number="9">
<![CDATA[// limits check ------------------------------------------------------------------]]>
</Line>
<Line Number="10">
<![CDATA[Out_Region:=0;]]>
</Line>
<Line Number="11">
<![CDATA[If 0.000611213 <= PU AND PU <= 100 Then]]>
</Line>
<Line Number="12">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="13">
<![CDATA[Else]]>
</Line>
<Line Number="14">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="15">
<![CDATA[	If PU<0.000611213 Then PU:=0.000611213; Else PU:=100.0; End_If;]]>
</Line>
<Line Number="16">
<![CDATA[End_If;]]>
</Line>
<Line Number="17">
<![CDATA[If -0.041587825987655716 <= HU AND HU <= 4160.660928250124 Then]]>
</Line>
<Line Number="18">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="19">
<![CDATA[Else]]>
</Line>
<Line Number="20">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="21">
<![CDATA[	If HU<-0.041587825987655716 Then HU:=-0.041587825987655716; Else HU:=4160.660928250124; End_If;]]>
</Line>
<Line Number="22">
<![CDATA[End_If;]]>
</Line>
<Line Number="23">
<![CDATA[// -------------------------------------------------------------------------------]]>
</Line>
<Line Number="24">
<![CDATA[// boundary check ----------------------------------------------------------------]]>
</Line>
<Line Number="25">
<![CDATA[R:=0.461526;]]>
</Line>
<Line Number="26">
<![CDATA[// ------------------Calculate hmin Region 1 (273.15, PU)-------------------------]]>
</Line>
<Line Number="27">
<![CDATA[R:=0.461526;]]>
</Line>
<Line Number="28">
<![CDATA[P1:=7.1-(PU/16.53);]]>
</Line>
<Line Number="29">
<![CDATA[T1:=(1386.0/273.15)-1.222;]]>
</Line>
<Line Number="30">
<![CDATA[Gam1:=0.0;]]>
</Line>
<Line Number="31">
<![CDATA[For i:=0 To 33 Do]]>
</Line>
<Line Number="32">
<![CDATA[	Gam1:=Gam1+R1ni[i]*(P1**R1Ii[i])*R1Ji[i]*(T1**R1Ji[i]);]]>
</Line>
<Line Number="33">
<![CDATA[End_For;]]>
</Line>
<Line Number="34">
<![CDATA[Gam1:=Gam1/T1;]]>
</Line>
<Line Number="35">
<![CDATA[HMIN:=R*1386.0*Gam1;]]>
</Line>
<Line Number="36">
<![CDATA[// -------------------------------------------------------------------------------]]>
</Line>
<Line Number="37">
<![CDATA[Out_Region:=0;]]>
</Line>
<Line Number="38">
<![CDATA[If PU <= 16.529164252604478 Then]]>
</Line>
<Line Number="39">
<![CDATA[	// --------------Calculate Tsat(PU)-------------------------------------------]]>
</Line>
<Line Number="40">
<![CDATA[	Beta:=PU**0.25;]]>
</Line>
<Line Number="41">
<![CDATA[	E:=Beta**2 - 17.073846940092*Beta + 14.91510861353;]]>
</Line>
<Line Number="42">
<![CDATA[	F:=1167.0521452767*Beta**2 + 12020.82470247*Beta - 4823.2657361591;]]>
</Line>
<Line Number="43">
<![CDATA[	G:=-724213.16703206*Beta**2 - 3232555.0322333*Beta + 405113.40542057;]]>
</Line>
<Line Number="44">
<![CDATA[	D:=-2.0*G/(F+(F**2-4.0*E*G)**0.5);]]>
</Line>
<Line Number="45">
<![CDATA[	T:=(650.17534844798+D-((650.17534844798+D)**2-4.0*(650.17534844798*D-0.23855557567849))**0.5)/2.0;]]>
</Line>
<Line Number="46">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="47">
<![CDATA[	// --------------Calculate Region 1/4 Boundary: Region 1 (Tsat(PU), PU)-------]]>
</Line>
<Line Number="48">
<![CDATA[	P1:=7.1-(PU/16.53);]]>
</Line>
<Line Number="49">
<![CDATA[	T1:=(1386.0/T)-1.222;]]>
</Line>
<Line Number="50">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="51">
<![CDATA[	For i:=0 To 33 Do]]>
</Line>
<Line Number="52">
<![CDATA[		Gam1:=Gam1+R1ni[i]*(P1**R1Ii[i])*R1Ji[i]*(T1**R1Ji[i]);]]>
</Line>
<Line Number="53">
<![CDATA[	End_For;]]>
</Line>
<Line Number="54">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="55">
<![CDATA[	H1:=R*1386.0*Gam1;]]>
</Line>
<Line Number="56">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="57">
<![CDATA[	// --------------Calculate Region 2/4 Boundary: Region 2 (Tsat(PU), PU)-------]]>
</Line>
<Line Number="58">
<![CDATA[	T1:=540.0/T;]]>
</Line>
<Line Number="59">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="60">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="61">
<![CDATA[		Gam1:=Gam1+R2ni0[i]*R2Ji0[i]*(T1**R2Ji0[i]);]]>
</Line>
<Line Number="62">
<![CDATA[	End_For;]]>
</Line>
<Line Number="63">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="64">
<![CDATA[	P1:=SQRT(PU);]]>
</Line>
<Line Number="65">
<![CDATA[	T2:=SQRT(T1-0.5);]]>
</Line>
<Line Number="66">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="67">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="68">
<![CDATA[		Gam2:=Gam2+R22ni[i]*R2Ji[i]*((P1**R2Ii[i])*(T2**R2Ji[i]))**2;]]>
</Line>
<Line Number="69">
<![CDATA[	End_For;]]>
</Line>
<Line Number="70">
<![CDATA[	Gam2:=Gam2/(T1-0.5);]]>
</Line>
<Line Number="71">
<![CDATA[	H2:=R*540.0*(Gam1+Gam2);]]>
</Line>
<Line Number="72">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="73">
<![CDATA[	// --------------Calculate Region 2/5 Boundary: Region 2 (1073.15, PU)--------]]>
</Line>
<Line Number="74">
<![CDATA[	T1:=540.0/1073.15;]]>
</Line>
<Line Number="75">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="76">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="77">
<![CDATA[		Gam1:=Gam1+R2ni0[i]*R2Ji0[i]*(T1**R2Ji0[i]);]]>
</Line>
<Line Number="78">
<![CDATA[	End_For;]]>
</Line>
<Line Number="79">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="80">
<![CDATA[	P1:=SQRT(PU);]]>
</Line>
<Line Number="81">
<![CDATA[	T2:=SQRT(T1-0.5);]]>
</Line>
<Line Number="82">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="83">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="84">
<![CDATA[		Gam2:=Gam2+R22ni[i]*R2Ji[i]*((P1**R2Ii[i])*(T2**R2Ji[i]))**2;]]>
</Line>
<Line Number="85">
<![CDATA[	End_For;]]>
</Line>
<Line Number="86">
<![CDATA[	Gam2:=Gam2/(T1-0.5);]]>
</Line>
<Line Number="87">
<![CDATA[	H3:=R*540.0*(Gam1+Gam2);]]>
</Line>
<Line Number="88">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="89">
<![CDATA[	If HMIN <= HU AND HU <= H1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="90">
<![CDATA[	If H1 < HU AND HU < H2 Then Out_Region:=4; End_If;]]>
</Line>
<Line Number="91">
<![CDATA[	If H2 <= HU AND HU <= H3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="92">
<![CDATA[End_If;]]>
</Line>
<Line Number="93">
<![CDATA[If 16.529164252604478 < PU Then]]>
</Line>
<Line Number="94">
<![CDATA[	// --------------Calculate Region 1/3 Boundary: Region 1 (623.15, PU)---------]]>
</Line>
<Line Number="95">
<![CDATA[	P1:=7.1-(PU/16.53);]]>
</Line>
<Line Number="96">
<![CDATA[	T1:=(1386.0/623.15)-1.222;]]>
</Line>
<Line Number="97">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="98">
<![CDATA[	For i:=0 To 33 Do]]>
</Line>
<Line Number="99">
<![CDATA[		Gam1:=Gam1+R1ni[i]*(P1**R1Ii[i])*R1Ji[i]*(T1**R1Ji[i]);]]>
</Line>
<Line Number="100">
<![CDATA[	End_For;]]>
</Line>
<Line Number="101">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="102">
<![CDATA[	H1:=R*1386.0*Gam1;]]>
</Line>
<Line Number="103">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="104">
<![CDATA[	// --------------Calculate Tb23-----------------------------------------------]]>
</Line>
<Line Number="105">
<![CDATA[	T:=((572.5446+SQRT((PU-13.918839)/0.001019297))*10000)/10000.0;]]>
</Line>
<Line Number="106">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="107">
<![CDATA[	// --------------Calculate Region 3/2 Boundary: Region 2 (Tb23, PU)-----------]]>
</Line>
<Line Number="108">
<![CDATA[	T1:=540.0/T;]]>
</Line>
<Line Number="109">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="110">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="111">
<![CDATA[		Gam1:=Gam1+R2ni0[i]*R2Ji0[i]*(T1**R2Ji0[i]);]]>
</Line>
<Line Number="112">
<![CDATA[	End_For;]]>
</Line>
<Line Number="113">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="114">
<![CDATA[	P1:=SQRT(PU);]]>
</Line>
<Line Number="115">
<![CDATA[	T2:=SQRT(T1-0.5);]]>
</Line>
<Line Number="116">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="117">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="118">
<![CDATA[		Gam2:=Gam2+R22ni[i]*R2Ji[i]*((P1**R2Ii[i])*(T2**R2Ji[i]))**2;]]>
</Line>
<Line Number="119">
<![CDATA[	End_For;]]>
</Line>
<Line Number="120">
<![CDATA[	Gam2:=Gam2/(T1-0.5);]]>
</Line>
<Line Number="121">
<![CDATA[	H2:=R*540.0*(Gam1+Gam2);]]>
</Line>
<Line Number="122">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="123">
<![CDATA[	// --------------Calculate Region 2/5 Boundary: Region 2 (1073.15, PU)--------]]>
</Line>
<Line Number="124">
<![CDATA[	T1:=540.0/1073.15;]]>
</Line>
<Line Number="125">
<![CDATA[	Gam1:=0.0;]]>
</Line>
<Line Number="126">
<![CDATA[	For i:=0 To 8 Do]]>
</Line>
<Line Number="127">
<![CDATA[		Gam1:=Gam1+R2ni0[i]*R2Ji0[i]*(T1**R2Ji0[i]);]]>
</Line>
<Line Number="128">
<![CDATA[	End_For;]]>
</Line>
<Line Number="129">
<![CDATA[	Gam1:=Gam1/T1;]]>
</Line>
<Line Number="130">
<![CDATA[	P1:=SQRT(PU);]]>
</Line>
<Line Number="131">
<![CDATA[	T2:=SQRT(T1-0.5);]]>
</Line>
<Line Number="132">
<![CDATA[	Gam2:=0.0;]]>
</Line>
<Line Number="133">
<![CDATA[	For i:=0 To 42 Do]]>
</Line>
<Line Number="134">
<![CDATA[		Gam2:=Gam2+R22ni[i]*R2Ji[i]*((P1**R2Ii[i])*(T2**R2Ji[i]))**2;]]>
</Line>
<Line Number="135">
<![CDATA[	End_For;]]>
</Line>
<Line Number="136">
<![CDATA[	Gam2:=Gam2/(T1-0.5);]]>
</Line>
<Line Number="137">
<![CDATA[	H3:=R*540.0*(Gam1+Gam2);]]>
</Line>
<Line Number="138">
<![CDATA[	// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="139">
<![CDATA[	If PU < 22.064 Then]]>
</Line>
<Line Number="140">
<![CDATA[		If HMIN <= HU AND HU <= H1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="141">
<![CDATA[		If H1 < HU AND HU < H2 Then]]>
</Line>
<Line Number="142">
<![CDATA[			// ------Calculate Region 3/4 Boundary--------------------------------]]>
</Line>
<Line Number="143">
<![CDATA[			NU1:=(HU/2600.0)-1.02;]]>
</Line>
<Line Number="144">
<![CDATA[			NU2:=(HU/2600.0)-0.608;]]>
</Line>
<Line Number="145">
<![CDATA[			P:=0;]]>
</Line>
<Line Number="146">
<![CDATA[			For i:=0 To 13 Do]]>
</Line>
<Line Number="147">
<![CDATA[				P:=P+ps3_n[i]*(NU1**ps3_I[i])*(NU2**ps3_J[i]);]]>
</Line>
<Line Number="148">
<![CDATA[			End_For;]]>
</Line>
<Line Number="149">
<![CDATA[			P:=P*22.0;]]>
</Line>
<Line Number="150">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="151">
<![CDATA[			If PU < P Then Out_Region:=4; Else Out_Region:=3; End_If;]]>
</Line>
<Line Number="152">
<![CDATA[		End_If;]]>
</Line>
<Line Number="153">
<![CDATA[		If H2 <= HU AND HU <= H3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="154">
<![CDATA[	End_If;]]>
</Line>
<Line Number="155">
<![CDATA[	If 22.064 <= PU Then]]>
</Line>
<Line Number="156">
<![CDATA[		If HMIN <= HU AND HU <= H1 Then Out_Region:=1; End_If;]]>
</Line>
<Line Number="157">
<![CDATA[		If H1 < HU AND HU < H2 Then Out_Region:=3; End_If;]]>
</Line>
<Line Number="158">
<![CDATA[		If H2 <= HU AND HU <= H3 Then Out_Region:=2; End_If;]]>
</Line>
<Line Number="159">
<![CDATA[	End_If;]]>
</Line>
<Line Number="160">
<![CDATA[End_If;]]>
</Line>
<Line Number="161">
<![CDATA[If Out_Region <> 0 Then Sts_OutErr:=0; Else Sts_OutErr:=1; End_If;]]>
</Line>
<Line Number="162">
<![CDATA[S_Region:=0;]]>
</Line>
<Line Number="163">
<![CDATA[Case Out_Region Of]]>
</Line>
<Line Number="164">
<![CDATA[	1:]]>
</Line>
<Line Number="165">
<![CDATA[		LV:=0;]]>
</Line>
<Line Number="166">
<![CDATA[		// ---------Calculate Temperature Region 1 T(P,h)-------------------------]]>
</Line>
<Line Number="167">
<![CDATA[		NU1:=(HU/2500.0)+1.0;]]>
</Line>
<Line Number="168">
<![CDATA[		LT:=0;]]>
</Line>
<Line Number="169">
<![CDATA[		For i:=0 To 19 Do]]>
</Line>
<Line Number="170">
<![CDATA[			LT:=LT+t1ph_n[i]*(PU**t1ph_I[i])*(NU1**t1ph_J[i]);]]>
</Line>
<Line Number="171">
<![CDATA[		End_For;]]>
</Line>
<Line Number="172">
<![CDATA[		//------------------------------------------------------------------------]]>
</Line>
<Line Number="173">
<![CDATA[	2:]]>
</Line>
<Line Number="174">
<![CDATA[		LV:=0;]]>
</Line>
<Line Number="175">
<![CDATA[		If PU<=4 Then]]>
</Line>
<Line Number="176">
<![CDATA[			S_Region:=1;]]>
</Line>
<Line Number="177">
<![CDATA[			// -----Calculate Temperature Region 2a T(P,h)------------------------]]>
</Line>
<Line Number="178">
<![CDATA[			NU1:=(HU/2000.0)-2.1;]]>
</Line>
<Line Number="179">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="180">
<![CDATA[			For i:=0 To 33 Do]]>
</Line>
<Line Number="181">
<![CDATA[				LT:=LT+t2aph_n[i]*(PU**t2aph_I[i])*(NU1**t2aph_J[i]);]]>
</Line>
<Line Number="182">
<![CDATA[			End_For;]]>
</Line>
<Line Number="183">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="184">
<![CDATA[		Else]]>
</Line>
<Line Number="185">
<![CDATA[			P:=((905.84278514723-0.67955786399241*HU+0.12809002730136e-3*HU**2.0)*100000)/100000.0;]]>
</Line>
<Line Number="186">
<![CDATA[			If PU<=P Then]]>
</Line>
<Line Number="187">
<![CDATA[				S_Region:=2;]]>
</Line>
<Line Number="188">
<![CDATA[				// -Calculate Temperature Region 2b T(P,h)------------------------]]>
</Line>
<Line Number="189">
<![CDATA[				NU1:=(HU/2000.0)-2.6;]]>
</Line>
<Line Number="190">
<![CDATA[				P1:=PU-2.0;]]>
</Line>
<Line Number="191">
<![CDATA[				LT:=0;]]>
</Line>
<Line Number="192">
<![CDATA[				For i:=0 To 37 Do]]>
</Line>
<Line Number="193">
<![CDATA[					LT:=LT+t2bph_n[i]*(P1**t2bph_I[i])*(NU1**t2bph_J[i]);]]>
</Line>
<Line Number="194">
<![CDATA[				End_For;]]>
</Line>
<Line Number="195">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="196">
<![CDATA[			Else]]>
</Line>
<Line Number="197">
<![CDATA[				S_Region:=3;]]>
</Line>
<Line Number="198">
<![CDATA[				// -Calculate Temperature Region 2c T(P,h)------------------------]]>
</Line>
<Line Number="199">
<![CDATA[				NU1:=(HU/2000.0)-1.8;]]>
</Line>
<Line Number="200">
<![CDATA[				P1:=PU+25.0;]]>
</Line>
<Line Number="201">
<![CDATA[				LT:=0;]]>
</Line>
<Line Number="202">
<![CDATA[				For i:=0 To 22 Do]]>
</Line>
<Line Number="203">
<![CDATA[					LT:=LT+t2cph_n[i]*(P1**t2cph_I[i])*(NU1**t2cph_J[i]);]]>
</Line>
<Line Number="204">
<![CDATA[				End_For;]]>
</Line>
<Line Number="205">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="206">
<![CDATA[			End_If;]]>
</Line>
<Line Number="207">
<![CDATA[		End_If;]]>
</Line>
<Line Number="208">
<![CDATA[	3:	]]>
</Line>
<Line Number="209">
<![CDATA[		H1:=0.201464004206875e4+3.74696550136983*PU-0.0219921901054187*PU*PU+0.0000875131686009950*PU*PU*PU;]]>
</Line>
<Line Number="210">
<![CDATA[		If HU <= H1 Then]]>
</Line>
<Line Number="211">
<![CDATA[			S_Region:=1;]]>
</Line>
<Line Number="212">
<![CDATA[			// ------Calculate Volume 3a v(p,h)-----------------------------------]]>
</Line>
<Line Number="213">
<![CDATA[			NU1:=(HU/2100.0)-0.727;]]>
</Line>
<Line Number="214">
<![CDATA[			P1:=(PU/100.0)+0.128;]]>
</Line>
<Line Number="215">
<![CDATA[			LV:=0;]]>
</Line>
<Line Number="216">
<![CDATA[			For i:=0 To 31 Do]]>
</Line>
<Line Number="217">
<![CDATA[				LV:=LV+v3aph_n[i]*(P1**v3aph_I[i])*(NU1**v3aph_J[i]);]]>
</Line>
<Line Number="218">
<![CDATA[			End_For;]]>
</Line>
<Line Number="219">
<![CDATA[			LV:=LV*0.0028;]]>
</Line>
<Line Number="220">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="221">
<![CDATA[			// -----Calculate Temperature 3a T(p,h)-------------------------------]]>
</Line>
<Line Number="222">
<![CDATA[			NU1:=(HU/2300.0)-0.615;]]>
</Line>
<Line Number="223">
<![CDATA[			P1:=(PU/100.0)+0.240;]]>
</Line>
<Line Number="224">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="225">
<![CDATA[			For i:=0 To 30 Do]]>
</Line>
<Line Number="226">
<![CDATA[				LT:=LT+t3aph_n[i]*(P1**t3aph_I[i])*(NU1**t3aph_J[i]);]]>
</Line>
<Line Number="227">
<![CDATA[			End_For;]]>
</Line>
<Line Number="228">
<![CDATA[			LT:=LT*760.0;]]>
</Line>
<Line Number="229">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="230">
<![CDATA[		Else]]>
</Line>
<Line Number="231">
<![CDATA[			S_Region:=2;]]>
</Line>
<Line Number="232">
<![CDATA[			// -----Calculate Volume 3b v(p,h)------------------------------------]]>
</Line>
<Line Number="233">
<![CDATA[			NU1:=(HU/2800.0)-0.720;]]>
</Line>
<Line Number="234">
<![CDATA[			P1:=(PU/100.0)+0.0661;]]>
</Line>
<Line Number="235">
<![CDATA[			LV:=0;]]>
</Line>
<Line Number="236">
<![CDATA[			For i:=0 To 29 Do]]>
</Line>
<Line Number="237">
<![CDATA[				LV:=LV+v3bph_n[i]*(P1**v3bph_I[i])*(NU1**v3bph_J[i]);]]>
</Line>
<Line Number="238">
<![CDATA[			End_For;]]>
</Line>
<Line Number="239">
<![CDATA[			LV:=LV*0.0088;]]>
</Line>
<Line Number="240">
<![CDATA[			// -----Calculate Temperature 3b T(p,h)-------------------------------]]>
</Line>
<Line Number="241">
<![CDATA[			// -------------------------------------------------------------------]]>
</Line>
<Line Number="242">
<![CDATA[			NU1:=(HU/2800.0)-0.720;]]>
</Line>
<Line Number="243">
<![CDATA[			P1:=(PU/100.0)+0.298;]]>
</Line>
<Line Number="244">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="245">
<![CDATA[			For i:=0 To 32 Do]]>
</Line>
<Line Number="246">
<![CDATA[				LT:=LT+t3bph_n[i]*(P1**t3bph_I[i])*(NU1**t3bph_J[i]);]]>
</Line>
<Line Number="247">
<![CDATA[			End_For;]]>
</Line>
<Line Number="248">
<![CDATA[			LT:=LT*860.0;]]>
</Line>
<Line Number="249">
<![CDATA[			// --------------------------------------------------------------------]]>
</Line>
<Line Number="250">
<![CDATA[		End_If;]]>
</Line>
<Line Number="251">
<![CDATA[	4:]]>
</Line>
<Line Number="252">
<![CDATA[		// --------------Calculate Tsat(PU)-------------------------------------------]]>
</Line>
<Line Number="253">
<![CDATA[		Beta:=PU**0.25;]]>
</Line>
<Line Number="254">
<![CDATA[		E:=Beta**2 - 17.073846940092*Beta + 14.91510861353;]]>
</Line>
<Line Number="255">
<![CDATA[		F:=1167.0521452767*Beta**2 + 12020.82470247*Beta - 4823.2657361591;]]>
</Line>
<Line Number="256">
<![CDATA[		G:=-724213.16703206*Beta**2 - 3232555.0322333*Beta + 405113.40542057;]]>
</Line>
<Line Number="257">
<![CDATA[		D:=-2.0*G/(F+(F**2-4.0*E*G)**0.5);]]>
</Line>
<Line Number="258">
<![CDATA[		LT:=(650.17534844798+D-((650.17534844798+D)**2-4.0*(650.17534844798*D-0.23855557567849))**0.5)/2.0;]]>
</Line>
<Line Number="259">
<![CDATA[		// ---------------------------------------------------------------------------]]>
</Line>
<Line Number="260">
<![CDATA[End_Case;]]>
</Line>
<Line Number="261">
<![CDATA[If Sts_OutErr Then]]>
</Line>
<Line Number="262">
<![CDATA[	Out_Volume:=0;]]>
</Line>
<Line Number="263">
<![CDATA[	Out_Temperature:=0;]]>
</Line>
<Line Number="264">
<![CDATA[Else	]]>
</Line>
<Line Number="265">
<![CDATA[	If Cfg_SI_Eng Then]]>
</Line>
<Line Number="266">
<![CDATA[		Out_Temperature:=LT*9/5-459.67;]]>
</Line>
<Line Number="267">
<![CDATA[		Out_Volume:=LV*16.01846421978841;]]>
</Line>
<Line Number="268">
<![CDATA[	Else]]>
</Line>
<Line Number="269">
<![CDATA[		Out_Temperature:=LT-273.15;]]>
</Line>
<Line Number="270">
<![CDATA[		Out_Volume:=LV;]]>
</Line>
<Line Number="271">
<![CDATA[	End_If;]]>
</Line>
<Line Number="272">
<![CDATA[End_If;]]>
</Line>
<Line Number="273">
<![CDATA[]]>
</Line>
<Line Number="274">
<![CDATA[]]>
</Line>
<Line Number="275">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
