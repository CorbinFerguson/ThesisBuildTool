<Line Number="418">
<![CDATA[				NU1:=(HU/2300.0)-1.01;]]>
</Line>
<Line Number="419">
<![CDATA[				SIG1:=(SU/4.4)-0.75;]]>
</Line>
<Line Number="420">
<![CDATA[				LP:=0;]]>
</Line>
<Line Number="421">
<![CDATA[				For i:=0 To 32 Do]]>
</Line>
