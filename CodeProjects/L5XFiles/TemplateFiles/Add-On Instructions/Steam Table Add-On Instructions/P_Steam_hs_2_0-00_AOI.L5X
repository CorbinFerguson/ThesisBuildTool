<![CDATA[					LP:=LP+p3ahs_n[i]*(NU1**p3ahs_I[i])*(SIG1**p3ahs_J[i]);]]>
</Line>
<Line Number="423">
<![CDATA[				End_For;]]>
</Line>
<Line Number="424">
<![CDATA[				LP:=LP*1000000.0*99.0;]]>
</Line>
<Line Number="425">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="426">
<![CDATA[			End_If;]]>
</Line>
<Line Number="427">
<![CDATA[			// ----------Calculate Volume 3a v(p,s)-------------------------------]]>
</Line>
<Line Number="428">
<![CDATA[			P1:=(LP/100.0)+0.187;]]>
</Line>
<Line Number="429">
<![CDATA[			SIG1:=(SU/4.4)-0.755;]]>
</Line>
<Line Number="430">
<![CDATA[			LV:=0;]]>
</Line>
<Line Number="431">
<![CDATA[			For i:=0 To 27 Do]]>
</Line>
<Line Number="432">
<![CDATA[				LV:=LV+v3aps_n[i]*(P1**v3aps_I[i])*(SIG1**v3aps_J[i]);]]>
</Line>
