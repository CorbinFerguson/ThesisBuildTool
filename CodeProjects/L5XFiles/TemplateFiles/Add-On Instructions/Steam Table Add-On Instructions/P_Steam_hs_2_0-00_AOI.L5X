</Line>
<Line Number="358">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="359">
<![CDATA[			End_If;]]>
</Line>
<Line Number="360">
<![CDATA[		End_If;]]>
</Line>
<Line Number="361">
<![CDATA[		If S_Region = 2 Then]]>
</Line>
<Line Number="362">
<![CDATA[			If P2bHS Then]]>
</Line>
<Line Number="363">
<![CDATA[				LP:=P;]]>
</Line>
<Line Number="364">
<![CDATA[			Else]]>
