<![CDATA[				LT:=LT+t2cph_n[i]*(P1**t2cph_I[i])*(NU1**t2cph_J[i]);]]>
</Line>
<Line Number="408">
<![CDATA[			End_For;]]>
</Line>
<Line Number="409">
