<Line Number="412">
<![CDATA[		LX:=0;]]>
</Line>
<Line Number="413">
<![CDATA[		If S_Region = 1 Then]]>
</Line>
<Line Number="414">
<![CDATA[			If P3aHS Then]]>
</Line>
<Line Number="415">
<![CDATA[				LP:=P;]]>
</Line>
<Line Number="416">
<![CDATA[			Else]]>
</Line>
<Line Number="417">
<![CDATA[				// -----Calculate Pressure Region 3a P(h,s)-----------------------]]>
