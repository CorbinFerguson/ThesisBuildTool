<Line Number="479">
<![CDATA[	4:]]>
</Line>
<Line Number="480">
<![CDATA[		LV:=0;]]>
</Line>
<Line Number="481">
<![CDATA[		If SU < 5.210887825 Then]]>
</Line>
<Line Number="482">
<![CDATA[			Sts_OutErr:=1;]]>
</Line>
<Line Number="483">
<![CDATA[		End_If;]]>
</Line>
<Line Number="484">
<![CDATA[		// ----------Calculate Back Temperature 4 T(p,h)----------------------]]>
</Line>
<Line Number="485">
<![CDATA[		NU1:=(HU/2800.0)-0.119;]]>
</Line>
<Line Number="486">
<![CDATA[		SIG1:=(SU/9.2)-1.07;]]>
</Line>
<Line Number="487">
<![CDATA[		LT:=0;]]>
</Line>
<Line Number="488">
<![CDATA[		For i:=0 To 35 Do]]>
</Line>
<Line Number="489">
<![CDATA[			LT:=LT+t4hs_n[i]*(NU1**t4hs_I[i])*(SIG1**t4hs_J[i]);]]>
</Line>
<Line Number="490">
<![CDATA[		End_For;]]>
</Line>
<Line Number="491">
<![CDATA[		LT:=LT*550.0;]]>
</Line>
<Line Number="492">
<![CDATA[		// -------------------------------------------------------------------]]>
</Line>
<Line Number="493">
<![CDATA[		// ----------Calculate Back Pressure 4 P(h,s)-------------------------]]>
</Line>
<Line Number="494">
<![CDATA[		Temp_V:=LT-(0.23855557567849/(LT-650.17534844798));]]>
</Line>
<Line Number="495">
<![CDATA[		Temp_A:=Temp_V**2+1167.0521452767*Temp_V-724213.16703206;]]>
</Line>
<Line Number="496">
<![CDATA[		Temp_B:=-17.073846940092*Temp_V**2+12020.82470247*Temp_V-3232555.0322333;]]>
</Line>
<Line Number="497">
<![CDATA[		Temp_C:=14.91510861353*Temp_V**2-4823.2657361591*Temp_V+405113.40542057;]]>
</Line>
<Line Number="498">
<![CDATA[		LP:=(2.0*Temp_C/(-1.0*Temp_B+SQRT(Temp_B**2-4.0*Temp_A*Temp_C)))**4.0;]]>
</Line>
<Line Number="499">
<![CDATA[		// -------------------------------------------------------------------]]>
</Line>
<Line Number="500">
<![CDATA[		R:=0.461526;]]>
</Line>
<Line Number="501">
<![CDATA[		// ----------Calculate Region 1 (P,T)---------------------------------		]]>
</Line>
<Line Number="502">
<![CDATA[		P:=7.1-(LP/16.53);]]>
</Line>
<Line Number="503">
<![CDATA[		T:=(1386.0/LT)-1.222;]]>
</Line>
<Line Number="504">
<![CDATA[		Gam1:=0.0;]]>
</Line>
<Line Number="505">
<![CDATA[		For i:=0 To 33 Do]]>
</Line>
<Line Number="506">
<![CDATA[			Gam1:=Gam1+R1ni[i]*(P**R1Ii[i])*R1Ji[i]*(T**R1Ji[i]);]]>
</Line>
<Line Number="507">
<![CDATA[		End_For;]]>
</Line>
<Line Number="508">
<![CDATA[		Gam1:=Gam1/T;]]>
</Line>
<Line Number="509">
<![CDATA[		H1:=R*1386.0*Gam1;]]>
</Line>
<Line Number="510">
<![CDATA[		// -------------------------------------------------------------------]]>
</Line>
<Line Number="511">
<![CDATA[		// ----------Calculate Region 2 (P,T)---------------------------------]]>
</Line>
<Line Number="512">
<![CDATA[		T:=540.0/LT;]]>
</Line>
<Line Number="513">
<![CDATA[		Gam1:=0.0;]]>
</Line>
<Line Number="514">
<![CDATA[		For i:=0 To 8 Do]]>
</Line>
<Line Number="515">
<![CDATA[			Gam1:=Gam1+R2ni0[i]*R2Ji0[i]*(T**R2Ji0[i]);]]>
</Line>
<Line Number="516">
<![CDATA[		End_For;]]>
</Line>
<Line Number="517">
<![CDATA[		Gam1:=Gam1/T;]]>
</Line>
<Line Number="518">
<![CDATA[		P:=SQRT(LP);]]>
</Line>
<Line Number="519">
<![CDATA[		T1:=SQRT(T-0.5);]]>
</Line>
<Line Number="520">
<![CDATA[		Gam2:=0.0;]]>
</Line>
<Line Number="521">
<![CDATA[		For i:=0 To 42 Do]]>
</Line>
<Line Number="522">
<![CDATA[			Gam2:=Gam2+R22ni[i]*R2Ji[i]*((P**R2Ii[i])*(T1**R2Ji[i]))**2;]]>
</Line>
<Line Number="523">
<![CDATA[		End_For;]]>
</Line>
<Line Number="524">
<![CDATA[		Gam2:=Gam2/(T-0.5);]]>
</Line>
<Line Number="525">
<![CDATA[		H2:=R*540.0*(Gam1+Gam2);]]>
</Line>
<Line Number="526">
<![CDATA[		// -------------------------------------------------------------------]]>
</Line>
<Line Number="527">
<![CDATA[		LX:=(HU-H1)/(H2-H1);]]>
</Line>
<Line Number="528">
<![CDATA[End_Case;]]>
</Line>
<Line Number="529">
<![CDATA[If Sts_OutErr Then]]>
</Line>
<Line Number="530">
<![CDATA[	Out_Volume:=0;]]>
</Line>
<Line Number="531">
<![CDATA[	Out_Pressure:=0;]]>
</Line>
<Line Number="532">
<![CDATA[	Out_VaporFrac:=0;]]>
</Line>
<Line Number="533">
<![CDATA[	Out_Temperature:=0;]]>
</Line>
<Line Number="534">
<![CDATA[Else]]>
</Line>
<Line Number="535">
<![CDATA[	If Cfg_SI_Eng Then]]>
</Line>
<Line Number="536">
<![CDATA[		Out_Temperature:=LT*9/5-459.67;]]>
</Line>
<Line Number="537">
<![CDATA[		Out_Pressure:=LP*145.0377377;]]>
</Line>
<Line Number="538">
<![CDATA[		Out_Volume:=LV*16.01846421978841;]]>
</Line>
<Line Number="539">
<![CDATA[	Else]]>
</Line>
<Line Number="540">
<![CDATA[		Out_Temperature:=LT-273.15;]]>
</Line>
<Line Number="541">
<![CDATA[		Out_Pressure:=LP;]]>
</Line>
<Line Number="542">
<![CDATA[		Out_Volume:=LV;]]>
</Line>
<Line Number="543">
<![CDATA[	End_If;]]>
</Line>
<Line Number="544">
<![CDATA[	Out_VaporFrac:=LX;]]>
</Line>
<Line Number="545">
<![CDATA[End_If;]]>
</Line>
