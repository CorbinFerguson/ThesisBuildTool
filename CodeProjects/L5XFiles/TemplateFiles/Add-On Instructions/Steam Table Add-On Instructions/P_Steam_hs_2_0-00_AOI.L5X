</Line>
<Line Number="402">
<![CDATA[			// -----Calculate Temperature Region 2c T(P,h)--------------------]]>
</Line>
<Line Number="403">
<![CDATA[			NU1:=(HU/2000.0)-1.8;]]>
</Line>
<Line Number="404">
<![CDATA[			P1:=LP+25.0;]]>
</Line>
<Line Number="405">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="406">
<![CDATA[			For i:=0 To 22 Do]]>
</Line>
