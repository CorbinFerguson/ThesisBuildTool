</Line>
<Line Number="436">
<![CDATA[			// ----------Calculate Temperature 3a T(p,h)--------------------------]]>
</Line>
<Line Number="437">
<![CDATA[			NU1:=(HU/2300.0)-0.615;]]>
</Line>
<Line Number="438">
<![CDATA[			P1:=(LP/100.0)+0.240;]]>
</Line>
<Line Number="439">
<![CDATA[			LT:=0;]]>
</Line>
<Line Number="440">
<![CDATA[			For i:=0 To 30 Do]]>
</Line>
<Line Number="441">
<![CDATA[				LT:=LT+t3aph_n[i]*(P1**t3aph_I[i])*(NU1**t3aph_J[i]);]]>
</Line>
<Line Number="442">
<![CDATA[			End_For;]]>
</Line>
<Line Number="443">
<![CDATA[			LT:=LT*760.0;]]>
</Line>
<Line Number="444">
