<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Copyright © Rockwell Automation, Inc.  All Rights Reserved.]]>
</Line>
<Line Number="1">
<![CDATA[// Revision 2.0-00, 2014-09-23: Initial release for Steam Table objects library.]]>
</Line>
<Line Number="2">
<![CDATA[If Cfg_SI_Eng Then]]>
</Line>
<Line Number="3">
<![CDATA[	HU:=Inp_h*2.3244462314030763;]]>
</Line>
<Line Number="4">
<![CDATA[	SU:=Inp_s*4.186801993839408;]]>
</Line>
<Line Number="5">
<![CDATA[Else]]>
</Line>
<Line Number="6">
<![CDATA[	HU:=Inp_h;]]>
</Line>
<Line Number="7">
<![CDATA[	SU:=Inp_s;]]>
</Line>
<Line Number="8">
<![CDATA[End_If;]]>
</Line>
<Line Number="9">
<![CDATA[// limits check ------------------------------------------------------------------]]>
</Line>
<Line Number="10">
<![CDATA[If -0.00858228709261889 <= SU AND SU <= 11.921055068613535 Then]]>
</Line>
<Line Number="11">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="12">
<![CDATA[Else]]>
</Line>
<Line Number="13">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="14">
<![CDATA[	If SU<-0.00858228709261889 Then SU:=-0.00858228709261889; Else SU:=11.921055068613535; End_If;]]>
</Line>
<Line Number="15">
<![CDATA[End_If;]]>
</Line>
<Line Number="16">
<![CDATA[If -0.041587825987655716 <= HU AND HU <= 4160.660928250124 Then ]]>
</Line>
<Line Number="17">
<![CDATA[	Sts_InpErr:=0;]]>
</Line>
<Line Number="18">
<![CDATA[Else]]>
</Line>
<Line Number="19">
<![CDATA[	Sts_InpErr:=1;]]>
</Line>
<Line Number="20">
<![CDATA[	If HU<-0.041587825987655716 Then HU:=-0.041587825987655716; Else HU:=4160.660928250124; End_If;]]>
</Line>
<Line Number="21">
<![CDATA[End_If;]]>
</Line>
<Line Number="22">
<![CDATA[// -------------------------------------------------------------------------------]]>
</Line>
<Line Number="23">
<![CDATA[// boundary check ----------------------------------------------------------------]]>
</Line>
<Line Number="24">
<![CDATA[HMIN4:=-0.041587825987655716+273.14973419633503*(SU-0.00015454959194118292);]]>
</Line>
<Line Number="25">
<![CDATA[P1HS:=0;]]>
</Line>
<Line Number="26">
<![CDATA[P2aHS:=0;]]>
</Line>
<Line Number="27">
<![CDATA[P2bHS:=0;]]>
</Line>
<Line Number="28">
<![CDATA[P2cHS:=0;]]>
</Line>
<Line Number="29">
<![CDATA[P3aHS:=0;]]>
</Line>
<Line Number="30">
<![CDATA[P3bHS:=0;]]>
</Line>
<Line Number="31">
<![CDATA[T1PH:=0;]]>
</Line>
<Line Number="32">
<![CDATA[T2aPH:=0;]]>
</Line>
<Line Number="33">
<![CDATA[T2bPH:=0;]]>
</Line>
<Line Number="34">
<![CDATA[S_Region:=0;]]>
</Line>
<Line Number="35">
<![CDATA[Out_Region:=0;]]>
</Line>
<Line Number="36">
<![CDATA[If SU <=3.3977829547018907 Then]]>
</Line>
<Line Number="37">
<![CDATA[	// -----------------Calculate Pressure Region 1 P(h,s)------------------------]]>
</Line>
<Line Number="38">
<![CDATA[	NU1:=(HU/3400.0)+0.05;]]>
</Line>
<Line Number="39">
<![CDATA[	SIG1:=(SU/7.6)+0.05;]]>
</Line>
<Line Number="40">
<![CDATA[	P:=0;]]>
</Line>
<Line Number="41">
<![CDATA[	For i:=0 To 18 Do]]>
</Line>
<Line Number="42">
<![CDATA[		P:=P+p1hs_n[i]*(NU1**p1hs_I[i])*(SIG1**p1hs_J[i]);]]>
</Line>
<Line Number="43">
<![CDATA[	End_For;]]>
</Line>
<Line Number="44">
<![CDATA[	P:=P*100.0;]]>
</Line>
<Line Number="45">
<![CDATA[	P1HS:=1;]]>
</Line>
<Line Number="46">
<![CDATA[	//----------------------------------------------------------------------------]]>
</Line>
<Line Number="47">
<![CDATA[	// -----------------Calculate Temperature Region 1 T(P,h)---------------------]]>
</Line>
<Line Number="48">
<![CDATA[	NU1:=(HU/2500.0)+1.0;]]>
</Line>
<Line Number="49">
<![CDATA[	T:=0;]]>
</Line>
<Line Number="50">
<![CDATA[	For i:=0 To 19 Do]]>
</Line>
<Line Number="51">
<![CDATA[		T:=T+t1ph_n[i]*(P**t1ph_I[i])*(NU1**t1ph_J[i]);]]>
</Line>
<Line Number="52">
<![CDATA[	End_For;]]>
</Line>
<Line Number="53">
<![CDATA[	T1PH:=1;]]>
</Line>
<Line Number="54">
<![CDATA[	//----------------------------------------------------------------------------]]>
</Line>
<Line Number="55">
<![CDATA[	If T1 >= 273.15 AND P <= 100 Then]]>
</Line>
<Line Number="56">
