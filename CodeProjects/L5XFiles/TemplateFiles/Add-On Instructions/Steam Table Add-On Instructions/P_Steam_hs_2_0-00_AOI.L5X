</Line>
<Line Number="369">
<![CDATA[				For i:=0 To 32 Do]]>
</Line>
<Line Number="370">
<![CDATA[					LP:=LP+p2bhs_n[i]*(NU1**p2bhs_I[i])*(SIG1**p2bhs_J[i]);]]>
</Line>
<Line Number="371">
<![CDATA[				End_For;]]>
</Line>
<Line Number="372">
<![CDATA[				LP:=100.0*LP**4;]]>
</Line>
<Line Number="373">
<![CDATA[				// ---------------------------------------------------------------]]>
</Line>
<Line Number="374">
<![CDATA[			End_IF;]]>
</Line>
<Line Number="375">
<![CDATA[			If T2bPH Then]]>
</Line>
<Line Number="376">
