<LocalTags>
<LocalTag Name="Wrk_State" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<Description>
<![CDATA[Current valve state 1=closed, 2=opening, 3=opened, 4=closing, 5=stopped / other]]>
</Description>
