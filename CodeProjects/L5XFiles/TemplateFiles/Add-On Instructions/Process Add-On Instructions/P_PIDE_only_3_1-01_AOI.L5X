<AddOnInstructionDefinition Use="Target" Name="P_PIDE_only" Revision="3.1" RevisionExtension="01 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-02-24T19:09:37.720Z" CreatedBy="Not Available" EditedDate="2014-09-03T14:37:33.128Z"
