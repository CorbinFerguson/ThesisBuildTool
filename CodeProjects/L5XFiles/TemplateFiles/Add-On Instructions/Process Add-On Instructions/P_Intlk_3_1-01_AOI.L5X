</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_MSet" DataType="INT" Radix="Binary" ExternalAccess="Read/Write">
<Description>
<![CDATA[Internal copy of individual condition Maint. Bypass toggles]]>
</Description>
<DefaultData>00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="INT" Radix="Binary" Value="2#0000_0000_0000_0000"/>
</DefaultData>
</LocalTag>
