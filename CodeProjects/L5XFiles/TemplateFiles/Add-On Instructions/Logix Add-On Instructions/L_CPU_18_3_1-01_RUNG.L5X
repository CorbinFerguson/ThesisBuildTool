<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Name="L_CPU_18" Revision="3.1" RevisionExtension="01 Release" Vendor="Rockwell Automation" ExecutePrescan="true" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2008-10-20T16:28:26.653Z" CreatedBy="Not Available" EditedDate="2014-09-03T17:26:20.549Z" EditedBy="PROCESS\Library"
 SoftwareRevision="v18.02" SourceKey="eladdrawdedeer" SourceProtectionType="Full Protection">
<Description>
<![CDATA[Processor Utilization (V18)]]>
</Description>
<RevisionNote>
<![CDATA[See V3.1-xx Release Notes for details. Unmodified, up-rev only for V3.1-01 public release.]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[Copyright © Rockwell Automation, Inc.  All Rights Reserved.

When enabled, this Instruction monitors the Logix controller (version 18.xx) which
is executing it.  It provides several diagnostics that may be usefull in troubleshooting
system performance issues.  This information is good to have handy on-screen
when calling Rockwell Automation Technical Support for assistance.  Let
your Support Specialist know you have this info when you call.

Information includes:
*  Controller Identity information (catalog number, firmware revision)
*  Communications Timeslice setting
*  Minor Fault information
*  Memory Usage/Free statistics
*  Trend Object usage (most often used by HMI communications)
*  Connections used for all communications
*  I/O and Force LED Status

This instruction also provides a place (on the faceplate Maintenance Tab)
to record your Software Serial Number or Support Contract Number for
reference when calling Rockwell Automation Technical Support.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="Cfg_ContTaskInstance" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Instance Number of Continuous Task if it exists (1..31) (set to 0 if none)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_SlotNumber" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Controller Slot Number in local chassis]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_UpdateT" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[Update (poll) time for CPU data (sec)]]>
</Description>
<DefaultData>05 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="5"/>
</DefaultData>
</Parameter>
<Parameter Name="Cfg_WindowT" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Window Time for collecting Task data (sec)]]>
</Description>
<DefaultData>00 00 80 3F</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="1.0"/>
</DefaultData>
</Parameter>
<Parameter Name="MCmd_Enable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Maintenance Command to enable collection of data]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="MCmd_Disable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Maintenance Command to disable collection of data]]>
</Description>
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
