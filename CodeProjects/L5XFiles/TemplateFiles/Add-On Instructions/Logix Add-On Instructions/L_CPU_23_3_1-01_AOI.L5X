<Description>
<![CDATA[Raw Trend Object data from MSG (Trending object)]]>
</Description>
</Parameter>
<Parameter Name="Ref_MemUseData" TagType="Base" DataType="INT" Dimensions="48" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Raw Memory Use data from MSG (UserMemory object)]]>
</Description>
</Parameter>
<Parameter Name="Ref_TaskTimeData" TagType="Base" DataType="DINT" Dimensions="131" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[Raw Task Time data from MSG (TaskMetrics Object)]]>
