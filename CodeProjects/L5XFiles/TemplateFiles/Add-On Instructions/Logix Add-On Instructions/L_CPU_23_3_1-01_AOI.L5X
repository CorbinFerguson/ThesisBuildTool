<Description>
<![CDATA[Message to set data collection window time]]>
</Description>
</Parameter>
<Parameter Name="Ref_MsgGetTrendObjUse" TagType="Base" DataType="MESSAGE" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Message to get Trend Object usage]]>
</Description>
</Parameter>
<Parameter Name="Ref_MsgGetMemUse" TagType="Base" DataType="MESSAGE" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Message to get Memory usage]]>
</Description>
</Parameter>
<Parameter Name="Ref_MsgGetOSTaskTimes" TagType="Base" DataType="MESSAGE" Usage="InOut" Required="true" Visible="true">
<Description>
<![CDATA[Message to get Logix O/S Task Times / CPU Utilization]]>
