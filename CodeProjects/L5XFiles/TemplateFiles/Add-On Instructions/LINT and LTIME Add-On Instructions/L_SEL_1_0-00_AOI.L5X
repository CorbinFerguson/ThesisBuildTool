<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="16.03" TargetType="AddOnInstructionDefinition" ContainsContext="true" Owner="Dale Reed, Rockwell Automation" ExportDate="Fri Jul 31 10:48:34 2009" ExportOptions="References Context">
<Controller Use="Context" Name="ProcessObjix">
<DataTypes Use="Context">
</DataTypes>
<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="L_SEL" Revision="1.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="true" CreatedDate="2009-06-22T13:44:13.375Z" CreatedBy="Not Available" EditedDate="2009-07-31T14:48:23.981Z"
 EditedBy="Not Available" SoftwareRevision="v16.03">
<Description>
<![CDATA[Select (64-bit)]]>
</Description>
<RevisionNote>
<![CDATA[Initial Release]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction returns Input A if the input selector bit is FALSE, Input B if the
selector bit is TRUE.

NOTE:  When EnableIn is False, the input selector bit sense is reversed.
With the selector bit default value of 1, this allows the rung state in an LD
instance to control the selector in a straightforward manner.  If the rung
is true, select Inp_B; if the rung is false, select Inp_A.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="Inp_A" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Input A]]>
</Description>
</Parameter>
<Parameter Name="Inp_B" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Input B]]>
</Description>
</Parameter>
<Parameter Name="Inp_Sel" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Selector (bit):
1 = Select Inp_A,
0 = Select Inp_B]]>
</Description>
<DefaultData>01</DefaultData>
</Parameter>
<Parameter Name="Out" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Output = Selected Input]]>
</Description>
</Parameter>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<Description>
<![CDATA[Invert the Inp_Sel selection: False = Inp_B, True = Inp_A]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
L_SEL:  Select (64-bit) :  EnableIn False Handling
============================================================
Act as if the Inp_Sel selector bit is inverted.

NOTE: Inp_Sel defaults to 1 so this instruction can be used on a Ladder rung
with the rung True state selecting Inp_B and the rung False state selecting Inp_A.

If the selector bit is TRUE, copy Inp_A to the Output.
If the selector bit is FALSE, copy Inp_B to the Output.]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp_Sel) COP(Inp_A,Out,1) ,XIO(Inp_Sel) COP(Inp_B,Out,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Select Input Inp_A or Inp_B based on Inp_Sel bit state]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
L_SEL : Select (64-bit) ( Output = Inp_Sel ? Inp_B : Inp_A )
============================================================
Revision 1.0-00 Release:  2009-Jun-31
Initial Release
============================================================
Returns Input A (64-bit, LINT) if selector bit Inp_Sel is FALSE,
Input B (640bit, LINT) if selector bit is TRUE.

NOTE:  Selector bit sense is REVERSED if EnableIn is FALSE!
See the EnableInFalse Routine!

If the selector bit is FALSE, copy Inp_A to the Output.
If the selector bit is TRUE, copy Inp_B to the Output.]]>
</Comment>
<Text>
<![CDATA[[XIO(Inp_Sel) COP(Inp_A,Out,1) ,XIC(Inp_Sel) COP(Inp_B,Out,1) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
