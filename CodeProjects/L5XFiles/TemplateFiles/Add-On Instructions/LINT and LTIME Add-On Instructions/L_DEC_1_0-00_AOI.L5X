<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="16.03" TargetType="AddOnInstructionDefinition" ContainsContext="true" Owner="Dale Reed, Rockwell Automation" ExportDate="Fri Jul 31 10:33:49 2009" ExportOptions="References Context">
<Controller Use="Context" Name="ProcessObjix">
<DataTypes Use="Context">
</DataTypes>
<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="L_DEC" Revision="1.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2009-06-23T14:20:15.609Z" CreatedBy="Not Available" EditedDate="2009-07-31T14:33:37.094Z"
 EditedBy="Not Available" SoftwareRevision="v16.03">
<Description>
<![CDATA[Decrement (64-bit)]]>
</Description>
<RevisionNote>
<![CDATA[Initial Release]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction decrements the input 64-bit integer, returning its value minus 1.]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="Inp" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Input]]>
</Description>
</Parameter>
<Parameter Name="Out" DataType="LINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true">
<Description>
<![CDATA[Output = Input - 1]]>
</Description>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk" DataType="DINT" Dimensions="2" Radix="Decimal">
<Description>
<![CDATA[Working pair of 32-bit integers (DINTs)]]>
</Description>
<DefaultData>00 00 00 00 00 00 00 00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_LoOvflw" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[Low-order 32-bit overflow (without minor fault)]]>
</Description>
<DefaultData>00</DefaultData>
</LocalTag>
<LocalTag Name="Wrk_HiOvflw" DataType="BOOL" Radix="Decimal">
<Description>
<![CDATA[High-order 32-bit overflow (without minor fault)]]>
</Description>
<DefaultData>00</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Output the value of the input minus 1]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
L_DEC : Decrement (64-bit) ( Output = Input - 1 )
============================================================
Revision 1.0-00 Release:  2009-Jun-31
Initial Release
============================================================
Returns the value of the input 64-bit integer (LINT) minus one (1).

This instruction breaks the LINT input into two DINTs
(32-bit signed each) to do the math.
===================================================
CONVERT LINT TO DINTs
===================================================
This COPy takes the input LINT and breaks it into a pair of DINTs.]]>
</Comment>
<Text>
<![CDATA[COP(Inp,Wrk[0],2);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[===================================================
DECREMENT THE VALUE
===================================================
Do an UNSIGNED subtract of 1 from the low-order 32 bits.
If the subtract results in a borrow (new value == 0xFFFF_FFFF), then
subtract 1 from the high-order 32 bits.

We check the values for 16#8000_0000 so we don't
cause a controller minor fault by subtracting 1 from this value
(resulting in a signed underflow from negative to positive).]]>
</Comment>
<Text>
<![CDATA[[EQU(Wrk[0],16#8000_0000) MOV(16#7fff_ffff,Wrk[0]) OTE(Wrk_LoOvflw) ,XIO(Wrk_LoOvflw) SUB(Wrk[0],1,Wrk[0]) ,EQU(Wrk[0],16#ffff_ffff) [EQU(Wrk[1],16#8000_0000) MOV(16#7fff_ffff,Wrk[1]) OTE(Wrk_HiOvflw) ,XIO(Wrk_HiOvflw) SUB(Wrk[1],1,Wrk[1]) ] ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[===================================================
CONVERT DINTs TO LINT
===================================================
The decremented value is copied back from the pair of 32-bit
integers (DINTs) to a single 64-bit integer (LINT).]]>
</Comment>
<Text>
<![CDATA[COP(Wrk[0],Out,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
