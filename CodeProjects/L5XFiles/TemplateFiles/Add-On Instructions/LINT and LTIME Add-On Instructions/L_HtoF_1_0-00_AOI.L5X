<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="16.03" TargetType="AddOnInstructionDefinition" ContainsContext="true" Owner="Dale Reed, Rockwell Automation" ExportDate="Thu May 20 17:20:08 2010" ExportOptions="References Context">
<Controller Use="Context" Name="ProcessObjects">
<DataTypes Use="Context">
</DataTypes>
<AddOnInstructionDefinitions Use="Context">
<AddOnInstructionDefinition Use="Target" Name="L_HtoF" Revision="1.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2010-03-23T19:38:53.143Z" CreatedBy="Not Available" EditedDate="2010-03-24T19:51:28.236Z"
 EditedBy="Not Available" SoftwareRevision="v16.03">
<Description>
<![CDATA[Half-Precision to Float]]>
</Description>
<RevisionNote>
<![CDATA[Initial formal release]]>
</RevisionNote>
<AdditionalHelpText>
<![CDATA[This instruction converts a 16-bit ("Half-Precision")
floating point number (contained in an INT, as Logix
doesn't have an SREAL type!) to the equivalent
32-bit single-precision floating point number (REAL).

It accounts for positive and negative zero, subnormal
(very small) numbers, Infinty (+/- 1.$), Indeterminate
(-1.#IND) and Not a Number (+/- 1.#QNaN).]]>
</AdditionalHelpText>
<Parameters>
<Parameter Name="Inp" DataType="INT" Usage="Input" Radix="Binary" Required="false" Visible="true">
<Description>
<![CDATA[Input in 16-bit (half-precision) floating point format]]>
</Description>
<DefaultData>00 00</DefaultData>
</Parameter>
<Parameter Name="Out" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true">
<Description>
<![CDATA[Output in 32-bit floating point (REAL)]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</Parameter>
<Parameter Name="Sts_Zero" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[| Input | and Output are zero (positive or negative)]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
<Parameter Name="Sts_InfNaN" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[| Input | and Output are Infinity or Not a Number]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
<Parameter Name="Sts_Subnorm" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true">
<Description>
<![CDATA[Subnormal input, some output precision was lost]]>
</Description>
<DefaultData>00</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="Wrk" DataType="DINT" Radix="Binary">
<Description>
<![CDATA[Working register for building 32-bit float]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<Description>
<![CDATA[Convert 16-bit float to 32-bit float]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[============================================================
L_HtoF : 16-bit (Half Prescision) Float to 32-bit (Single Precision) Float
============================================================
Revision 1.0-00 Release:  2010-03-24
Initial formal release
============================================================
This instruction converts a 16-bit ("Half-Precision")
floating point number (contained in an INT, as Logix
doesn't have an SREAL type!) to the equivalent
32-bit single-precision floating point number (REAL).

It accounts for positive and negative zero, subnormal
(very small) numbers, Infinty (+/- 1.$), Indeterminate
(-1.#IND) and Not a Number (+/- 1.#QNaN).
============================================================

Clear a working DINT, which we will use for building the 32-bit pattern of the resulting REAL.]]>
</Comment>
<Text>
<![CDATA[CLR(Wrk);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Copy the SIGN bit over directly, regardless.]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.15)OTL(Wrk.31);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[There are FOUR cases for the EXPONENT:
1.  The entire number is zero (16#0000 or 16#8000).  The exponent of the result must be zero.
2.  The exponent is all ones (16#1F).  The number is Infinity, Not a Number (NaN) or
Indeterminate (another NaN). The exponent of the result must be all ones.
3.  The exponent is for a normalized number (16#01 to 16#1E).  The exponent of the
result must be normalized with the appropriate offset (16#71 to 16#8E).
4.  The exponent is zero but the number is not zero.  This indicates a subnormal (very
small) number, where the mantissa does NOT have a leading zero.
This must be handled as a special case, because it results in a normalized
32-bit floating-point number.  See rungs further below.

This rung checks for a positive or negative zero value (16#0000 or 16#8000, the first case).]]>
</Comment>
<Text>
<![CDATA[MEQ(Inp,2#0111_1111_1111_1111,0)OTE(Sts_Zero);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[This rung checks for the SECOND case, an exponent of all ones (16#1F).
This indicates the input number is Infinite or Not a Number (incl. Indeterminate).]]>
</Comment>
<Text>
<![CDATA[MEQ(Inp,2#0111_1100_0000_0000,2#0111_1100_0000_0000)OTE(Sts_InfNaN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[This rung checks for the FOURTH case, an exponent of zero but a non-zero number,
indicating a subnormal number (very small).]]>
</Comment>
<Text>
<![CDATA[XIO(Sts_Zero)MEQ(Inp,2#0111_1100_0000_0000,0)OTE(Sts_Subnorm);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[If the value is Positive or Negative ZERO, DO NOTHING.  Leave the result Positive or Negative ZERO
(We cleared all the bits in the first rung of this routine and copied the sign bit in the second rung!)
Just copy the final pattern out!]]>
</Comment>
<Text>
<![CDATA[XIC(Sts_Zero)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[The MANTISSA for a normalized number has an implied "1" before it, so it has to be "left justified".
Copy it (bits 0 to 9, total 10 bits) to the left-most bits of the REAL mantissa (bits 13-22).

Note that the mantissa for Infinite/NaN numbers is copied this same way. Only "subnormal"
numbers and zero are NOT handled by copying the mantissa this way.]]>
</Comment>
<Text>
<![CDATA[XIO(Sts_Subnorm)BTD(Inp,0,Wrk,13,10);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[For a non-zero, non-infinite, normalized REAL number,
copy the exponent so it is in the range 16#71 to 16#8E to bits 30..23.

NOTE:  Since we cleared the entire Wrk register in the first rung,
this logic only deals with setting bits that must be 1!]]>
</Comment>
<Text>
<![CDATA[XIO(Sts_Subnorm)XIO(Sts_InfNaN)[XIC(Inp.14) OTL(Wrk.30) ,XIO(Inp.14) OTL(Wrk.29) OTL(Wrk.28) OTL(Wrk.27) ,XIC(Inp.13) OTL(Wrk.26) ,XIC(Inp.12) OTL(Wrk.25) ,XIC(Inp.11) OTL(Wrk.24) ,XIC(Inp.10) OTL(Wrk.23) ]JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[If the exponent is ALL ONES, the reulst is positive or negative Infinity (1.$, -1.$), Indeterminate
(-1.#IND, a special NaN), or Not a Nnumber (1.#QNaN or -1.#QNaN),
so make the resulting exponent ALL ONES (0xFF).]]>
</Comment>
<Text>
<![CDATA[XIC(Sts_InfNaN)[OTL(Wrk.30) OTL(Wrk.29) OTL(Wrk.28) OTL(Wrk.27) ,OTL(Wrk.26) OTL(Wrk.25) OTL(Wrk.24) OTL(Wrk.23) ]JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[If we fell through to here, we must handle the special cases for SUBNORMAL NUIMBERS
(very small).   The implied "1." before the exponent is NOT there for subnormal numbers,
so we have to find the first ONE bit, copy the remaining bits and adjust the exponent.

If bit 9 is set, copy bits 0 to 8 and adjust the exponent down 1 (to 0x70).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.9)BTD(16#70,0,Wrk,23,8)BTD(Inp,0,Wrk,14,9)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[If bit 8 is set, copy bits 0 to 7 and adjust the exponent down 2 (to 0x6F).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.8)BTD(16#6F,0,Wrk,23,8)BTD(Inp,0,Wrk,15,8)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[If bit 7 is set, copy bits 0 to 6 and adjust the exponent down 3 (to 0x6E).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.7)BTD(16#6E,0,Wrk,23,8)BTD(Inp,0,Wrk,16,7)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[If bit 6 is set, copy bits 0 to 5 and adjust the exponent down 4 (to 0x6D).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.6)BTD(16#6D,0,Wrk,23,8)BTD(Inp,0,Wrk,17,6)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[If bit 5 is set, copy bits 0 to 4 and adjust the exponent down 5 (to 0x6C).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.5)BTD(16#6C,0,Wrk,23,8)BTD(Inp,0,Wrk,18,5)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[If bit 4 is set, copy bits 0 to 3 and adjust the exponent down 6 (to 0x6B).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.4)BTD(16#6B,0,Wrk,23,8)BTD(Inp,0,Wrk,19,4)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[If bit 3 is set, copy bits 0 to 2 and adjust the exponent down 7 (to 0x6A).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.3)BTD(16#6A,0,Wrk,23,8)BTD(Inp,0,Wrk,20,3)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[If bit 2 is set, copy bits 0 to 1 and adjust the exponent down 8 (to 0x69).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.2)BTD(16#69,0,Wrk,23,8)BTD(Inp,0,Wrk,21,2)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[If bit 1 is set, copy bit 0 and adjust the exponent down 9 (to 0x68).]]>
</Comment>
<Text>
<![CDATA[XIC(Inp.1)BTD(16#68,0,Wrk,23,8)BTD(Inp,0,Wrk,22,1)JMP(CopyOut);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[If we fell through to here, bit zero must be set (else the number would be zero).
Set the exponent to 16#67 and leave the mantissa as zero (with the implied 1 before it).]]>
</Comment>
<Text>
<![CDATA[BTD(16#67,0,Wrk,23,8);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[All done building the 32-bit float bit pattern.
Copy the working DINT out to the REAL result.

(MOV won't work -- it will try to convert DINT to REAL,
but our DINT has a REAL bit pattern.....)]]>
</Comment>
<Text>
<![CDATA[LBL(CopyOut)COP(Wrk,Out,1);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
</Controller>
</RSLogix5000Content>
