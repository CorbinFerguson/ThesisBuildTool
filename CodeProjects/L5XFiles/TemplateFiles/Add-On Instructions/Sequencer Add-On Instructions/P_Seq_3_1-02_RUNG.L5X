<Parameter Name="Inp_21" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.21" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #21]]>
</Description>
</Parameter>
<Parameter Name="Inp_22" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.22" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #22]]>
</Description>
</Parameter>
<Parameter Name="Inp_23" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.23" Required="false" Visible="false" ExternalAccess="Read/Write">
