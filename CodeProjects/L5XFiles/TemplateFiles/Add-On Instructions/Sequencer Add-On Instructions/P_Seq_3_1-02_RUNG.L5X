<![CDATA[[XIC(Wrk_SMStateChg) ,XIC(Wrk_StepBDone) ]CLR(MCmd_InpForce)OTU(MCmd_SeqStepForce)OTU(MCmd_TimerForce);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[If restarted from Held and the restart address is not the current then must process as a step change]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_Restarted)XIC(Wrk_SMStateChg)XIC(Cur_Step.Cfg_NotResAdd)GRT(Wrk_StepNum,1)MOV(Wrk_RestartStep,MSet_NextStep)OTU(Wrk_Restarted);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Running state processing.
Initialize if first scan in run, or the step is complete.
Process pause commands and status in run.]]>
</Comment>
<Text>
<![CDATA[XIC(Wrk_SMState.2)XIO(Wrk_PauseBits.9)[NOP() ,[XIC(Wrk_SMStateChg) XIO(Wrk_Restarted) [MOV(MSet_NextStep,Wrk_RestartStep) ,MOV(MSet_NextStep,Wrk_IntlkStep) ] ,XIC(Wrk_StepBDone) ] [NOP() ,[MOV(MSet_NextStep,Wrk_StepNum) ,COP(Ref_Steps[Wrk_StepNum],Cur_Step,1) ,XIC(Cur_Step.Cfg_Branching.2) ADD(Ref_Steps[Wrk_StepNum].Val_Count,1,Ref_Steps[Wrk_StepNum].Val_Count) ] [OTU(Cur_HasFaultTimer) ,OTU(Cur_HasTimer) ,OTU(Cur_TimerCfg) ] CLR(Wrk_QualifiedInputs) ,COP(Cur_Step.Cfg_Name,Val_CurrStepName,1) ,XIC(Cur_Step.Cfg_ResSeqFaultT) RES(Wrk_SeqFaultT) ,[XIO(Cur_Step.Cfg_NotResAdd) MOV(Wrk_StepNum,Wrk_RestartStep) ,XIO(Cur_Step.Cfg_NotIntlkAdd) MOV(Wrk_StepNum,Wrk_IntlkStep) ] ,[XIO(Cur_Step.Cfg_DeferMinT) GRT(Cur_Step.Cfg_MinT,0) MOV(Cur_Step.Cfg_MinT,Wrk_StepT.PRE) ,XIC(Cur_Step.Cfg_DeferMinT) GRT(Ref_Steps[0].Cfg_MinT,0) MOV(Ref_Steps[0].Cfg_MinT,Wrk_StepT.PRE) ] OTL(Cur_HasTimer) ,RES(Wrk_StepT) XIO(Cur_Step.Cfg_NOTTmrAfterQualify) OTL(Cur_TimerCfg) ,GRT(Cur_Step.Cfg_FaultT,0) [MOV(Cur_Step.Cfg_FaultT,Wrk_StepFaultT.PRE) ,OTL(Cur_HasFaultTimer) ] ,CLR(Val_InStepTOPct) RES(Wrk_StepFaultT) MOV(2147483647,Wrk_InStepT.PRE) RES(Wrk_InStepT) OTU(Inp_Branch) CLR(Inp_PromptSelect) ] ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Choose outputs based on state machine.
This must occur here (between mode and input processing) to guarantee outputs are presented for at least one scan during run.]]>
</Comment>
<Text>
<![CDATA[[XIC(Wrk_SMState.2) XIO(Wrk_PauseBits.9) [XIC(Wrk_SMStateChg) ,XIC(Wrk_StepBDone) ] [NOP() ,MOV(Cur_Step.Cfg_OutputMask,Wrk_OutputMask) MOV(Cur_Step.Cfg_OutputState,Wrk_Outputs) ,MOV(Cur_Step.Cfg_RealMask,Wrk_RealMask) COP(Cur_Step.Cfg_RealOut[0],Wrk_ROutputs[0],Inf_MaxCntRealOut) ,OTL(Wrk_DoReal) ] ,XIC(Wrk_SMState.4) XIC(Wrk_SMStateChg) [MOV(Cfg_StopOutMask,Wrk_OutputMask) MOV(Cfg_StopOutState,Wrk_Outputs) ,MOV(Cfg_StopOutRealMask,Wrk_RealMask) COP(Cfg_StopOutRealValue[0],Wrk_ROutputs[0],Inf_MaxCntRealOut) ,OTL(Wrk_DoReal) ] ,XIC(Wrk_SMState.5) XIC(Wrk_SMStateChg) [MOV(Cfg_HoldOutMask,Wrk_OutputMask) MOV(Cfg_HoldOutState,Wrk_Outputs) ,MOV(Cfg_HoldOutRealMask,Wrk_RealMask) COP(Cfg_HoldOutRealValue[0],Wrk_ROutputs[0],Inf_MaxCntRealOut) ,OTL(Wrk_DoReal) ] ,[XIO(Wrk_SMState.2) XIO(Wrk_SMState.5) XIO(Wrk_SMState.4) XIO(Wrk_SMStateChg) ,XIC(Wrk_PauseBits.9) XIC(Wrk_StepBDone) ] [CLR(Wrk_OutputMask) CLR(Wrk_RealMask) ,CLR(Val_InStepTOPct) RES(Wrk_StepFaultT) MOV(2147483647,Wrk_InStepT.PRE) RES(Wrk_InStepT) ] ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIO(Wrk_DoReal)JMP(AfterReal);]]>
</Text>
</Rung>
