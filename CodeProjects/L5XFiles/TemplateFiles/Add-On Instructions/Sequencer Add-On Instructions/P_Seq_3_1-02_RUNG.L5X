<Description>
<![CDATA[1=Alarm configured to exist, 0=Does not exist, don't scan]]>
</Description>
<DefaultData>01</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</DefaultData>
</Parameter>
