<Text>
<![CDATA[LBL(RealOuts)XIC(Wrk_RealMask.[Wrk_scr1])XIC(Cfg_ScaleRealOut.[Wrk_scr1])MUL(Wrk_ROutputs[Wrk_scr1],Wrk_ScaleFactor,Wrk_ROutputs[Wrk_scr1]);]]>
