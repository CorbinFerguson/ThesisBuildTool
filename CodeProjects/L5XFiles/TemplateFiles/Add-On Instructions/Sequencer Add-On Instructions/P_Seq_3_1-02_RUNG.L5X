<Parameter Name="Inp_20" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.20" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #20]]>
</Description>
