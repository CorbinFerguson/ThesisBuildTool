<Parameter Name="Inp_27" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.27" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #27]]>
</Description>
</Parameter>
<Parameter Name="Inp_28" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.28" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #28]]>
</Description>
</Parameter>
<Parameter Name="Inp_29" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.29" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #29]]>
</Description>
</Parameter>
<Parameter Name="Inp_30" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.30" Required="false" Visible="false" ExternalAccess="Read/Write">
