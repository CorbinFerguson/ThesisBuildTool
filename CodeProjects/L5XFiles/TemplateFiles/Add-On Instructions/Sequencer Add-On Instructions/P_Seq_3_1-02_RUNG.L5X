<Rung Number="22" Type="N">
<Comment>
<![CDATA[Need reset actions where the NOP is]]>
</Comment>
<Text>
<![CDATA[[XIC(OCmd_Reset) OTU(OCmd_Reset) ,XIC(OCmd_ResetAckAll) OTU(OCmd_ResetAckAll) [OTL(StepTO.PCmd_Ack) ,OTL(SeqTO.PCmd_Ack) ,OTL(IntlkTrip.PCmd_Ack) ] ,XIC(PCmd_Reset) [XIC(Cfg_PCmdClear) OTU(PCmd_Reset) ,NOP() ] ,XIC(Inp_Reset) ][OTL(SeqTO.PCmd_Reset) OTL(StepTO.PCmd_Reset) OTL(IntlkTrip.PCmd_Reset) ,NOP() ];]]>
