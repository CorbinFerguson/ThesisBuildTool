<![CDATA[LBL(AfterReal)[XIC(Wrk_SMState.2) XIO(Wrk_PauseBits.9) ,XIC(Wrk_SMState.5) ][AND(Cfg_InpForceMask,MCmd_InpForce,Sts_InpForced) NOT(Sts_InpForced,Wrk_ForceMask) MOV(Cur_Step.Cfg_InputState,Wrk_InpState) ,AND(Cfg_UseInp,Wrk_ForceMask,Wrk_UsedInStepMask) AND(Cur_Step.Cfg_InputMask,Wrk_UsedInStepMask,Wrk_InpMask) ,AND(Wrk_InpMask,Wrk_InpState,Wrk_scr1) AND(Wrk_InpMask,Wrk_Inputs,Wrk_scr2) XOR(Wrk_scr1,Wrk_scr2,Wrk_scr3) NOT(Wrk_scr3,Sts_Qualified) EQU(Wrk_scr1,Wrk_scr2) OTE(Wrk_InputsQualified) ,XIC(Cur_Step.Cfg_Branching.1) AND(Cur_Step.Cfg_BranchInputMask,Wrk_UsedInStepMask,Wrk_scr1) AND(Wrk_scr1,Cur_Step.Cfg_BranchInputState,Wrk_scr2) AND(Wrk_scr1,Wrk_Inputs,Wrk_scr3) EQU(Wrk_scr2,Wrk_scr3) OTE(Wrk_BranchInputsQualified) ];]]>
