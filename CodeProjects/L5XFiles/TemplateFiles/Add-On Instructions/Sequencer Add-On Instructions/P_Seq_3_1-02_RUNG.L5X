<Parameter Name="Inp_24" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.24" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #24]]>
</Description>
</Parameter>
<Parameter Name="Inp_25" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.25" Required="false" Visible="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Sequencer Input bit #25]]>
</Description>
</Parameter>
<Parameter Name="Inp_26" TagType="Alias" DataType="BOOL" Usage="Input" Radix="Decimal" AliasFor="Wrk_Inputs.26" Required="false" Visible="false" ExternalAccess="Read/Write">
